<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.NotificationBar"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <!-- ARCH-UI-SPEC-R1-D5：四级通知条（不刷屏——同类合并计数；可关闭；技术详情进日志） -->
    <Style Selector="Border.notificationBar">
      <Setter Property="Background" Value="{StaticResource Color.Bg.Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="MaxWidth" Value="320"/>
    </Style>
    <Style Selector="Button.notificationClose">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="{StaticResource Control.Height.Compact}"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Color.Text.Secondary}"/>
    </Style>
  </UserControl.Styles>
  <Border Classes="notificationBar" IsVisible="{Binding HasNotification}">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <xy:XYIcon Icon="Info" Size="Small" Stroke="{StaticResource Color.Text.Secondary}" IsVisible="{Binding IsNotificationInfo}"/>
      <xy:XYIcon Icon="Check" Size="Small" Stroke="{StaticResource Color.Success}" IsVisible="{Binding IsNotificationSuccess}"/>
      <xy:XYIcon Icon="Warning" Size="Small" Stroke="{StaticResource Color.Warning}" IsVisible="{Binding IsNotificationWarning}"/>
      <xy:XYIcon Icon="Error" Size="Small" Stroke="{StaticResource Color.Error}" IsVisible="{Binding IsNotificationError}"/>
      <xy:XYTruncatedText Text="{Binding NotificationText}" Mode="End" ToolTip.Tip="{Binding NotificationText}"/>
      <xy:XYBadge Text="{Binding NotificationCount, StringFormat=×{0}}" IsVisible="{Binding ShowNotificationCount}"/>
      <Button Classes="legacyControl notificationClose" Click="Dismiss_Click" ToolTip.Tip="关闭通知" VerticalAlignment="Center">
        <xy:XYIcon Icon="Clear" Size="Tiny"/>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
