<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.LogDetailPanel"
             x:DataType="local:UiVm">
  <Border BorderBrush="#d9e2ee" BorderThickness="1,0,0,0" Padding="10,0,0,0">
    <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <xy:XYHeading Text="日志详情" Variant="PanelTitle"/>
        <Button Classes="legacyControl" Grid.Column="1" Content="复制详情" Click="CopyDetail_Click"
                IsVisible="{Binding HasSelectedLogEntry}" Padding="8,3"/>
      </Grid>

      <Grid Grid.Row="1">
        <StackPanel IsVisible="{Binding !HasSelectedLogEntry}" VerticalAlignment="Center">
          <xy:XYEmptyText Text="未选择日志" HorizontalAlignment="Center"/>
          <xy:XYCaption Text="点击左侧日志行后，这里会显示详细信息。"
                        TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer IsVisible="{Binding HasSelectedLogEntry}">
          <StackPanel Spacing="6">
            <Border Background="#edf4ff" CornerRadius="5" Padding="8,6">
              <StackPanel Spacing="3">
                <xy:XYHeading Text="{Binding SelectedLogEntry.TimeLevelText}" Variant="PanelTitle"/>
                <xy:XYCaption Text="{Binding SelectedLogEntry.SourceCategoryText}"/>
              </StackPanel>
            </Border>
            <xy:XYLabel Text="消息"/>
            <xy:XYSelectableText Text="{Binding SelectedLogEntry.Message}" Variant="Default"/>
            <xy:XYLabel Text="详情"/>
            <xy:XYSelectableText Text="{Binding SelectedLogEntry.DetailText}" Variant="Technical"/>
            <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
              <xy:XYLabel Text="重复次数"/>
              <xy:XYText Grid.Column="1" Text="{Binding SelectedLogEntry.RepeatDetailText}"/>
              <xy:XYLabel Grid.Row="1" Text="上下文 ID"/>
              <xy:XYSelectableText Grid.Row="1" Grid.Column="1" Text="{Binding SelectedLogEntry.ContextText}" Variant="Technical"/>
              <xy:XYLabel Grid.Row="2" Text="操作链路"/>
              <xy:XYSelectableText Grid.Row="2" Grid.Column="1" Text="{Binding SelectedLogEntry.CorrelationText}" Variant="Technical"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</UserControl>
