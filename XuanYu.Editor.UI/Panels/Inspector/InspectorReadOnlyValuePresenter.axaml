<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.InspectorReadOnlyValuePresenter"
             x:DataType="local:InspectorPropertyRow">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <xy:XYText x:Name="ValueText" Text="{Binding Value}" TextWrapping="Wrap" TextTrimming="None"
               HorizontalAlignment="Stretch" VerticalAlignment="Center" MinWidth="0"/>
    <xy:XYButton Grid.Column="1" Content="复制" Classes="inspectorCopyButton"
                 Click="CopyValue_Click" AutomationProperties.Name="复制属性值"/>
  </Grid>
</UserControl>
