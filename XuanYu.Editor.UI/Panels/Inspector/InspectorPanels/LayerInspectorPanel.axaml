<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.LayerInspectorPanel"
             x:DataType="local:UiVm">
  <!-- F1：图层属性（与图层列表同页，位于列表下方；可见/锁定开关在列表行内） -->
  <StackPanel Spacing="4">
    <xy:XYSectionTitle Text="图层属性"/>
    <xy:XYSeparator Variant="Section"/>
    <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
      <xy:XYLabel Text="名称"/>
      <xy:XYTextField Grid.Column="1" Text="{Binding LayerInspectorNameText, Mode=TwoWay}"
               IsReadOnly="{Binding LayerInspectorIsSystem}"
               LostFocus="NameBox_LostFocus" KeyDown="NameBox_KeyDown"/>
      <xy:XYLabel Grid.Row="1" Text="类型"/>
      <xy:XYText Grid.Row="1" Grid.Column="1" Text="{Binding LayerInspectorKindText}" ToolTip.Tip="{Binding LayerInspectorKindText}"/>
      <xy:XYLabel Grid.Row="2" Text="顺序"/>
      <xy:XYText Grid.Row="2" Grid.Column="1" Text="{Binding LayerInspectorOrderText}" ToolTip.Tip="{Binding LayerInspectorOrderText}"/>
      <xy:XYLabel Grid.Row="3" Text="图层 ID"/>
      <xy:XYSelectableText Grid.Row="3" Grid.Column="1" Text="{Binding LayerInspectorIdText}" Variant="Technical" ToolTip.Tip="{Binding LayerInspectorIdText}"/>
    </Grid>
    <xy:XYButton Variant="Secondary" Content="设为当前图层" Command="{Binding RunCommand}" CommandParameter="设为当前图层"
            HorizontalAlignment="Left" IsVisible="{Binding LayerInspectorIsRegion}" Margin="0,4,0,0"/>
  </StackPanel>
</UserControl>
