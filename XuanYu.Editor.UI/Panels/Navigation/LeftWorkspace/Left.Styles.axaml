<Styles xmlns="https://github.com/avaloniaui"
        xmlns:xy="using:XYUI.Avalonia.Controls">
  <Style Selector="xy|XYIconButton.left-action">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="xy|XYText.treeContextLabel">
    <Setter Property="Margin" Value="2,0,0,4"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource XY.Brush.Text.Tertiary}"/>
  </Style>
  <Style Selector="ListBox.treeList">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel/>
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.treeList ListBoxItem">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="Border.treeRow">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0,0,6,0"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.treeList ListBoxItem:pointerover Border.treeRow">
    <Setter Property="Background" Value="{DynamicResource XY.Brush.State.Color.Hover}"/>
  </Style>
  <Style Selector="ListBox.treeList ListBoxItem:selected Border.treeRow">
    <Setter Property="Background" Value="{DynamicResource XY.Brush.Surface.Selected}"/>
  </Style>
  <Style Selector="xy|XYIcon.treeIcon">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Stroke" Value="{DynamicResource XY.Brush.Text.Secondary}"/>
  </Style>
  <Style Selector="xy|XYTruncatedText.treeText">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource XY.Brush.Text.Primary}"/>
  </Style>
  <Style Selector="StackPanel.emptyWorkspace">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Spacing" Value="4"/>
    <Setter Property="MaxWidth" Value="180"/>
  </Style>
  <Style Selector="xy|XYText.emptyWorkspaceText">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource XY.Brush.Text.Secondary}"/>
  </Style>
  <Style Selector="xy|XYText.emptyWorkspaceHint">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource XY.Brush.Text.Tertiary}"/>
  </Style>
</Styles>
