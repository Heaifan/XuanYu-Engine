<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.RegionalAuthoringPanel"
             x:DataType="local:UiVm">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="6" Margin="2,8,2,0">
      <TextBlock Text="内容类型" Classes="uiSection"/>
      <UniformGrid Columns="2" ColumnSpacing="6">
        <ToggleButton Content="区域面" IsChecked="{Binding IsRegionSurfaceAuthoringMode, Mode=OneWay}"
                      Command="{Binding SelectRegionAuthoringModeCommand}" CommandParameter="区域面"/>
        <ToggleButton Content="道路" IsChecked="{Binding IsRoadAuthoringMode, Mode=OneWay}"
                      Command="{Binding SelectRegionAuthoringModeCommand}" CommandParameter="道路"/>
        <ToggleButton Content="地图标记" IsChecked="{Binding IsMarkerAuthoringMode, Mode=OneWay}"
                      Command="{Binding SelectRegionAuthoringModeCommand}" CommandParameter="地图标记"/>
      </UniformGrid>
    </StackPanel>
    <Grid Grid.Row="1">
      <local:RegionPanel IsVisible="{Binding IsRegionSurfaceAuthoringMode}"/>
      <local:RoadPanel IsVisible="{Binding IsRoadAuthoringMode}"/>
      <local:MarkerPanel IsVisible="{Binding IsMarkerAuthoringMode}"/>
    </Grid>
  </Grid>
</UserControl>
