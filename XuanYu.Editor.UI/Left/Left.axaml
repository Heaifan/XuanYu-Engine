<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.Left"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TabControl.leftTabs"><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="TabItem.leftTab"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="12,4"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Foreground" Value="#6b7688"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="TabItem.leftTab:selected"><Setter Property="Background" Value="#edf4ff"/><Setter Property="Foreground" Value="#185aa6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="#8cb2e2"/><Setter Property="BorderThickness" Value="0,0,0,2"/></Style>
    <Style Selector="Border.searchBox"><Setter Property="Background" Value="#f5f8fc"/><Setter Property="BorderBrush" Value="#d7e1ee"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="7,2"/></Style>
    <Style Selector="Border.treeRow"><Setter Property="CornerRadius" Value="5"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="5,3"/></Style>
    <Style Selector="Border.treeRow:pointerover"><Setter Property="Background" Value="#f1f7ff"/></Style>
    <Style Selector="Border.treeRow.selected"><Setter Property="Background" Value="#e7f1ff"/></Style>
    <Style Selector="Border.treeRow.level2"><Setter Property="Margin" Value="18,0,0,0"/></Style>
    <Style Selector="Border.treeRow.level3"><Setter Property="Margin" Value="36,0,0,0"/></Style>
    <Style Selector="Path.treeIcon"><Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="#66758f"/><Setter Property="StrokeThickness" Value="1.6"/></Style>
    <Style Selector="TextBlock.treeText"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Foreground" Value="#27354a"/></Style>
    <Style Selector="TextBlock.selectedText"><Setter Property="Foreground" Value="#165ca8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.emptyTitle"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#334155"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
  </UserControl.Styles>

  <TabControl Classes="leftTabs" SelectedIndex="{Binding LeftTabIndex}">
    <TabItem Classes="leftTab" Header="项目">
      <StackPanel Spacing="8" Margin="0,6,0,0">
        <Border Classes="searchBox">
          <Grid ColumnDefinitions="16,*" ColumnSpacing="6">
            <Path Classes="treeIcon" Data="{StaticResource SearchIcon}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" PlaceholderText="搜索项目树..." BorderThickness="0" Background="Transparent" MinHeight="24"/>
          </Grid>
        </Border>
        <StackPanel Spacing="1">
          <Border Classes="treeRow selected"><Grid ColumnDefinitions="18,18,*" ColumnSpacing="6"><Path Classes="treeIcon" Data="{StaticResource ChevronDownIcon}"/><Path Grid.Column="1" Classes="treeIcon" Data="{StaticResource ProjectIcon}"/><TextBlock Grid.Column="2" Text="SampleProject" Classes="treeText selectedText"/></Grid></Border>
          <Border Classes="treeRow level2"><Grid ColumnDefinitions="18,18,*" ColumnSpacing="6"><Path Classes="treeIcon" Data="{StaticResource ChevronDownIcon}"/><Path Grid.Column="1" Classes="treeIcon" Data="{StaticResource WorldIcon}"/><TextBlock Grid.Column="2" Text="世界" Classes="treeText"/></Grid></Border>
          <Border Classes="treeRow level3"><Grid ColumnDefinitions="18,18,*" ColumnSpacing="6"><Path Grid.Column="1" Classes="treeIcon" Data="{StaticResource SceneIcon}"/><TextBlock Grid.Column="2" Text="MainWorld" Classes="treeText"/></Grid></Border>
          <Border Classes="treeRow level3"><Grid ColumnDefinitions="18,18,*" ColumnSpacing="6"><Path Grid.Column="1" Classes="treeIcon" Data="{StaticResource SceneIcon}"/><TextBlock Grid.Column="2" Text="TestWorld" Classes="treeText"/></Grid></Border>
          <Border Classes="treeRow level2"><Grid ColumnDefinitions="18,18,*" ColumnSpacing="6"><Path Classes="treeIcon" Data="{StaticResource ChevronDownIcon}"/><Path Grid.Column="1" Classes="treeIcon" Data="{StaticResource FolderIcon}"/><TextBlock Grid.Column="2" Text="资源" Classes="treeText"/></Grid></Border>
          <Border Classes="treeRow level3"><Grid ColumnDefinitions="18,18,*" ColumnSpacing="6"><Path Grid.Column="1" Classes="treeIcon" Data="{StaticResource ImageIcon}"/><TextBlock Grid.Column="2" Text="图标" Classes="treeText"/></Grid></Border>
          <Border Classes="treeRow level3"><Grid ColumnDefinitions="18,18,*" ColumnSpacing="6"><Path Grid.Column="1" Classes="treeIcon" Data="{StaticResource MaterialIcon}"/><TextBlock Grid.Column="2" Text="材质" Classes="treeText"/></Grid></Border>
          <Border Classes="treeRow level3"><Grid ColumnDefinitions="18,18,*" ColumnSpacing="6"><Path Grid.Column="1" Classes="treeIcon" Data="{StaticResource ScriptIcon}"/><TextBlock Grid.Column="2" Text="脚本" Classes="treeText"/></Grid></Border>
          <Border Classes="treeRow level2"><Grid ColumnDefinitions="18,18,*" ColumnSpacing="6"><Path Grid.Column="1" Classes="treeIcon" Data="{StaticResource BuildIcon}"/><TextBlock Grid.Column="2" Text="构建" Classes="treeText"/></Grid></Border>
        </StackPanel>
      </StackPanel>
    </TabItem>
    <TabItem Classes="leftTab" Header="层级">
      <Grid Margin="0,8,0,0" MinHeight="220">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="210">
          <Path Classes="treeIcon" Data="{StaticResource WorldIcon}" Width="28" Height="28" Stroke="#7a8aa3"/>
          <TextBlock Text="暂无场景对象" Classes="emptyTitle"/>
          <TextBlock Text="打开世界或创建对象后，这里会显示场景层级。" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
