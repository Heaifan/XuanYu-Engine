<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.Left"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TabControl.leftTabs"><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="TabItem.leftTab"><Setter Property="FontSize" Value="15"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Foreground" Value="#6b7688"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="TabItem.leftTab:selected"><Setter Property="Background" Value="#edf4ff"/><Setter Property="Foreground" Value="#185aa6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="#8cb2e2"/><Setter Property="BorderThickness" Value="0,0,0,2"/></Style>
    <Style Selector="Border.searchBox"><Setter Property="Background" Value="#f5f8fc"/><Setter Property="BorderBrush" Value="#d7e1ee"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="7,2"/></Style>
    <Style Selector="Border.treeRow"><Setter Property="CornerRadius" Value="5"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="5,3"/></Style>
    <Style Selector="Border.treeRow:pointerover"><Setter Property="Background" Value="#f1f7ff"/></Style>
    <Style Selector="Border.treeRow.selected"><Setter Property="Background" Value="#e7f1ff"/></Style>
    <Style Selector="Border.branchV"><Setter Property="Width" Value="1"/><Setter Property="Height" Value="28"/><Setter Property="Background" Value="#d2dcea"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
    <Style Selector="Border.branchH"><Setter Property="Width" Value="10"/><Setter Property="Height" Value="1"/><Setter Property="Background" Value="#d2dcea"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
    <Style Selector="Path.treeIcon"><Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="#66758f"/><Setter Property="StrokeThickness" Value="1.6"/></Style>
    <Style Selector="ListBox.treeList ListBoxItem"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/></Style>
    <Style Selector="TextBlock.treeText"><Setter Property="FontSize" Value="13"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Foreground" Value="#27354a"/></Style>
    <Style Selector="TextBlock.selectedText"><Setter Property="Foreground" Value="#165ca8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.emptyTitle"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#334155"/><Setter Property="HorizontalAlignment" Value="Center"/></Style>
  </UserControl.Styles>

  <TabControl Classes="leftTabs" SelectedIndex="{Binding LeftTabIndex}">
    <TabItem Classes="leftTab" Header="项目">
      <StackPanel Spacing="8" Margin="0,6,0,0">
        <Border Classes="searchBox">
          <Grid ColumnDefinitions="16,*" ColumnSpacing="6">
            <Path Classes="treeIcon" Data="{StaticResource SearchIcon}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" PlaceholderText="搜索项目树..." BorderThickness="0" Background="Transparent" MinHeight="24"/>
          </Grid>
        </Border>
        <ListBox x:Name="ProjectList" Classes="treeList" ItemsSource="{Binding ProjectItems}"
                 SelectedItem="{Binding SelectedProjectItem, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 KeyDown="SelectionList_KeyDown">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="treeRow" Margin="{Binding Indent}">
                <Grid ColumnDefinitions="16,16,18,*" ColumnSpacing="5">
                  <Grid><Border Classes="branchV" IsVisible="{Binding HasConnector}"/><Border Classes="branchH" IsVisible="{Binding HasConnector}"/></Grid>
                  <Path Grid.Column="1" Classes="treeIcon" Data="{StaticResource ChevronDownIcon}" IsVisible="{Binding IsCategory}"/>
                  <Path Grid.Column="2" Classes="treeIcon" Data="{StaticResource ProjectIcon}" IsVisible="{Binding IsRoot}"/>
                  <Path Grid.Column="2" Classes="treeIcon" Data="{StaticResource FolderIcon}" IsVisible="{Binding IsFolder}"/>
                  <Path Grid.Column="2" Classes="treeIcon" Data="{StaticResource WorldIcon}" IsVisible="{Binding IsWorld}"/>
                  <Path Grid.Column="2" Classes="treeIcon" Data="{StaticResource MaterialIcon}" IsVisible="{Binding IsAsset}"/>
                  <Path Grid.Column="2" Classes="treeIcon" Data="{StaticResource ScriptIcon}" IsVisible="{Binding IsScript}"/>
                  <Path Grid.Column="2" Classes="treeIcon" Data="{StaticResource BuildIcon}" IsVisible="{Binding IsBuild}"/>
                  <TextBlock Grid.Column="3" Text="{Binding Title}" Classes="treeText"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </TabItem>
    <TabItem Classes="leftTab" Header="层级">
      <ListBox x:Name="HierarchyList" Classes="treeList" Margin="0,8,0,0" MinHeight="220"
               ItemsSource="{Binding HierarchyItems}"
               SelectedItem="{Binding SelectedHierarchyItem, Mode=TwoWay}"
               Background="Transparent" BorderThickness="0"
               KeyDown="SelectionList_KeyDown">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Classes="treeRow" Margin="{Binding Indent}">
              <Grid ColumnDefinitions="16,16,18,*" ColumnSpacing="5">
                <Grid><Border Classes="branchV" IsVisible="{Binding HasConnector}"/><Border Classes="branchH" IsVisible="{Binding HasConnector}"/></Grid>
                <Path Grid.Column="1" Classes="treeIcon" Data="{StaticResource ChevronDownIcon}" IsVisible="{Binding IsRoot}"/>
                <Path Grid.Column="2" Classes="treeIcon" Data="{StaticResource WorldIcon}" IsVisible="{Binding IsRoot}"/>
                <Path Grid.Column="2" Classes="treeIcon" Data="{StaticResource CameraIcon}" IsVisible="{Binding IsCamera}"/>
                <Path Grid.Column="2" Classes="treeIcon" Data="{StaticResource GroundIcon}" IsVisible="{Binding IsGround}"/>
                <Path Grid.Column="2" Classes="treeIcon" Data="{StaticResource RegionIcon}" IsVisible="{Binding IsRegion}"/>
                <Path Grid.Column="2" Classes="treeIcon" Data="{StaticResource EntityIcon}" IsVisible="{Binding IsEntity}"/>
                <TextBlock Grid.Column="3" Text="{Binding Title}" Classes="treeText"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </TabItem>
  </TabControl>
</UserControl>
