<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Inter"/>
    <Setter Property="Foreground" Value="#172033"/>
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="#fbfcff"/>
    <Setter Property="BorderBrush" Value="#d9e0ec"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BoxShadow" Value="0 14 30 0 #160f172a"/>
  </Style>
  <Style Selector="Border.chrome">
    <Setter Property="Background" Value="#edf2f8"/>
    <Setter Property="BorderBrush" Value="#d7dfeb"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Background" Value="#e8eef7"/>
    <Setter Property="Padding" Value="10,5"/>
  </Style>
  <Style Selector="Button">
    <Setter Property="MinWidth" Value="78"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Background" Value="#eef3fa"/>
    <Setter Property="BorderBrush" Value="#d4ddea"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="#26324a"/>
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="#e4edf8"/>
    <Setter Property="BorderBrush" Value="#9fb5d6"/>
  </Style>
  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="Foreground" Value="#697386"/>
    <Setter Property="Padding" Value="0,0,22,10"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="#075ec8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Margin" Value="0,1"/>
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#40516f"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="#758197"/>
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="#758197"/>
  </Style>
</Styles>
