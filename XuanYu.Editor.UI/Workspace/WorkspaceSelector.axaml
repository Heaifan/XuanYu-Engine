<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.WorkspaceSelector"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border BorderBrush="{StaticResource Color.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Standard}"
          Padding="8,4"
          VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
      <xy:XYCaption Text="工作区"
                    VerticalAlignment="Center"/>
      <xy:XYMenuBar Classes="compact"
                    ShowDivider="False"
                    VerticalAlignment="Center">
        <xy:XYMenuBarItem Label="{Binding CurrentEditorModeText}"
                          Width="224"
                          ShowChevron="True"
                          ToolTip.Tip="切换工作区">
          <xy:XYMenu Classes="xyui-workspace-menu">
            <xy:XYMenuItem Classes="xyui-workspace-item"
                           Label="要素编辑"
                           CheckKind="Radio"
                           IsChecked="{Binding IsRegionEditMode, Mode=OneWay}"
                           Command="{Binding SelectFeatureWorkspaceCommand}"/>
            <xy:XYMenuItem Classes="xyui-workspace-item"
                           Label="场景编辑"
                           Shortcut="暂未开放"
                           CheckKind="Radio"
                           IsEnabled="False"/>
            <xy:XYMenuItem Classes="xyui-workspace-item"
                           Label="调试"
                           Shortcut="暂未开放"
                           CheckKind="Radio"
                           IsEnabled="False"/>
          </xy:XYMenu>
        </xy:XYMenuBarItem>
      </xy:XYMenuBar>
    </StackPanel>
  </Border>
</UserControl>
