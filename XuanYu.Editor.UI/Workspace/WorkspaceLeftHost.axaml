<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.WorkspaceLeftHost"
             x:DataType="local:UiVm">
  <Grid>
    <local:Left IsVisible="{Binding IsMapWorkspace}"/>
    <StackPanel IsVisible="{Binding IsRegionWorkspace}" Spacing="10" Margin="2,6">
      <TextBlock Text="区域" Classes="uiSection"/>
      <TextBlock Text="当前仅开放 Workspace 切换" Classes="uiValue" TextWrapping="Wrap"/>
      <TextBlock Text="区域列表将在 REGION-A 接入" Classes="uiLabel" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
