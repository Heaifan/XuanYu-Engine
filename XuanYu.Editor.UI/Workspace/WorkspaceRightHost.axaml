<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.WorkspaceRightHost"
             x:DataType="local:UiVm">
  <Grid>
    <local:Right IsVisible="{Binding IsMapWorkspace}"/>
    <StackPanel IsVisible="{Binding IsRegionWorkspace}" Spacing="10" Margin="2,6">
      <TextBlock Text="区域属性" Classes="uiSection"/>
      <TextBlock Text="当前未选择区域" Classes="uiValue" TextWrapping="Wrap"/>
      <TextBlock Text="REGION-A 接入后显示正式属性" Classes="uiLabel" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
