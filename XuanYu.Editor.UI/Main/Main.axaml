<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.Main">
  <Grid RowDefinitions="Auto,*,Auto" x:DataType="local:UiVm">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding ActiveModeTitle}" Foreground="White" FontSize="18" FontWeight="Bold"/>
      <TextBlock Text="{Binding FooterMessage}" Foreground="#b7c0d5" FontSize="12"/>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,18,0,18" CornerRadius="8" BorderThickness="1" BorderBrush="#31405d" Background="#0b1220">
      <Grid>
        <Grid RowDefinitions="*,Auto,*" ColumnDefinitions="*,Auto,*">
          <Border Grid.Row="1" Grid.Column="1" Width="220" Height="140" CornerRadius="8" BorderBrush="#263755" BorderThickness="1" Background="#101a2e">
            <Grid RowDefinitions="*,Auto,*">
              <TextBlock Grid.Row="1" Text="{Binding SelectionTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#a7b8d3" FontSize="20" FontWeight="SemiBold"/>
            </Grid>
          </Border>
        </Grid>
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" CornerRadius="5" Background="#17243a" Padding="10,6">
          <TextBlock Text="{Binding SelectionSubtitle}" Foreground="#cbd5e1" FontSize="12"/>
        </Border>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal">
      <Border Classes="pill" Background="#1a2940" Margin="0,0,8,0"><TextBlock Text="环绕" Foreground="White"/></Border>
      <Border Classes="pill" Background="#1a2940" Margin="0,0,8,0"><TextBlock Text="平移" Foreground="White"/></Border>
      <Border Classes="pill" Background="#1a2940" Margin="0,0,8,0"><TextBlock Text="聚焦" Foreground="White"/></Border>
      <Border Classes="pill" Background="#18304b"><TextBlock Text="{Binding FooterState}" Foreground="White"/></Border>
    </StackPanel>
  </Grid>
</UserControl>
