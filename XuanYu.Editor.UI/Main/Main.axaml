<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.Main">
  <Grid RowDefinitions="Auto,*,Auto" x:DataType="local:UiVm">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Border Classes="pill" Background="#17243a"><TextBlock Text="透视" Foreground="#dbeafe"/></Border>
      <Border Classes="pill" Background="#17243a"><TextBlock Text="未选择对象" Foreground="#dbeafe"/></Border>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,14,0,14" CornerRadius="6" BorderThickness="1" BorderBrush="#31405d" Background="#0b1220">
      <Grid>
        <Canvas>
          <Line StartPoint="120,80" EndPoint="120,600" Stroke="#162238" StrokeThickness="1"/>
          <Line StartPoint="240,80" EndPoint="240,600" Stroke="#162238" StrokeThickness="1"/>
          <Line StartPoint="360,80" EndPoint="360,600" Stroke="#162238" StrokeThickness="1"/>
          <Line StartPoint="480,80" EndPoint="480,600" Stroke="#162238" StrokeThickness="1"/>
          <Line StartPoint="600,80" EndPoint="600,600" Stroke="#162238" StrokeThickness="1"/>
          <Line StartPoint="80,160" EndPoint="720,160" Stroke="#162238" StrokeThickness="1"/>
          <Line StartPoint="80,280" EndPoint="720,280" Stroke="#162238" StrokeThickness="1"/>
          <Line StartPoint="80,400" EndPoint="720,400" Stroke="#162238" StrokeThickness="1"/>
          <Line StartPoint="80,520" EndPoint="720,520" Stroke="#162238" StrokeThickness="1"/>
          <Line StartPoint="400,130" EndPoint="400,560" Stroke="#375a7f" StrokeThickness="2"/>
          <Line StartPoint="160,340" EndPoint="660,340" Stroke="#7f3d4a" StrokeThickness="2"/>
        </Canvas>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="+Y" Foreground="#9fb6d8" HorizontalAlignment="Center"/>
          <TextBlock Text="-X  ─────  原点  ─────  +X" Foreground="#d1d9e8" FontSize="16"/>
          <TextBlock Text="-Y" Foreground="#9fb6d8" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Background="#111c2f" Padding="12">
          <StackPanel>
            <TextBlock Text="+Z" Foreground="#dbeafe" HorizontalAlignment="Center"/>
            <TextBlock Text="↖ Y    X ↗" Foreground="#93a7c5"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal">
      <Border Classes="pill" Background="#1a2940" Margin="0,0,8,0"><TextBlock Text="左键选择" Foreground="White"/></Border>
      <Border Classes="pill" Background="#1a2940" Margin="0,0,8,0"><TextBlock Text="中键环绕" Foreground="White"/></Border>
      <Border Classes="pill" Background="#1a2940" Margin="0,0,8,0"><TextBlock Text="右键平移" Foreground="White"/></Border>
      <Border Classes="pill" Background="#18304b"><TextBlock Text="{Binding FooterMode}" Foreground="White"/></Border>
    </StackPanel>
  </Grid>
</UserControl>
