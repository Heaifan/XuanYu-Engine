<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.Main">
  <Grid RowDefinitions="Auto,*,Auto" x:DataType="local:UiVm">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Border Classes="pill" Background="#17243a"><TextBlock Text="透视" Foreground="#dbeafe"/></Border>
      <Border Classes="pill" Background="#17243a"><TextBlock Text="NativeHost Probe" Foreground="#dbeafe"/></Border>
    </StackPanel>

    <local:VulkanViewport Grid.Row="1" Margin="0,14,0,14"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal">
      <Border Classes="pill" Background="#1a2940" Margin="0,0,8,0"><TextBlock Text="左键选择" Foreground="White"/></Border>
      <Border Classes="pill" Background="#1a2940" Margin="0,0,8,0"><TextBlock Text="中键环绕" Foreground="White"/></Border>
      <Border Classes="pill" Background="#1a2940" Margin="0,0,8,0"><TextBlock Text="右键平移" Foreground="White"/></Border>
      <Border Classes="pill" Background="#18304b"><TextBlock Text="{Binding FooterMode}" Foreground="White"/></Border>
    </StackPanel>
  </Grid>
</UserControl>
