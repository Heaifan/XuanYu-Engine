<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.ContextToolBar"
             x:DataType="local:UiVm">
  <Border x:Name="ContextRoot" IsVisible="{Binding IsFeatureEditingActive}"
          BorderBrush="{StaticResource Color.Border.Default}" BorderThickness="1"
          CornerRadius="{StaticResource Radius.Standard}" Padding="8,4">
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
      <xy:XYBreadcrumb VerticalAlignment="Center">
        <xy:XYBreadcrumbItem Label="地图编辑"
                             Invoked="MapEditorBreadcrumb_Invoked"/>
        <xy:XYBreadcrumbItem Label="要素编辑" IsCurrent="True"/>
      </xy:XYBreadcrumb>
      <xy:XYSeparator Variant="Section" />

      <xy:XYToggleButton IsChecked="{Binding IsSelectTool, Mode=OneWay}"
                         Command="{Binding SelectToolCommand}"
                         CommandParameter="选择"
                         ToolTip.Tip="选择">
        <TextBlock Text="选择"/>
      </xy:XYToggleButton>
      <xy:XYToggleButton IsChecked="{Binding IsBoxSelectTool, Mode=OneWay}"
                         Command="{Binding SelectToolCommand}"
                         CommandParameter="框�?
                         ToolTip.Tip="框�?>
        <TextBlock Text="框�?/>
      </xy:XYToggleButton>

      <xy:XYSeparator Variant="Section" />

      <xy:XYMenuBar Classes="compact" ShowDivider="False" VerticalAlignment="Center">
        <xy:XYMenuBarItem Classes="xyui-toolbar-menu-item" Label="�? ShowChevron="True">
          <xy:XYMenu>
            <xy:XYMenuItem Label="点标�? Command="{Binding SelectRegionAuthoringModeCommand}" CommandParameter="地图标记"/>
          </xy:XYMenu>
        </xy:XYMenuBarItem>
        <xy:XYMenuBarItem Classes="xyui-toolbar-menu-item" Label="�? ShowChevron="True">
          <xy:XYMenu>
            <xy:XYMenuItem Label="道路" Command="{Binding SelectRegionAuthoringModeCommand}" CommandParameter="道路"/>
          </xy:XYMenu>
        </xy:XYMenuBarItem>
        <xy:XYMenuBarItem Classes="xyui-toolbar-menu-item" Label="�? ShowChevron="True">
          <xy:XYMenu>
            <xy:XYMenuItem Label="区域" Command="{Binding SelectRegionAuthoringModeCommand}" CommandParameter="区域�?/>
          </xy:XYMenu>
        </xy:XYMenuBarItem>
      </xy:XYMenuBar>

      <StackPanel IsVisible="{Binding IsRegionSurfaceAuthoringMode}" Orientation="Horizontal" Spacing="4">
        <xy:XYSeparator Variant="Section" />
        <xy:XYButton Content="开始绘�? Click="BeginRegionDrawing_Click"
                     IsEnabled="{Binding CanRequestRegionDrawing}"/>
      </StackPanel>
      <StackPanel IsVisible="{Binding IsRoadAuthoringMode}" Orientation="Horizontal" Spacing="4">
        <xy:XYSeparator Variant="Section" />
        <xy:XYButton Content="绘制道路" Click="BeginRoadDrawing_Click"
                     IsEnabled="{Binding CanRequestRoadDrawing}"/>
      </StackPanel>
      <StackPanel IsVisible="{Binding IsMarkerAuthoringMode}" Orientation="Horizontal" Spacing="4">
        <xy:XYSeparator Variant="Section" />
        <xy:XYButton Content="放置地图标记" Click="BeginMarkerPlacement_Click"
                     IsEnabled="{Binding CanRequestMarkerPlacement}"/>
      </StackPanel>
      <StackPanel IsVisible="{Binding IsRegionDrawingTool}" Orientation="Horizontal" Spacing="4">
        <xy:XYCaption Text="区域绘制�?/>
        <xy:XYText Text="{Binding RegionDrawingDraftVertexCount}"/>
        <xy:XYButton Content="撤销顶点" Click="UndoRegionDrawingVertex_Click"
                     IsEnabled="{Binding CanUndoRegionDrawingVertex}"/>
        <xy:XYButton Content="完成闭合" Click="CompleteRegionDrawing_Click"
                     IsEnabled="{Binding CanCompleteRegionDrawing}"/>
        <xy:XYButton Content="取消" Click="CancelRegionDrawing_Click"
                     IsEnabled="{Binding CanCancelRegionDrawing}"/>
      </StackPanel>
      <StackPanel IsVisible="{Binding IsRoadDrawingTool}" Orientation="Horizontal" Spacing="4">
        <xy:XYCaption Text="道路绘制�?/>
        <xy:XYText Text="{Binding RoadDrawingDraftPointCount}"/>
        <xy:XYButton Content="撤销节点" Click="UndoRoadDrawingVertex_Click"
                     IsEnabled="{Binding CanUndoRoadDrawingVertex}"/>
        <xy:XYButton Content="完成道路" Click="CompleteRoadDrawing_Click"
                     IsEnabled="{Binding CanCompleteRoadDrawing}"/>
        <xy:XYButton Content="取消" Click="CancelRoadDrawing_Click"
                     IsEnabled="{Binding CanCancelRoadDrawing}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
