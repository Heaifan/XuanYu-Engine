<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.EditToolsModule"
             x:DataType="local:UiVm">
  <Border BorderBrush="{StaticResource Color.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Standard}"
          Padding="8,4"
          VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">
      <xy:XYCaption Text="编辑"
                    VerticalAlignment="Center"/>
      <xy:XYToggleButton MinHeight="34"
                         IsEnabled="{Binding IsEditMode}"
                         IsChecked="{Binding IsSelectTool, Mode=OneWay}"
                         Command="{Binding SelectToolCommand}"
                         CommandParameter="选择"
                         ToolTip.Tip="选择工具">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="Select" Size="Small"/>
          <TextBlock Text="选择"/>
        </StackPanel>
      </xy:XYToggleButton>
      <xy:XYToggleButton MinHeight="34"
                         IsEnabled="False"
                         IsChecked="{Binding IsBoxSelectTool, Mode=OneWay}"
                         ToolTip.Tip="框选功能尚未实装（即将推出）">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="BoxSelect" Size="Small"/>
          <TextBlock Text="框选"/>
        </StackPanel>
      </xy:XYToggleButton>
      <xy:XYToggleButton MinHeight="34"
                         IsEnabled="{Binding CanTransformSelectedEntity}"
                         IsChecked="{Binding IsMoveTool, Mode=OneWay}"
                         Command="{Binding SelectToolCommand}"
                         CommandParameter="移动"
                         ToolTip.Tip="移动工具">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="Move" Size="Small"/>
          <TextBlock Text="移动"/>
        </StackPanel>
      </xy:XYToggleButton>
      <xy:XYToggleButton MinHeight="34"
                         IsEnabled="{Binding CanTransformSelectedEntity}"
                         IsChecked="{Binding IsRotateTool, Mode=OneWay}"
                         Command="{Binding SelectToolCommand}"
                         CommandParameter="旋转"
                         ToolTip.Tip="旋转工具">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="Rotate" Size="Small"/>
          <TextBlock Text="旋转"/>
        </StackPanel>
      </xy:XYToggleButton>
      <xy:XYToggleButton MinHeight="34"
                         IsEnabled="{Binding CanTransformSelectedEntity}"
                         IsChecked="{Binding IsScaleTool, Mode=OneWay}"
                         Command="{Binding SelectToolCommand}"
                         CommandParameter="缩放"
                         ToolTip.Tip="缩放工具">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="Scale" Size="Small"/>
          <TextBlock Text="缩放"/>
        </StackPanel>
      </xy:XYToggleButton>
    </StackPanel>
  </Border>
</UserControl>
