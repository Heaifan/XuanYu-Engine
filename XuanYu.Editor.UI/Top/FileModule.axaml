<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.FileModule"
             x:DataType="local:UiVm">
  <Border BorderBrush="{StaticResource Color.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Standard}"
          Padding="8,4"
          VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
      <xy:XYCaption Text="菜单" VerticalAlignment="Center"/>
      <xy:XYMenuBar Classes="compact"
                    ShowDivider="False"
                    VerticalAlignment="Center">
        <xy:XYMenuBarItem Classes="xyui-toolbar-menu-item" Label="文件" Icon="File" IconSize="Medium">
          <xy:XYMenu>
            <xy:XYMenuItem Label="打开" Command="{Binding RunCommand}" CommandParameter="打开"/>
            <xy:XYMenuItem Label="保存" Command="{Binding RunCommand}" CommandParameter="保存"/>
            <xy:XYMenuItem Label="另存为" Command="{Binding RunCommand}" CommandParameter="另存为"/>
            <xy:XYMenuItem Label="导入 GLB" Command="{Binding RunCommand}" CommandParameter="导入 GLB"/>
          </xy:XYMenu>
        </xy:XYMenuBarItem>
        <xy:XYMenuBarItem Classes="xyui-toolbar-menu-item" Label="新建" Icon="NewFile" IconSize="Medium" ShowChevron="True">
          <xy:XYMenu>
            <xy:XYMenuItem Label="新建" Icon="NewFile" Command="{Binding RunCommand}" CommandParameter="新建"/>
            <xy:XYSeparator Variant="Section"/>
            <xy:XYMenuItem Label="立方体" Icon="Add" Command="{Binding RunCommand}" CommandParameter="添加立方体"/>
          </xy:XYMenu>
        </xy:XYMenuBarItem>
      </xy:XYMenuBar>
      <xy:XYButton Variant="Secondary"
                   x:Name="OpenSceneButton"
                   local:XYDiagnostic.DebugId="XYE.TOP.FILE.OPEN"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="打开"
                   ToolTip.Tip="打开场景">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="Open" Size="Medium"/>
          <TextBlock Text="打开"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYButton Variant="Secondary"
                   x:Name="SaveSceneButton"
                   local:XYDiagnostic.DebugId="XYE.TOP.FILE.SAVE"
                   MinHeight="34"
                   IsEnabled="{Binding CanRunSaveCommand}"
                   Command="{Binding RunCommand}"
                   CommandParameter="保存"
                   ToolTip.Tip="保存场景">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="Save" Size="Medium"/>
          <TextBlock Text="保存"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYSeparator Variant="VerticalSplit"
                      Height="20"
                      Margin="2,0"/>
      <xy:XYButton Variant="Secondary"
                   x:Name="UndoButton"
                   local:XYDiagnostic.DebugId="XYE.TOP.FILE.UNDO"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="撤销"
                   ToolTip.Tip="撤销">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="Undo" Size="Medium"/>
          <TextBlock Text="撤销"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYButton Variant="Secondary"
                   x:Name="RedoButton"
                   local:XYDiagnostic.DebugId="XYE.TOP.FILE.REDO"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="重做"
                   ToolTip.Tip="重做">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="Redo" Size="Medium"/>
          <TextBlock Text="重做"/>
        </StackPanel>
      </xy:XYButton>
    </StackPanel>
  </Border>
</UserControl>
