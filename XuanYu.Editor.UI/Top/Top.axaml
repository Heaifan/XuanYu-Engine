<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.Top"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <StyleInclude Source="avares://XuanYu.Editor.UI/Top/Top.States.axaml"/>
    <Style Selector="Border.commandRail"><Setter Property="Background" Value="#fbfdff"/><Setter Property="BorderBrush" Value="#d5dfec"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="10,5"/></Style>
    <Style Selector="Border.topGroup"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#d0dae8"/><Setter Property="BorderThickness" Value="0,0,1,0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="0,0,10,0"/></Style>
    <Style Selector="Border.statePill"><Setter Property="Background" Value="#eef7f1"/><Setter Property="BorderBrush" Value="#c9e3d0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="9,4"/></Style>
    <Style Selector="Menu"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="MenuItem"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="11,5"/><Setter Property="Foreground" Value="#2f3d52"/></Style>
    <Style Selector="MenuItem:pointerover"><Setter Property="Background" Value="#edf3fb"/></Style>
    <Style Selector="Button.cmdBtn"><Setter Property="MinHeight" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.cmdBtn:pointerover"><Setter Property="Background" Value="#edf3fb"/></Style>
    <Style Selector="Button.cmdBtn:pressed"><Setter Property="Background" Value="#dfeaf8"/></Style>
    <Style Selector="Button.cmdBtn:disabled"><Setter Property="Opacity" Value="0.48"/></Style>
    <Style Selector="ToggleButton.toolBtn"><Setter Property="MinHeight" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/></Style>
    <Style Selector="ToggleButton.toolBtn:pointerover"><Setter Property="Background" Value="#edf3fb"/></Style>
    <Style Selector="ToggleButton.toolBtn:pressed"><Setter Property="Background" Value="#dfeaf8"/></Style>
    <Style Selector="ToggleButton.toolBtn:checked"><Setter Property="Background" Value="#eef5ff"/><Setter Property="BorderBrush" Value="#94b9e8"/><Setter Property="BorderThickness" Value="1,1,1,3"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Path.topIcon"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="#5d6d83"/><Setter Property="StrokeThickness" Value="1.6"/></Style>
    <Style Selector="Button.cmdBtn:pointerover Path.topIcon"><Setter Property="Stroke" Value="#365d8d"/></Style>
    <Style Selector="ToggleButton.toolBtn:pointerover Path.topIcon"><Setter Property="Stroke" Value="#365d8d"/></Style>
    <Style Selector="ToggleButton.toolBtn:checked Path.topIcon"><Setter Property="Stroke" Value="#185aa6"/></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
    <Border Classes="commandRail">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Menu>
          <MenuItem Header="文件">
            <MenuItem Header="新建" Command="{Binding RunCommand}" CommandParameter="新建"/>
            <MenuItem Header="打开" Command="{Binding RunCommand}" CommandParameter="打开"/>
            <MenuItem Header="保存" Command="{Binding RunCommand}" CommandParameter="保存"/>
            <MenuItem Header="另存为" Command="{Binding RunCommand}" CommandParameter="另存为"/>
            <MenuItem Header="导入 GLB" Command="{Binding RunCommand}" CommandParameter="导入 GLB"/>
          </MenuItem>
          <MenuItem Header="添加">
            <MenuItem Header="立方体" Command="{Binding RunCommand}" CommandParameter="添加立方体"/>
          </MenuItem>
        </Menu>
        <Border Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="cmdBtn" Command="{Binding RunCommand}" CommandParameter="新建"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource NewFileIcon}"/><TextBlock Text="新建"/></StackPanel></Button><Button Classes="cmdBtn" Command="{Binding RunCommand}" CommandParameter="打开"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource OpenIcon}"/><TextBlock Text="打开"/></StackPanel></Button><Button Classes="cmdBtn" Command="{Binding RunCommand}" CommandParameter="保存" IsEnabled="{Binding CanRunSaveCommand}" Background="{Binding SaveButtonBackground}" BorderBrush="{Binding SaveButtonBorderBrush}"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource SaveIcon}"/><TextBlock Text="保存"/></StackPanel></Button><Button Classes="cmdBtn" Command="{Binding RunCommand}" CommandParameter="另存为"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource SaveIcon}"/><TextBlock Text="另存为"/></StackPanel></Button></StackPanel></Border>
        <Border Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="cmdBtn" Command="{Binding RunCommand}" CommandParameter="撤销"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource UndoIcon}"/><TextBlock Text="撤销"/></StackPanel></Button><Button Classes="cmdBtn" Command="{Binding RunCommand}" CommandParameter="重做"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource RedoIcon}"/><TextBlock Text="重做"/></StackPanel></Button></StackPanel></Border>
        <Border Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="cmdBtn" Command="{Binding RunCommand}" CommandParameter="运行"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource PlayIcon}"/><TextBlock Text="运行"/></StackPanel></Button><Button Classes="cmdBtn" Command="{Binding RunCommand}" CommandParameter="停止"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource StopIcon}"/><TextBlock Text="停止"/></StackPanel></Button></StackPanel></Border>
      </StackPanel>
      <Border Grid.Column="1" Classes="statePill" Background="{Binding DocumentStatusBackground}" BorderBrush="{Binding DocumentStatusBorderBrush}"><TextBlock Text="{Binding DocumentStatusText}" Foreground="{Binding DocumentStatusForeground}" FontWeight="SemiBold"/></Border>
    </Grid>
    </Border>

    <Border Grid.Row="1" Classes="commandRail">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Border Classes="statePill"><TextBlock Text="{Binding CurrentModeDisplayName}" FontWeight="SemiBold"/></Border>
        <local:WorkspaceSelector/>
        <Button Classes="cmdBtn" Command="{Binding ToggleEditorModeCommand}"><TextBlock Text="{Binding ModeActionText}"/></Button>
        <TextBlock Text="Tab 切换" Classes="muted" VerticalAlignment="Center"/>
        <Border IsVisible="{Binding IsEditMode}" Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><ToggleButton Classes="toolBtn" IsChecked="{Binding IsSelectTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="选择"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource SelectIcon}"/><TextBlock Text="选择"/></StackPanel></ToggleButton><ToggleButton IsVisible="{Binding IsMapEditMode}" Classes="toolBtn" IsChecked="{Binding IsBoxSelectTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="框选"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource BoxSelectIcon}"/><TextBlock Text="框选"/></StackPanel></ToggleButton></StackPanel></Border>
        <Border IsVisible="{Binding IsMapEditMode}" Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><ToggleButton Classes="toolBtn" IsChecked="{Binding IsMoveTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="移动"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource MoveIcon}"/><TextBlock Text="移动"/></StackPanel></ToggleButton><ToggleButton Classes="toolBtn" IsChecked="{Binding IsRotateTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="旋转"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource RotateIcon}"/><TextBlock Text="旋转"/></StackPanel></ToggleButton><ToggleButton Classes="toolBtn" IsChecked="{Binding IsScaleTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="缩放"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource ScaleIcon}"/><TextBlock Text="缩放"/></StackPanel></ToggleButton></StackPanel></Border>
        <Border Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="cmdBtn" Command="{Binding RunCommand}" CommandParameter="聚焦"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource FocusIcon}"/><TextBlock Text="聚焦"/></StackPanel></Button><Button Classes="cmdBtn" Command="{Binding RunCommand}" CommandParameter="查看全部"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource FocusIcon}"/><TextBlock Text="查看全部"/></StackPanel></Button></StackPanel></Border>
        <Border Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><Button Classes="cmdBtn" Command="{Binding RunCommand}" CommandParameter="平移"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource PanIcon}"/><TextBlock Text="平移"/></StackPanel></Button><Button Classes="cmdBtn" Command="{Binding RunCommand}" CommandParameter="环绕"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource OrbitIcon}"/><TextBlock Text="环绕"/></StackPanel></Button></StackPanel></Border>
        <Border Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><ToggleButton IsVisible="{Binding IsMapEditMode}" Classes="toolBtn" IsChecked="{Binding IsSnapEnabled, Mode=OneWay}" Command="{Binding ToggleSnapCommand}"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource SnapIcon}"/><TextBlock Text="吸附"/></StackPanel></ToggleButton><Menu><MenuItem Header="环境"><MenuItem Header="{Binding GridDisplayText}" Command="{Binding RunCommand}" CommandParameter="显示构造网格"/><MenuItem Header="{Binding OriginDisplayText}" Command="{Binding RunCommand}" CommandParameter="显示世界原点"/><MenuItem Header="{Binding WorldAxesDisplayText}" Command="{Binding RunCommand}" CommandParameter="显示世界坐标轴"/><MenuItem Header="{Binding EditorBackgroundDisplayText}" Command="{Binding RunCommand}" CommandParameter="显示编辑器背景"/></MenuItem></Menu></StackPanel></Border>
      </StackPanel>
      <Border Grid.Column="1" Classes="statePill" Background="#f3f6fb" BorderBrush="#d9e2ee"><TextBlock Text="{Binding FooterMode}" Foreground="#3b4a60"/></Border>
    </Grid>
    </Border>
  </Grid>
</UserControl>
