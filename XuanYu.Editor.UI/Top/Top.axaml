<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.Top"
             x:DataType="local:UiVm">
  <Grid RowDefinitions="Auto,Auto"
        RowSpacing="6"
        Margin="0,2">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto"
          ColumnSpacing="8"
          VerticalAlignment="Center">
      <local:WorkspaceSelector Grid.Column="0"
                               VerticalAlignment="Center"/>
      <local:FileModule Grid.Column="1"
                        VerticalAlignment="Center"/>
      <local:RuntimeStatusModule Grid.Column="3"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"/>
    </Grid>
    <WrapPanel Grid.Row="1"
               Orientation="Horizontal"
               VerticalAlignment="Center">
      <local:EditToolsModule Margin="0,0,8,8"/>
      <local:ContextToolBar Margin="0,0,8,8"/>
      <local:ViewModule Margin="0,0,8,8"/>
      <local:SnapModule Margin="0,0,8,8"/>
    </WrapPanel>
  </Grid>
</UserControl>
