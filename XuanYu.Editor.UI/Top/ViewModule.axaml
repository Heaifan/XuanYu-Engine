<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.ViewModule"
             x:DataType="local:UiVm">
  <Border BorderBrush="{StaticResource Color.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Standard}"
          Padding="8,4"
          VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">
      <xy:XYCaption Text="视图"
                    VerticalAlignment="Center"/>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="聚焦"
                   ToolTip.Tip="聚焦选择对象">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="Focus" Size="Small"/>
          <TextBlock Text="聚焦"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="查看全部"
                   ToolTip.Tip="查看全部">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="ViewAll" Size="Small"/>
          <TextBlock Text="全览"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="平移"
                   ToolTip.Tip="平移视图">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="Pan" Size="Small"/>
          <TextBlock Text="平移"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="环绕"
                   ToolTip.Tip="环绕视图">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <xy:XYIcon Icon="Orbit" Size="Small"/>
          <TextBlock Text="环绕"/>
        </StackPanel>
      </xy:XYButton>
      <local:ViewOptionsMenu/>
    </StackPanel>
  </Border>
</UserControl>
