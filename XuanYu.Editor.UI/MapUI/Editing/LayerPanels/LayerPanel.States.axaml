<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="ToggleButton.xyui-toggle-button.layerSwitch, ToggleButton.xyui-toggle-button.layerLockSwitch">
    <Setter Property="Width" Value="26"/><Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="2"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="3"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ToggleButton.xyui-toggle-button.layerSwitch /template/ ContentPresenter,
                  ToggleButton.xyui-toggle-button.layerLockSwitch /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="ToggleButton.xyui-toggle-button.layerSwitch:pointerover /template/ ContentPresenter,
                  ToggleButton.xyui-toggle-button.layerLockSwitch:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Strong}"/>
  </Style>
  <Style Selector="ToggleButton.xyui-toggle-button.layerSwitch:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Layer.State.VisibleBg}"/><Setter Property="BorderBrush" Value="{StaticResource Color.Border.Strong}"/>
  </Style>
  <Style Selector="ToggleButton.xyui-toggle-button.layerLockSwitch:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Layer.State.LockedBg}"/><Setter Property="BorderBrush" Value="{StaticResource Color.Border.Strong}"/>
  </Style>
  <Style Selector="ToggleButton.xyui-toggle-button.layerSwitch:checked">
    <Setter Property="Background" Value="{StaticResource Layer.State.VisibleBg}"/>
  </Style>
  <Style Selector="ToggleButton.xyui-toggle-button.layerLockSwitch:checked">
    <Setter Property="Background" Value="{StaticResource Layer.State.LockedBg}"/>
  </Style>
  <Style Selector="ToggleButton.xyui-toggle-button.layerSwitch:checked:pointerover /template/ ContentPresenter,
                  ToggleButton.xyui-toggle-button.layerLockSwitch:checked:pointerover /template/ ContentPresenter,
                  ToggleButton.xyui-toggle-button.layerSwitch:checked:pressed /template/ ContentPresenter,
                  ToggleButton.xyui-toggle-button.layerLockSwitch:checked:pressed /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Strong}"/>
  </Style>
  <Style Selector="ToggleButton.xyui-toggle-button.layerSwitch Path.layerIcon"><Setter Property="Stroke" Value="{StaticResource Layer.State.Hidden}"/></Style>
  <Style Selector="ToggleButton.xyui-toggle-button.layerSwitch:checked Path.layerIcon"><Setter Property="Stroke" Value="{StaticResource Layer.State.Visible}"/></Style>
  <Style Selector="ToggleButton.xyui-toggle-button.layerLockSwitch Path.layerIcon"><Setter Property="Stroke" Value="{StaticResource Layer.State.Unlocked}"/></Style>
  <Style Selector="ToggleButton.xyui-toggle-button.layerLockSwitch:checked Path.layerIcon"><Setter Property="Stroke" Value="{StaticResource Layer.State.Locked}"/></Style>
  <Style Selector="ListBox.layerList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                  ListBox.layerList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                  ListBox.layerList ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Color.Selection.Bg}"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
  </Style>
  <Style Selector="ListBox.layerList ListBoxItem:selected ToggleButton.xyui-toggle-button.layerSwitch Path.layerIcon"><Setter Property="Stroke" Value="{StaticResource Layer.State.Hidden}"/></Style>
  <Style Selector="ListBox.layerList ListBoxItem:selected ToggleButton.xyui-toggle-button.layerSwitch:checked Path.layerIcon"><Setter Property="Stroke" Value="{StaticResource Layer.State.Visible}"/></Style>
  <Style Selector="ListBox.layerList ListBoxItem:selected ToggleButton.xyui-toggle-button.layerLockSwitch Path.layerIcon"><Setter Property="Stroke" Value="{StaticResource Layer.State.Unlocked}"/></Style>
  <Style Selector="ListBox.layerList ListBoxItem:selected ToggleButton.xyui-toggle-button.layerLockSwitch:checked Path.layerIcon"><Setter Property="Stroke" Value="{StaticResource Layer.State.Locked}"/></Style>
</Styles>
