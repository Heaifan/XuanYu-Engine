<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.DatasetPanel" x:DataType="local:UiVm">
  <UserControl.Styles>
    <Style Selector="Button.datasetRow"><Setter Property="Height" Value="{StaticResource Control.Height.Standard}"/><Setter Property="MinHeight" Value="{StaticResource Control.Height.Standard}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="Border.datasetSelection"><Setter Property="Background" Value="{StaticResource Color.Selection.Bg}"/><Setter Property="BorderBrush" Value="{StaticResource Color.Accent}"/><Setter Property="BorderThickness" Value="2,0,0,0"/></Style>
  </UserControl.Styles>
  <StackPanel Spacing="8" Margin="0,6,0,0">
    <xy:XYSectionTitle Text="数据集"/>
    <xy:XYEmptyText Text="{Binding DatasetEmptyState}" IsVisible="{Binding IsDatasetEmpty}"/>
    <ListBox x:Name="DatasetList" ItemsSource="{Binding DatasetItems}" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">
      <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Height" Value="{StaticResource Control.Height.Standard}"/><Setter Property="MinHeight" Value="{StaticResource Control.Height.Standard}"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
      <ListBox.ItemTemplate><DataTemplate><xy:XYButton Classes="datasetRow" Variant="Secondary" Click="DatasetRow_Click" ToolTip.Tip="{Binding TypeIdText}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Border Grid.ColumnSpan="2" Classes="datasetSelection" IsVisible="{Binding IsSelected}"/>
          <xy:XYTruncatedText Text="{Binding Name}" Mode="End" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" ZIndex="1"/>
          <xy:XYBadge Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" ZIndex="1"/>
        </Grid>
      </xy:XYButton></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <xy:XYLabel Text="名称" Margin="0,4,0,0"/>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><xy:XYTextField Text="{Binding DatasetNameText, Mode=TwoWay}" IsEnabled="{Binding HasSelectedDataset}"/>
      <xy:XYButton Grid.Column="1" Classes="uiTextButton" Variant="Secondary" Content="应用名称" Click="ApplyName_Click" IsEnabled="{Binding HasSelectedDataset}" HorizontalAlignment="Right"/>
    </Grid>
    <xy:XYSectionTitle Text="新建数据集" Margin="0,8,0,0"/>
    <xy:XYLabel Text="类型"/>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><xy:XYSelect ItemsSource="{Binding DatasetTypeOptions}" SelectedItem="{Binding DatasetCreateTypeOption}"><xy:XYSelect.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></xy:XYSelect.ItemTemplate></xy:XYSelect>
      <xy:XYButton Grid.Column="1" Classes="uiTextButton" Variant="Secondary" Content="新建数据集" Command="{Binding RunCommand}" CommandParameter="新建数据集" AutomationProperties.Name="新建数据集" HorizontalAlignment="Right"/>
    </Grid>
    <xy:XYSeparator Variant="Section" Margin="0,8,0,0"/>
    <xy:XYLabel Text="危险操作"/>
    <xy:XYButton Classes="uiDanger" Variant="Danger" Content="解除注册" Command="{Binding RunCommand}" CommandParameter="解除注册数据集" IsEnabled="{Binding CanUnregisterDataset}" AutomationProperties.Name="解除注册数据集" HorizontalAlignment="Left"/>
  </StackPanel>
</UserControl>
