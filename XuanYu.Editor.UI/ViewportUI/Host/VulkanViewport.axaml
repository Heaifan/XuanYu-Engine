<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.VulkanViewport"
             local:XYDiagnostic.DebugId="XYE.VIEWPORT"
             x:DataType="local:UiVm">
  <Grid>
    <!-- F3：去除黑色粗边框与圆角卡片——Vulkan 画面贴合视口；最多保留 1 DIP 浅灰分隔。 -->
    <Border BorderBrush="#C9D2DC" BorderThickness="1" ClipToBounds="True">
      <local:VulkanNativeHost x:Name="ViewportNativeHost"/>
    </Border>
    <Border x:Name="FallbackLayer" IsHitTestVisible="False" Background="Transparent">
      <Grid>
        <Border Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="6" MaxWidth="360">
            <TextBlock Text="渲染视口" Foreground="{DynamicResource XY.Brush.Text.Primary}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="FallbackText" Text="正在初始化渲染后端..." Foreground="#6B7688" TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,52"
                Padding="12,7" Background="{DynamicResource XY.Brush.Surface.Overlay}"
                BorderBrush="{DynamicResource XY.Brush.Border.Color.Default}" BorderThickness="1">
          <xy:XYLoadingIndicator Text="正在初始化渲染视口…" Size="Compact" IsHitTestVisible="False"/>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
