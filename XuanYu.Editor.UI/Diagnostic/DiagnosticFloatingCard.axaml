<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XuanYu.Editor.UI.DiagnosticFloatingCard"
        Width="330" Padding="12" Background="{StaticResource Color.Bg.Panel}"
        BorderBrush="{StaticResource Color.Border.Default}" BorderThickness="1"
        CornerRadius="{StaticResource Radius.Standard}">
  <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
   <StackPanel Spacing="8">
    <StackPanel x:Name="Header" Orientation="Horizontal" Spacing="8">
      <TextBlock x:Name="Title" Foreground="White" FontWeight="SemiBold"/>
      <TextBlock x:Name="Locked" Text="● 已锁定" Foreground="{StaticResource Color.Success}"/>
      <Button x:Name="Pin" Content="锁定"/>
    </StackPanel>
    <TextBlock x:Name="Identity" Foreground="{StaticResource Color.Text.Primary}" TextWrapping="Wrap"/>
    <TextBlock x:Name="Details" Foreground="{StaticResource Color.Text.Secondary}" TextWrapping="Wrap"/>
    <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="6">
      <Button x:Name="CopyAi" Content="一键复制给 AI"/>
      <Button x:Name="Expand" Content="展开"/>
      <Button x:Name="Close" Content="关闭"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
</Border>
