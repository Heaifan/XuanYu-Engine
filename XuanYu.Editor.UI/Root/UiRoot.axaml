<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.UiRoot"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <!-- ARCH-UI-SPEC-R1-D3：分隔条属可调整边界，用 Color.Border.Strong（规范 §9.1）；悬停用 Color.Hover.Bg（§9.3） -->
    <Style Selector="GridSplitter.layoutSplitter">
      <Setter Property="Background" Value="{StaticResource Color.Border.Strong}"/>
    </Style>
    <Style Selector="GridSplitter.layoutSplitter:pointerover">
      <Setter Property="Background" Value="{StaticResource Color.Hover.Bg}"/>
    </Style>
  </UserControl.Styles>

  <!-- ARCH-UI-SPEC-R1-D3（W18~W21）：最小窗口 1024×640 下 6 边距 + 左 220 + 分隔 6 + 视口 480 + 分隔 6 + 右 300 = 1012 恰好满足 -->
  <Grid x:Name="RootGrid" Margin="6" MinWidth="1012">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="320"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto" MinHeight="32" MaxHeight="420"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Classes="panel" Padding="8,1">
      <local:Top local:XYDiagnostic.AreaId="XYE.AREA.TOP" />
    </Border>

    <Grid x:Name="MainLayoutGrid" Grid.Row="1" Margin="0,6,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="216" MinWidth="210" MaxWidth="220"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*" MinWidth="480"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="340" MinWidth="300" MaxWidth="480"/>
      </Grid.ColumnDefinitions>
      <Border Classes="panel" Padding="6" MinWidth="210" MaxWidth="220">
        <local:Left local:XYDiagnostic.AreaId="XYE.AREA.LEFT" />
      </Border>

      <GridSplitter Grid.Column="1"
                    Classes="layoutSplitter"
                    Width="6"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"/>

      <Grid Grid.Column="2" MinWidth="480" local:XYDiagnostic.AreaId="XYE.AREA.CENTER">
        <!-- F3：去除深色粗框与大 Padding——视口贴合，最多 1 DIP 浅灰分隔（D3：色值 Token 化 Color.Border.Default） -->
        <Border BorderBrush="{StaticResource Color.Border.Default}" BorderThickness="1" ClipToBounds="True">
          <local:Main />
        </Border>
        <!-- F3-F1：导航 Gizmo 已移入 Vulkan Overlay Pass（原生子窗口 airspace 遮挡 Avalonia 覆盖层，命中走原生指针流） -->
      </Grid>

      <GridSplitter Grid.Column="3"
                    Classes="layoutSplitter"
                    Width="6"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"/>

      <Border Grid.Column="4" Classes="panel" Padding="8" MinWidth="300" MaxWidth="480">
        <local:Right local:XYDiagnostic.AreaId="XYE.AREA.RIGHT" />
      </Border>
    </Grid>

    <GridSplitter Grid.Row="2"
                  Classes="layoutSplitter"
                  Height="6"
                  HorizontalAlignment="Stretch"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"/>

    <Border Grid.Row="3" Classes="panel" Padding="8,2" MinHeight="32" MaxHeight="420"><local:Foot local:XYDiagnostic.AreaId="XYE.AREA.BOTTOM"/></Border>
  </Grid>
</UserControl>
