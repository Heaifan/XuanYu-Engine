<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.UiRoot"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <Style Selector="GridSplitter.layoutSplitter">
      <Setter Property="Background" Value="#dce4ef"/>
    </Style>
    <Style Selector="GridSplitter.layoutSplitter:pointerover">
      <Setter Property="Background" Value="#9fb5d6"/>
    </Style>
  </UserControl.Styles>

  <Grid x:Name="RootGrid" Margin="12" MinWidth="980">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="320"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto" MinHeight="32" MaxHeight="420"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Classes="panel" Padding="8,1">
      <local:Top />
    </Border>

    <Grid x:Name="MainLayoutGrid" Grid.Row="1" Margin="0,6,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" MinWidth="200" MaxWidth="420"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*" MinWidth="360"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="340" MinWidth="260" MaxWidth="480"/>
      </Grid.ColumnDefinitions>
      <Border Classes="panel" Padding="14" MinWidth="200" MaxWidth="420">
        <local:Left />
      </Border>

      <GridSplitter Grid.Column="1"
                    Classes="layoutSplitter"
                    Width="6"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"/>

      <Grid Grid.Column="2" MinWidth="360">
        <!-- F3：去除深色粗框与大 Padding——视口贴合，最多 1 DIP 浅灰分隔。 -->
        <Border BorderBrush="#C9D2DC" BorderThickness="1" ClipToBounds="True">
          <local:Main />
        </Border>
        <!-- F3-F1：导航 Gizmo 已移入 Vulkan Overlay Pass（原生子窗口 airspace 遮挡 Avalonia 覆盖层，命中走原生指针流） -->
      </Grid>

      <GridSplitter Grid.Column="3"
                    Classes="layoutSplitter"
                    Width="6"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"/>

      <Border Grid.Column="4" Classes="panel" Padding="14" MinWidth="260" MaxWidth="480">
        <local:Right />
      </Border>
    </Grid>

    <GridSplitter Grid.Row="2"
                  Classes="layoutSplitter"
                  Height="6"
                  HorizontalAlignment="Stretch"
                  ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext"/>

    <Border Grid.Row="3" Classes="panel" Padding="8,2" MinHeight="32" MaxHeight="420">
      <local:Foot />
    </Border>
  </Grid>
</UserControl>
