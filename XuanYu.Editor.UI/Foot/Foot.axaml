<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.Foot"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <Style Selector="Button.logSummary">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.logSummary:pointerover">
      <Setter Property="Background" Value="#eef5ff"/>
      <Setter Property="BorderBrush" Value="#c9d9ec"/>
    </Style>
    <Style Selector="ListBox.logList ListBoxItem">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" MinHeight="28">
      <Button Classes="logSummary" Command="{Binding ToggleLogCommand}">
        <TextBlock Text="{Binding LogSummary}" VerticalAlignment="Center"/>
      </Button>
      <TextBlock Grid.Column="1" Text="{Binding FooterMode}" VerticalAlignment="Center" Foreground="#50607a"/>
      <TextBlock Grid.Column="2" Text="{Binding FooterState}" VerticalAlignment="Center" Foreground="#2e7d32" FontWeight="SemiBold"/>
    </Grid>

    <Border Grid.Row="1" IsVisible="{Binding IsLogOpen}" Height="200" Margin="0,8,0,0" BorderBrush="#d9e2ee" BorderThickness="1" CornerRadius="6" Background="#f8fbff" Padding="8">
      <TabControl Classes="sideTabs">
        <TabItem Classes="sideTab" Header="日志"><ListBox Classes="logList" ItemsSource="{Binding LogItems}" Background="Transparent" BorderThickness="0" Margin="0,6,0,0"/></TabItem>
        <TabItem Classes="sideTab" Header="问题"><ListBox Classes="logList" ItemsSource="{Binding ProblemItems}" Background="Transparent" BorderThickness="0" Margin="0,6,0,0"/></TabItem>
        <TabItem Classes="sideTab" Header="构建"><ListBox Classes="logList" ItemsSource="{Binding BuildItems}" Background="Transparent" BorderThickness="0" Margin="0,6,0,0"/></TabItem>
        <TabItem Classes="sideTab" Header="任务"><ListBox Classes="logList" ItemsSource="{Binding TaskItems}" Background="Transparent" BorderThickness="0" Margin="0,6,0,0"/></TabItem>
      </TabControl>
    </Border>
  </Grid>
</UserControl>
