<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:XuanYu.Editor.UI" xmlns:av="using:Avalonia.Controls" xmlns:xy="using:XYUI.Avalonia.Controls" x:Class="XuanYu.Editor.UI.Foot" x:DataType="local:UiVm">
  <UserControl.Styles>
    <StyleInclude Source="avares://XuanYu.Editor.UI/Foot/Foot.States.axaml"/>
    <Style Selector="xy|XYToggleButton.logFilter"><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="0"/></Style>
    <Style Selector="ListBox.logList ListBoxItem"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6" MinHeight="32" AutomationProperties.Name="展开或折叠日志">
      <xy:XYHeading Text="日志" Variant="PanelTitle"/><xy:XYStatusBadge Grid.Column="1" Text="正常"/>
      <xy:XYToggleButton Grid.Column="2" Classes="logFilter" IsChecked="{Binding IsLogFilterAll}" Command="{Binding SelectLogFilterCommand}" CommandParameter="全部" Content="{Binding AllCount, StringFormat='全部 {0}'}" AutomationProperties.Name="筛选全部日志"/>
      <xy:XYToggleButton Grid.Column="3" Classes="logFilter" IsChecked="{Binding IsLogFilterInfo}" Command="{Binding SelectLogFilterCommand}" CommandParameter="信息" Content="{Binding InfoCount, StringFormat='信息 {0}'}" AutomationProperties.Name="筛选信息日志"/>
      <xy:XYToggleButton Grid.Column="4" Classes="logFilter" IsChecked="{Binding IsLogFilterWarning}" Command="{Binding SelectLogFilterCommand}" CommandParameter="警告" Content="{Binding WarningCount, StringFormat='警告 {0}'}" AutomationProperties.Name="筛选警告日志"/>
      <xy:XYToggleButton Grid.Column="5" Classes="logFilter" IsChecked="{Binding IsLogFilterError}" Command="{Binding SelectLogFilterCommand}" CommandParameter="错误" Content="{Binding ErrorCount, StringFormat='错误 {0}'}" AutomationProperties.Name="筛选错误日志"/>
      <xy:XYButton x:Name="SourceFilterButton" Grid.Column="6" Content="{Binding LogSourceFilterText}" Click="SourceFilter_Click" AutomationProperties.Name="打开日志来源筛选"/>
      <Popup x:Name="SourceFilterPopup" Placement="Bottom" IsLightDismissEnabled="True"><xy:XYMenu x:Name="SourceMenu"/></Popup>
      <xy:XYSearchField x:Name="LogSearch" Grid.Column="7" Text="{Binding LogSearchText, Mode=TwoWay}" Placeholder="搜索日志…" MinWidth="150" Width="220" MaxWidth="280" AutomationProperties.Name="搜索日志"/>
      <xy:XYIconButton x:Name="ScrollToBottomButton" Grid.Column="8" IsVisible="False" Icon="ChevronDown" Click="ScrollToBottom_Click" ToolTip.Tip="回到底部" AutomationProperties.Name="回到底部"/>
      <xy:XYIconButton Grid.Column="9" Icon="Clear" Command="{Binding ClearLogsCommand}" ToolTip.Tip="清空日志" AutomationProperties.Name="清空日志"/>
      <xy:XYToggleButton Grid.Column="10" IsChecked="{Binding IsLogDetailsOpen}" Content="详情" ToolTip.Tip="显示或隐藏日志详情" AutomationProperties.Name="显示或隐藏日志详情"/>
    </Grid>
    <Border Grid.Row="1" IsVisible="{Binding IsLogOpen}" MinHeight="0" Margin="0,2,0,0" BorderBrush="{StaticResource Color.Border.Default}" BorderThickness="1" CornerRadius="0" Background="{StaticResource Color.Bg.Panel}" Padding="6">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="96,68,96,120,*" ColumnSpacing="10" Margin="0,0,0,4"><xy:XYLabel Text="时间"/><xy:XYLabel Grid.Column="1" Text="级别"/><xy:XYLabel Grid.Column="2" Text="来源"/><xy:XYLabel Grid.Column="3" Text="模块"/><xy:XYLabel Grid.Column="4" Text="消息"/></Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,300" ColumnSpacing="8">
          <Grid>
            <ListBox x:Name="LogList" Classes="logList" ItemsSource="{Binding LogItems}" SelectedItem="{Binding SelectedLogEntry}" SelectionMode="{x:Static av:SelectionMode.Multiple}" Background="Transparent" BorderThickness="0" SelectionChanged="LogList_SelectionChanged">
              <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Margin="0,0,0,12"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate x:DataType="local:LogEntry"><Grid ColumnDefinitions="3,96,68,96,120,*" ColumnSpacing="10"><Border Background="{Binding Accent}"/><xy:XYCodeText Grid.Column="1" Text="{Binding Time}"/><xy:XYStatusBadge Grid.Column="2" Text="{Binding LevelText}"/><xy:XYText Grid.Column="3" Text="{Binding SourceText}"/><xy:XYText Grid.Column="4" Text="{Binding ModuleText}"/><xy:XYTruncatedText Grid.Column="5" Mode="End" Text="{Binding Message}"/></Grid></DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding ShowInitialLogEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"><xy:XYEmptyText Text="暂无日志"/><xy:XYCaption Text="低频事实记录会显示在这里。"/></StackPanel>
            <StackPanel IsVisible="{Binding ShowNoFilterResults}" HorizontalAlignment="Center" VerticalAlignment="Center"><xy:XYEmptyText Text="没有匹配的日志"/><xy:XYButton Content="清空筛选" Command="{Binding SelectLogFilterCommand}" CommandParameter="清空筛选" AutomationProperties.Name="清空日志筛选"/></StackPanel>
          </Grid>
          <local:LogDetailPanel Grid.Column="1" IsVisible="{Binding IsLogDetailsOpen}"/>
        </Grid>
        <xy:XYCaption Grid.Row="2" Text="{Binding AllCount} 条日志" HorizontalAlignment="Right" Margin="0,4,0,0"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
