<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- UI Token 聚合入口（ARCH-UI-SPEC-R1-D2）：按职责合并全部 Token 文件，禁止直接修改本文件添加数值 -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://XuanYu.Editor.UI/Design/UiTokens.Fonts.axaml"/>
    <ResourceInclude Source="avares://XuanYu.Editor.UI/Design/UiTokens.Colors.Core.axaml"/>
    <ResourceInclude Source="avares://XuanYu.Editor.UI/Design/UiTokens.Colors.Components.axaml"/>
    <ResourceInclude Source="avares://XuanYu.Editor.UI/Design/UiTokens.Spacing.axaml"/>
    <ResourceInclude Source="avares://XuanYu.Editor.UI/Design/UiTokens.Controls.axaml"/>
    <ResourceInclude Source="avares://XuanYu.Editor.UI/Design/UiTokens.Icons.axaml"/>
    <ResourceInclude Source="avares://XuanYu.Editor.UI/Design/UiTokens.Motion.axaml"/>
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
