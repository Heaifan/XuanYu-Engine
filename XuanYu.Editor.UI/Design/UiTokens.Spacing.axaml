<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 间距主网格与受控半级（UI Spec 1.0 §5.1）：4/8/12/16/24/32 + 2/6 -->
  <x:Double x:Key="Space.2">2</x:Double>
  <x:Double x:Key="Space.4">4</x:Double>
  <x:Double x:Key="Space.6">6</x:Double>
  <x:Double x:Key="Space.8">8</x:Double>
  <x:Double x:Key="Space.12">12</x:Double>
  <x:Double x:Key="Space.16">16</x:Double>
  <x:Double x:Key="Space.24">24</x:Double>
  <x:Double x:Key="Space.32">32</x:Double>

  <!-- 内边距档位（UI Spec 1.0 §5.2） -->
  <Thickness x:Key="Padding.Compact">6,2</Thickness>
  <Thickness x:Key="Padding.Standard">8,4</Thickness>
  <Thickness x:Key="Padding.Relaxed">12,6</Thickness>

  <!-- 圆角（UI Spec 1.0 §5.4）：3 小 / 6 标准 / 10 大（10 仅欢迎页·启动器·游戏大容器） -->
  <CornerRadius x:Key="Radius.Small">3</CornerRadius>
  <CornerRadius x:Key="Radius.Standard">6</CornerRadius>
  <CornerRadius x:Key="Radius.Large">10</CornerRadius>
</ResourceDictionary>
