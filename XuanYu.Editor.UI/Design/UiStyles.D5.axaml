<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ARCH-UI-SPEC-R1-D5：按钮与表单状态样式（全部正式 Token，无新增 Token）。
       D5-FIX-01：按钮内容统一水平垂直居中（禁止逐按钮 Margin 偏移修补）。
       焦点态：官方 FocusAdorner（2 DIP 焦点框 + 1 DIP 外偏移，基于 Color.Focus，非新增 Token）。 -->
  <Style Selector="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{StaticResource Color.Hover.Bg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Strong}"/>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{StaticResource Color.Hover.Bg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.Accent}"/>
  </Style>
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource Color.Focus}"/>
    <!-- D5 纠偏：官方 FocusAdorner 焦点环（2 DIP 框 + 1 DIP 外偏移；不占布局、不改变控件尺寸、不裁切）。
         Setter 值必须是 Template（Avalonia 禁止 Control 直接作 Setter 值）。 -->
    <Setter Property="FocusAdorner">
      <Setter.Value>
        <Template>
          <Border Background="Transparent"
                  BorderBrush="{StaticResource Color.Focus}"
                  BorderThickness="2"
                  CornerRadius="{StaticResource Radius.Standard}"
                  Margin="-1"/>
        </Template>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- D5：视口与布局分隔器不是可操作按钮，不显示全局焦点装饰。 -->
  <Style Selector="GridSplitter.layoutSplitter:focus">
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
    <Setter Property="Background" Value="{StaticResource Color.Bg.Control}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/>
  </Style>
  <!-- 危险按钮：Danger 底 + 白字；hover/按下保持底色（边框加深），与普通按钮状态体系一致 -->
  <Style Selector="Button.uiDanger">
    <Setter Property="Background" Value="{StaticResource Color.Danger}"/>
    <Setter Property="Foreground" Value="{StaticResource Color.Bg.Control}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.Danger}"/>
  </Style>
  <Style Selector="Button.uiDanger:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Strong}"/>
  </Style>
  <Style Selector="Button.uiDanger:pressed">
    <Setter Property="BorderBrush" Value="{StaticResource Color.Accent}"/>
  </Style>

  <!-- 表单输入状态：Normal/Hover/Focus/Disabled；错误与警告非仅颜色（边框+图标+文字） -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource Color.Bg.Control}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>
  <Style Selector="TextBox:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Strong}"/>
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{StaticResource Color.Focus}"/>
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
    <Setter Property="Background" Value="{StaticResource Color.Bg.Control}"/>
  </Style>
  <Style Selector="TextBox.error">
    <Setter Property="BorderBrush" Value="{StaticResource Color.Error}"/>
  </Style>
  <Style Selector="TextBox.warning">
    <Setter Property="BorderBrush" Value="{StaticResource Color.Warning}"/>
  </Style>
</Styles>
