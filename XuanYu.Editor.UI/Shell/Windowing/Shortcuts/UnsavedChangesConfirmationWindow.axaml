<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xy="using:XYUI.Avalonia.Controls"
        x:Class="XuanYu.Editor.UI.UnsavedChangesConfirmationWindow"
        Title="未保存的场景" Width="440" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Color.Bg.Application}"
        KeyDown="Window_KeyDown">
  <Border Background="{StaticResource Color.Bg.Control}"
          BorderBrush="{StaticResource Color.Border.Default}"
          BorderThickness="1" CornerRadius="6" Padding="24">
    <StackPanel Spacing="16">
      <xy:XYHeading Text="未保存的场景" Variant="PanelTitle"/>
      <xy:XYText Text="当前场景有未保存修改。继续关闭前请选择保存、放弃修改或取消。"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
        <xy:XYButton x:Name="DiscardButton" Content="不保存" Click="Discard_Click" Variant="Danger"/>
        <xy:XYButton x:Name="CancelButton" Content="取消" Click="Cancel_Click" Variant="Secondary"/>
        <xy:XYButton x:Name="SaveButton" Content="保存" Click="Save_Click" Variant="Primary"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
