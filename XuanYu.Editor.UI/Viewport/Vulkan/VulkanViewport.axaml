<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.VulkanViewport">
  <Grid>
    <Border CornerRadius="6" Background="#0b1220" BorderBrush="#31405d" BorderThickness="1">
      <local:VulkanNativeHost/>
    </Border>
    <Border x:Name="FallbackLayer" Background="#cc0b1220" CornerRadius="6"
            Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="6" MaxWidth="360">
        <TextBlock Text="渲染视口" Foreground="#dbeafe" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="FallbackText" Text="正在初始化渲染后端..." Foreground="#9fb6d8" TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>
    </Border>
    <!-- EDITOR-VIEW-R1：右上角视角 Gizmo（屏幕空间覆盖层，不参与渲染交互） -->
    <local:ViewGizmo IsHitTestVisible="True"/>
  </Grid>
</UserControl>
