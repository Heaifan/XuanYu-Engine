<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.VulkanViewport">
  <Grid>
    <!-- F3：去除黑色粗边框与圆角卡片——Vulkan 画面贴合视口；最多保留 1 DIP 浅灰分隔。 -->
    <Border BorderBrush="#C9D2DC" BorderThickness="1" ClipToBounds="True">
      <local:VulkanNativeHost/>
    </Border>
    <Border x:Name="FallbackLayer" Background="#E8EEF5"
            Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="6" MaxWidth="360">
        <TextBlock Text="渲染视口" Foreground="#4A5A70" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="FallbackText" Text="正在初始化渲染后端..." Foreground="#6B7688" TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
