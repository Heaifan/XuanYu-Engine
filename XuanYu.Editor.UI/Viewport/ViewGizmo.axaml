<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.ViewGizmo"
             x:DataType="local:UiVm">
  <!-- F3-D2：Blender 风格导航 Gizmo——透明覆盖层，无白色底板/无圆角卡片。
       位置：视口右上角 12 DIP；88×88；仅球、轴、端点与标签可见。 -->
  <local:ViewNavigationGizmo HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,12,12,0"
                             NavigationCamera="{Binding NavigationCamera}"/>
</UserControl>
