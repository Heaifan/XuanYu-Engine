<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.MapPagePanel"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <!-- ARCH-UI-SPEC-R1-D4/D4-F1：只读资产摘要标签列 72（组件级例外 72~80）；值统一单行省略 -->
    <Style Selector="Border.groupSeparator">
      <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Margin" Value="0,2,0,6"/>
    </Style>
    <Style Selector="Grid.summaryRow">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style Selector="Button.copyBtn">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="ToggleButton.mapTool">
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,4"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
      <Setter Property="Background" Value="{StaticResource Color.Bg.Control}"/><Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/>
    </Style>
    <Style Selector="ToggleButton.mapTool:pointerover"><Setter Property="Background" Value="{StaticResource Color.Hover.Bg}"/><Setter Property="BorderBrush" Value="{StaticResource Color.Border.Strong}"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/></Style>
    <Style Selector="ToggleButton.mapTool:checked"><Setter Property="Background" Value="{StaticResource Color.Selection.Bg}"/><Setter Property="BorderBrush" Value="{StaticResource Color.Accent}"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="ToggleButton.mapTool:checked:pointerover"><Setter Property="Background" Value="{StaticResource Color.Selection.Bg}"/><Setter Property="BorderBrush" Value="{StaticResource Color.Accent}"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/></Style>
    <Style Selector="ToggleButton.mapTool TextBlock.mapToolLabel"><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/></Style>
    <Style Selector="ToggleButton.mapTool:pointerover TextBlock.mapToolLabel,
                  ToggleButton.mapTool:checked TextBlock.mapToolLabel,
                  ToggleButton.mapTool:checked:pointerover TextBlock.mapToolLabel">
      <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
    </Style>
  </UserControl.Styles>

  <StackPanel x:Name="Root" Spacing="12" Margin="0,6,0,0">
    <StackPanel x:Name="MapToolSection" Spacing="4">
      <TextBlock Text="地图工具" Classes="uiSection"/>
      <Border Classes="groupSeparator"/>
      <ToggleButton x:Name="RegionDrawingTool" Classes="mapTool" IsChecked="{Binding IsRegionDrawingTool, Mode=OneWay}"
                    Command="{Binding SelectToolCommand}" CommandParameter="区域绘制"
                    AutomationProperties.Name="区域绘制"><TextBlock Classes="mapToolLabel" Text="区域绘制"/></ToggleButton>
    </StackPanel>
    <!-- 地图资产：只读紧凑摘要（72 标签列；始终单行双列，D4-F1 不随宽度上下拆行） -->
    <StackPanel x:Name="SummaryGroup" Spacing="2">
      <TextBlock Text="地图资产" Classes="uiSection"/>
      <Border Classes="groupSeparator"/>
      <Grid Classes="summaryRow" ColumnDefinitions="72,*" ColumnSpacing="8">
        <TextBlock Text="名称" Classes="uiLabel"/>
        <TextBlock Grid.Column="1" Text="{Binding MapName}" Classes="uiValue" ToolTip.Tip="{Binding MapName}"/>
      </Grid>
      <Grid Classes="summaryRow" ColumnDefinitions="72,*" ColumnSpacing="8">
        <TextBlock Text="路径" Classes="uiLabel"/>
        <TextBlock Grid.Column="1" Text="{Binding MapPathDisplay}" Classes="uiValue" ToolTip.Tip="{Binding MapPath}"/>
      </Grid>
      <Grid Classes="summaryRow" ColumnDefinitions="72,*" ColumnSpacing="8">
        <TextBlock Text="MapId" Classes="uiLabel"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding MapIdDisplay}" Classes="uiValue" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" MaxLines="1" ToolTip.Tip="{Binding MapIdText}"/>
          <Button Classes="copyBtn" Content="复制" Click="CopyMapId_Click" ToolTip.Tip="复制完整 MapId" AutomationProperties.Name="复制完整 MapId"/>
        </StackPanel>
      </Grid>
      <Grid Classes="summaryRow" ColumnDefinitions="72,*" ColumnSpacing="8">
        <TextBlock Text="尺寸" Classes="uiLabel"/>
        <TextBlock Grid.Column="1" Text="{Binding MapSizeText}" Classes="uiValue" ToolTip.Tip="{Binding MapSizeText}"/>
      </Grid>
      <Grid Classes="summaryRow" ColumnDefinitions="72,*" ColumnSpacing="8">
        <TextBlock Text="状态" Classes="uiLabel"/>
        <TextBlock Grid.Column="1" Text="{Binding MapStatusText}" Classes="uiValue" ToolTip.Tip="{Binding MapStatusText}"/>
      </Grid>
    </StackPanel>

    <local:MapFormPanel/>

    <!-- 地图资产操作按钮组（纠偏 v2）：真正的 2×2 等宽网格，按钮水平拉伸 -->
    <UniformGrid Columns="2" ColumnSpacing="6" RowSpacing="6">
      <Button Classes="uiTextButton" HorizontalAlignment="Stretch" MinWidth="0" MinHeight="28" Content="新建地图"
              Command="{Binding RunCommand}" CommandParameter="新建地图" AutomationProperties.Name="新建地图"/>
      <Button Classes="uiTextButton" HorizontalAlignment="Stretch" MinWidth="0" MinHeight="28" Content="打开地图"
              IsEnabled="False" ToolTip.Tip="地图持久化将在独立专项接入" AutomationProperties.Name="打开地图"/>
      <Button Classes="uiTextButton" HorizontalAlignment="Stretch" MinWidth="0" MinHeight="28" Content="保存地图"
              IsEnabled="False" ToolTip.Tip="地图持久化将在独立专项接入" AutomationProperties.Name="保存地图"/>
      <Button Classes="uiTextButton" HorizontalAlignment="Stretch" MinWidth="0" MinHeight="28" Content="聚焦地图"
              Command="{Binding RunCommand}" CommandParameter="聚焦地图" AutomationProperties.Name="聚焦地图"/>
    </UniformGrid>
  </StackPanel>
</UserControl>
