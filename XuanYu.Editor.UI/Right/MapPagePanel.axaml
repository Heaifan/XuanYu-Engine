<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.MapPagePanel"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <StyleInclude Source="avares://XuanYu.Editor.UI/Right/EditorCompactStyles.axaml"/>
    <!-- ARCH-UI-SPEC-R1-D4/D4-F1：只读资产摘要标签列 72（组件级例外 72~80）；值统一单行省略 -->
    <Style Selector="Grid.summaryRow">
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Margin" Value="0,3"/>
    </Style>
  </UserControl.Styles>

  <StackPanel x:Name="Root" Spacing="8">
    <local:MapFormPanel/>
    
    <Border Classes="inspectorRail"><xy:XYSectionTitle Text="地图资产"/></Border>
    <xy:XYSeparator Variant="Section"/>
    <StackPanel x:Name="SummaryGroup" Spacing="2">
      <Grid Classes="summaryRow" ColumnDefinitions="72,*" ColumnSpacing="8">
        <xy:XYLabel Text="名称" VerticalAlignment="Center"/>
        <xy:XYText Grid.Column="1" Text="{Binding MapName}" ToolTip.Tip="{Binding MapName}" VerticalAlignment="Center"/>
      </Grid>
      <Grid Classes="summaryRow" ColumnDefinitions="72,*" ColumnSpacing="8">
        <xy:XYLabel Text="路径" VerticalAlignment="Center"/>
        <xy:XYSelectableText Grid.Column="1" Text="{Binding MapPathDisplay}" Variant="Technical" ToolTip.Tip="{Binding MapPath}"/>
      </Grid>
      <Grid x:Name="MapIdRow" Classes="summaryRow" ColumnDefinitions="72,*" ColumnSpacing="8">
        <xy:XYLabel Text="ID" VerticalAlignment="Center"/>
        <xy:XYSelectableText Grid.Column="1" Text="{Binding MapIdDisplay}" Variant="Technical" ToolTip.Tip="{Binding MapIdText}"/>
      </Grid>
      <Grid Classes="summaryRow" ColumnDefinitions="72,*" ColumnSpacing="8">
        <xy:XYLabel Text="坐标系" VerticalAlignment="Center"/>
        <xy:XYText Grid.Column="1" Text="{Binding MapManifestCoordinateSystemText}" VerticalAlignment="Center"/>
      </Grid>
      <Grid Classes="summaryRow" ColumnDefinitions="72,*" ColumnSpacing="8">
        <xy:XYLabel Text="尺寸" VerticalAlignment="Center"/>
        <xy:XYText Grid.Column="1" Text="{Binding MapSizeText}" ToolTip.Tip="{Binding MapSizeText}" VerticalAlignment="Center"/>
      </Grid>
      <Grid Classes="summaryRow" ColumnDefinitions="72,*" ColumnSpacing="8">
        <xy:XYLabel Text="状态" VerticalAlignment="Center"/>
        <xy:XYText Grid.Column="1" Text="{Binding MapStatusText}" ToolTip.Tip="{Binding MapStatusText}" VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>

    <!-- 地图资产操作按钮组（纠偏 v2）：真正的 2×2 等宽网格，按钮水平拉伸 -->
    <UniformGrid Columns="2" ColumnSpacing="6" RowSpacing="6">
      <xy:XYButton Classes="uiTextButton" Variant="Secondary" HorizontalAlignment="Stretch" MinWidth="0" MinHeight="28" Content="新建地图"
              Command="{Binding RunCommand}" CommandParameter="新建地图" AutomationProperties.Name="新建地图"/>
      <xy:XYButton Classes="uiTextButton" Variant="Secondary" HorizontalAlignment="Stretch" MinWidth="0" MinHeight="28" Content="打开地图"
              Command="{Binding RunCommand}" CommandParameter="打开地图" AutomationProperties.Name="打开地图"/>
      <xy:XYButton Classes="uiTextButton" Variant="Secondary" HorizontalAlignment="Stretch" MinWidth="0" MinHeight="28" Content="保存地图"
              Command="{Binding RunCommand}" CommandParameter="保存地图" AutomationProperties.Name="保存地图"/>
      <xy:XYButton Classes="uiTextButton" Variant="Secondary" HorizontalAlignment="Stretch" MinWidth="0" MinHeight="28" Content="聚焦地图"
              Command="{Binding RunCommand}" CommandParameter="聚焦地图" AutomationProperties.Name="聚焦地图"/>
    </UniformGrid>
  </StackPanel>
</UserControl>
