<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI" x:Class="XuanYu.Editor.UI.DatasetPanel" x:DataType="local:UiVm">
  <UserControl.Styles>
    <Style Selector="Button.datasetRow"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="Border.datasetSelection"><Setter Property="Background" Value="{StaticResource Color.Selection.Bg}"/><Setter Property="BorderBrush" Value="{StaticResource Color.Accent}"/><Setter Property="BorderThickness" Value="2,0,0,0"/></Style>
    <Style Selector="TextBlock.datasetName"><Setter Property="FontSize" Value="{StaticResource Font.Body.Size}"/><Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="MaxLines" Value="1"/></Style>
    <Style Selector="TextBlock.datasetMeta"><Setter Property="FontSize" Value="{StaticResource Font.Meta.Size}"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Secondary}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="MaxLines" Value="1"/></Style>
  </UserControl.Styles>
  <StackPanel Spacing="8" Margin="0,6,0,0">
    <TextBlock Text="数据集" Classes="uiSection"/>
    <TextBlock Text="{Binding DatasetEmptyState}" Classes="uiMultiline" TextWrapping="Wrap" IsVisible="{Binding IsDatasetEmpty}"/>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBlock Text="数据集" Classes="uiLabel"/><TextBlock Grid.Column="1" Text="状态" Classes="uiLabel"/></Grid>
    <ListBox ItemsSource="{Binding DatasetItems}" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0">
      <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
      <ListBox.ItemTemplate><DataTemplate><Button Classes="datasetRow" Click="DatasetRow_Click">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <Border Classes="datasetSelection" Grid.ColumnSpan="2" IsVisible="{Binding IsSelected}"/>
          <StackPanel Spacing="1" ZIndex="1"><TextBlock Text="{Binding Name}" Classes="datasetName" ToolTip.Tip="{Binding Name}"/><TextBlock Text="{Binding TypeIdText}" Classes="datasetMeta" ToolTip.Tip="{Binding TypeIdText}"/></StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="uiValue" ZIndex="1"/>
        </Grid>
      </Button></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="数据集名称" Classes="uiLabel"/>
    <TextBox Text="{Binding DatasetNameText, Mode=TwoWay}" IsEnabled="{Binding HasSelectedDataset}"/>
    <Button Content="应用名称" Click="ApplyName_Click" IsEnabled="{Binding HasSelectedDataset}"/>
    <TextBlock Text="新建数据集" Classes="uiLabel"/>
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"><TextBlock Text="类型" Classes="uiLabel" VerticalAlignment="Center"/>
      <ComboBox Grid.Column="1" ItemsSource="{Binding DatasetTypeOptions}" SelectedItem="{Binding DatasetCreateTypeOption}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    </Grid>
    <Button Content="＋ 新建数据集" Command="{Binding RunCommand}" CommandParameter="新建数据集" AutomationProperties.Name="新建数据集"/>
    <TextBlock Text="危险操作" Classes="uiLabel" Margin="0,6,0,0"/>
    <Button Classes="uiDanger" Content="解除注册" Command="{Binding RunCommand}" CommandParameter="解除注册数据集" IsEnabled="{Binding CanUnregisterDataset}" AutomationProperties.Name="解除注册数据集"/>
  </StackPanel>
</UserControl>
