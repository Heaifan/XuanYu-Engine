<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.InspectorPanel"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <!-- ARCH-UI-SPEC-R1-D4-F1：检查器只读键值行——标签 80 / 值 * / 单行双列（无上下拆行） -->
    <Style Selector="Grid.fieldRow"><Setter Property="MinHeight" Value="28"/><Setter Property="Margin" Value="0,2"/></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="8" Margin="0,6,0,0">
    <Grid x:Name="EntityHeader" ColumnDefinitions="20,*" ColumnSpacing="8" IsVisible="{Binding !IsMapEditMode}">
      <xy:XYIcon Icon="Browse" Size="Small" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Spacing="1">
        <xy:XYHeading x:Name="EntityHeaderTitle" Text="{Binding InspectorSelectionTitle}" Variant="PanelTitle"/>
        <xy:XYCaption x:Name="EntityHeaderSubtitle" Text="{Binding InspectorSelectionSubtitle}"/>
      </StackPanel>
    </Grid>

    <StackPanel IsVisible="{Binding IsMapEditMode}">
      <local:MapEditorPanel x:Name="MapWorkspace" IsVisible="{Binding !IsEntityInspector}"/>
    </StackPanel>

    <local:LayerInspectorPanel IsVisible="{Binding HasCurrentLayerSelection}"/>

    <StackPanel IsVisible="{Binding IsRegionEditMode}" Spacing="6">
      <StackPanel IsVisible="{Binding !HasCurrentLayerSelection}">
      <xy:XYSectionTitle Text="区域属性"/>
      <xy:XYEmptyText Text="当前未选择区域"/>
      <xy:XYCaption Text="REGION-A 接入后显示正式属性" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>

    <local:EntityInspectorPanel IsVisible="{Binding IsEntityInspector}"/>

    <StackPanel IsVisible="{Binding HasInspectorSelection}" Spacing="4">
      <StackPanel IsVisible="{Binding !HasCurrentLayerSelection}">
      <StackPanel IsVisible="{Binding !IsEntityInspector}">
      <xy:XYSectionTitle Text="{Binding InspectorSectionTitle}"/>
      <xy:XYSeparator Variant="Section"/>
      <ItemsControl ItemsSource="{Binding InspectorFields}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:InspectorFieldRow">
            <StackPanel>
              <xy:XYSectionTitle Text="{Binding Label}" IsVisible="{Binding IsGroupHeader}" Margin="0,6,0,0"/>
              <Grid Classes="fieldRow" ColumnDefinitions="80,*" ColumnSpacing="8" IsVisible="{Binding !IsGroupHeader}">
                <xy:XYLabel Text="{Binding Label}"/>
                <xy:XYText Grid.Column="1" Text="{Binding Value}" ToolTip.Tip="{Binding Value}"
                           IsVisible="{Binding Label, Converter={x:Static local:InspectorPanel.IsStandardField}}"/>
                <xy:XYSelectableText Grid.Column="1" Text="{Binding Value}" Variant="Technical"
                                     ToolTip.Tip="{Binding Value}"
                                     IsVisible="{Binding Label, Converter={x:Static local:InspectorPanel.IsTechnicalField}}"/>
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
      </StackPanel>
    </StackPanel>

    <!-- IsEmptySelection remains the editor-entity baseline; Dataset selection refines this panel state. -->
    <Grid IsVisible="{Binding IsInspectorEmpty}" MinHeight="220">
      <Grid IsVisible="{Binding !IsMapEditMode}">
      <Grid IsVisible="{Binding !HasCurrentLayerSelection}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="220">
        <xy:XYText Text="—" HorizontalAlignment="Center"/>
        <xy:XYEmptyText Text="未选择对象" HorizontalAlignment="Center"/>
        <xy:XYCaption Text="选择场景对象后显示属性" HorizontalAlignment="Center"/>
      </StackPanel>
      </Grid>
      </Grid>
    </Grid>
  </StackPanel>
  </ScrollViewer>
  </Grid>
</UserControl>
