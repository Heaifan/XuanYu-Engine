<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             xmlns:xycore="using:XYUI.Avalonia"
             x:Class="XuanYu.Editor.UI.EditorRightTabs"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <Style Selector="Grid.debugRow"><Setter Property="MinHeight" Value="26"/><Setter Property="Margin" Value="0,1"/></Style>
    <Style Selector="ItemsControl.debugList"><Setter Property="Margin" Value="0"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <xy:XYTabs x:Name="SideTabs" Grid.Column="0" SelectionChanged="SideTabs_SelectionChanged"
                 xycore:XY.Size="Compact" xycore:XY.Density="Compact"
                 Height="{StaticResource Control.Height.Compact}" ClipToBounds="True">
        <xy:XYTab Id="inspector" Label="检查器" IsClosable="False" Height="{StaticResource Control.Height.Compact}"/>
        <xy:XYTab Id="hierarchy" Label="层级" IsClosable="False" Height="{StaticResource Control.Height.Compact}"/>
        <xy:XYTab Id="debug" Label="调试" IsClosable="False" Height="{StaticResource Control.Height.Compact}"/>
      </xy:XYTabs>
      <xy:XYIconButton x:Name="AllTabsButton" Grid.Column="1" Classes="right-tab-action"
                       Icon="ChevronDown" Click="AllTabsButton_Click" ToolTip.Tip="全部页签"
                       AutomationProperties.Name="全部页签"/>
    </Grid>
    <Grid Grid.Row="1">
      <local:InspectorPanel x:Name="InspectorWorkspace"/>
      <local:HierarchyWorkspace x:Name="HierarchyWorkspace" IsVisible="False"/>
      <ScrollViewer x:Name="DebugWorkspace" IsVisible="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="0,6,0,0">
          <StackPanel Spacing="4">
            <xy:XYSectionTitle Text="当前上下文"/>
            <ItemsControl Classes="debugList" ItemsSource="{Binding DebugContextItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:InspectorFieldRow">
                  <Grid Classes="debugRow" ColumnDefinitions="96,*" ColumnSpacing="8">
                    <xy:XYLabel Text="{Binding Label}"/>
                    <xy:XYText Grid.Column="1" Text="{Binding Value}" ToolTip.Tip="{Binding Value}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="4">
            <xy:XYSectionTitle Text="当前对象"/>
            <ItemsControl Classes="debugList" ItemsSource="{Binding DebugObjectItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:InspectorFieldRow">
                  <Grid Classes="debugRow" ColumnDefinitions="96,*" ColumnSpacing="8">
                    <xy:XYLabel Text="{Binding Label}"/>
                    <xy:XYText Grid.Column="1" Text="{Binding Value}" ToolTip.Tip="{Binding Value}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="6">
            <xy:XYSectionTitle Text="交互事务"/>
            <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
              <xy:XYLabel Text="阶段"/>
              <xy:XYText Grid.Column="1" Text="{Binding InteractionPhase}" ToolTip.Tip="{Binding InteractionPhase}"/>
              <xy:XYLabel Grid.Row="1" Text="Owner"/>
              <xy:XYText Grid.Row="1" Grid.Column="1" Text="{Binding InteractionOwner}" ToolTip.Tip="{Binding InteractionOwner}"/>
              <xy:XYLabel Grid.Row="2" Text="Preview"/>
              <xy:XYText Grid.Row="2" Grid.Column="1" Text="{Binding InteractionPreview}" ToolTip.Tip="{Binding InteractionPreview}"/>
            </Grid>
            <UniformGrid Columns="4" ColumnSpacing="6" RowSpacing="6">
              <xy:XYButton Classes="uiTextButton" Variant="Secondary" Content="开始" Command="{Binding InteractionCommand}" CommandParameter="Begin"/>
              <xy:XYButton Classes="uiTextButton" Variant="Secondary" Content="预览" Command="{Binding InteractionCommand}" CommandParameter="Preview"/>
              <xy:XYButton Classes="uiTextButton" Variant="Secondary" Content="提交" Command="{Binding InteractionCommand}" CommandParameter="Commit"/>
              <xy:XYButton Classes="uiTextButton" Variant="Secondary" Content="取消" Command="{Binding InteractionCommand}" CommandParameter="Cancel"/>
            </UniformGrid>
          </StackPanel>
          <StackPanel Spacing="4">
            <xy:XYSectionTitle Text="输入状态"/>
            <ItemsControl Classes="debugList" ItemsSource="{Binding DebugInputItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:InspectorFieldRow">
                  <Grid Classes="debugRow" ColumnDefinitions="96,*" ColumnSpacing="8">
                    <xy:XYLabel Text="{Binding Label}"/>
                    <xy:XYText Grid.Column="1" Text="{Binding Value}" ToolTip.Tip="{Binding Value}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
