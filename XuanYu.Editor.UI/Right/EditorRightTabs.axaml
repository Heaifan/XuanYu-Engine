<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.EditorRightTabs"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.debugSeparator"><Setter Property="BorderBrush" Value="{DynamicResource XY.Brush.Border.Color.Default}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Margin" Value="0,2,0,6"/></Style>
    <Style Selector="Grid.debugRow"><Setter Property="MinHeight" Value="26"/><Setter Property="Margin" Value="0,1"/></Style>
    <Style Selector="ItemsControl.debugList"><Setter Property="Margin" Value="0"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <!-- Tabs will be added in code-behind -->
    <Decorator x:Name="TabsContainer" Margin="0,0,0,8" />

    <Grid Grid.Row="1" x:Name="ViewsContainer">
      <local:InspectorPanel x:Name="View0" />
      <ScrollViewer x:Name="View1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="0,6,0,0">
          <StackPanel Spacing="4"><xy:XYSectionTitle Text="当前上下文"/><Border Classes="debugSeparator"/><ItemsControl Classes="debugList" ItemsSource="{Binding DebugContextItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:InspectorFieldRow"><Grid Classes="debugRow" ColumnDefinitions="96,*" ColumnSpacing="8"><TextBlock Text="{Binding Label}" Classes="uiLabel"/><TextBlock Grid.Column="1" Text="{Binding Value}" Classes="uiValue" ToolTip.Tip="{Binding Value}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
          <StackPanel Spacing="4"><xy:XYSectionTitle Text="当前对象"/><Border Classes="debugSeparator"/><ItemsControl Classes="debugList" ItemsSource="{Binding DebugObjectItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:InspectorFieldRow"><Grid Classes="debugRow" ColumnDefinitions="96,*" ColumnSpacing="8"><TextBlock Text="{Binding Label}" Classes="uiLabel"/><TextBlock Grid.Column="1" Text="{Binding Value}" Classes="uiValue" ToolTip.Tip="{Binding Value}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
          <StackPanel Spacing="6"><xy:XYSectionTitle Text="交互事务"/><Border Classes="debugSeparator"/><Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4"><TextBlock Text="阶段" Classes="uiLabel"/><TextBlock Grid.Column="1" Text="{Binding InteractionPhase}" Classes="uiValue" ToolTip.Tip="{Binding InteractionPhase}"/><TextBlock Grid.Row="1" Text="Owner" Classes="uiLabel"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InteractionOwner}" Classes="uiValue" ToolTip.Tip="{Binding InteractionOwner}"/><TextBlock Grid.Row="2" Text="Preview" Classes="uiLabel"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InteractionPreview}" Classes="uiValue" ToolTip.Tip="{Binding InteractionPreview}"/></Grid><UniformGrid Columns="4" ColumnSpacing="6" RowSpacing="6"><xy:XYButton Classes="xyui-button" Content="开始" Command="{Binding InteractionCommand}" CommandParameter="Begin"/><xy:XYButton Classes="xyui-button" Content="预览" Command="{Binding InteractionCommand}" CommandParameter="Preview"/><xy:XYButton Classes="xyui-button" Content="提交" Command="{Binding InteractionCommand}" CommandParameter="Commit"/><xy:XYButton Classes="xyui-button" Content="取消" Command="{Binding InteractionCommand}" CommandParameter="Cancel"/></UniformGrid></StackPanel>
          <StackPanel Spacing="4"><xy:XYSectionTitle Text="输入状态"/><Border Classes="debugSeparator"/><ItemsControl Classes="debugList" ItemsSource="{Binding DebugInputItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:InspectorFieldRow"><Grid Classes="debugRow" ColumnDefinitions="96,*" ColumnSpacing="8"><TextBlock Text="{Binding Label}" Classes="uiLabel"/><TextBlock Grid.Column="1" Text="{Binding Value}" Classes="uiValue" ToolTip.Tip="{Binding Value}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
