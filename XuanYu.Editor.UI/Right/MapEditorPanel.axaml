<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             xmlns:xycore="using:XYUI.Avalonia"
             x:Class="XuanYu.Editor.UI.MapEditorPanel"
             local:XYDiagnostic.DebugId="XYE.INSPECTOR.MAP"
             Classes="compactEditor"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <StyleInclude Source="avares://XuanYu.Editor.UI/Right/EditorCompactStyles.axaml"/>
  </UserControl.Styles>
  <StackPanel Spacing="8" Margin="0,6,0,0">
    <xy:XYToggleButton Content="基础" IsChecked="{Binding IsInspectorBasicExpanded}" Command="{Binding ToggleInspectorSectionCommand}" CommandParameter="Basic" HorizontalAlignment="Stretch"/>
    <StackPanel IsVisible="{Binding IsInspectorBasicExpanded}"><local:MapPagePanel/></StackPanel>
    <xy:XYToggleButton Content="地图资产" IsChecked="{Binding IsInspectorAssetsExpanded}" Command="{Binding ToggleInspectorSectionCommand}" CommandParameter="Assets" HorizontalAlignment="Stretch"/>
    <StackPanel IsVisible="{Binding IsInspectorAssetsExpanded}"><local:DatasetPanel/></StackPanel>
    <xy:XYToggleButton Content="环境" IsChecked="{Binding IsInspectorEnvironmentExpanded}" Command="{Binding ToggleInspectorSectionCommand}" CommandParameter="Environment" HorizontalAlignment="Stretch"/>
    <StackPanel IsVisible="{Binding IsInspectorEnvironmentExpanded}" Spacing="4">
      <xy:XYSectionTitle Text="地图环境"/>
      <xy:XYCaption Text="天空、雾效与环境光属性将在后续阶段补齐。" TextWrapping="Wrap"/>
    </StackPanel>
  </StackPanel>
</UserControl>
