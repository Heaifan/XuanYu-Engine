<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             xmlns:xycore="using:XYUI.Avalonia"
             x:Class="XuanYu.Editor.UI.MapEditorPanel"
             x:DataType="local:UiVm">
  <Grid RowDefinitions="Auto,*">
    <xy:XYTabBar x:Name="MapTabs"
                 xycore:XY.Size="Compact"
                 xycore:XY.Density="Compact"
                 Height="{StaticResource Control.Height.Compact}"
                 ClipToBounds="True"
                 Grid.Row="0"
                 Margin="0"
                 SelectionChanged="MapTabs_SelectionChanged">
      <xy:XYTab Id="base" Label="地图基础" ShowSelectedAccent="False"/>
      <xy:XYTab Id="environment" Label="地图环境" ShowSelectedAccent="False"/>
      <xy:XYTab Id="dataset" Label="数据集" ShowSelectedAccent="False"/>
    </xy:XYTabBar>
    <Grid Grid.Row="1">
      <ScrollViewer x:Name="MapPageHost" VerticalScrollBarVisibility="Auto">
        <local:MapPagePanel/>
      </ScrollViewer>
      <ScrollViewer x:Name="EnvironmentHost" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="0,6,0,0">
          <xy:XYSectionTitle Text="地图环境"/>
          <xy:XYCaption Text="天空预设 / 天顶颜色 / 地平线颜色 / 太阳方向 / 太阳强度 / 环境光强度编辑将在 D5 后续补齐。" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
      <local:DatasetPanel x:Name="DatasetHost"/>
    </Grid>
  </Grid>
</UserControl>
