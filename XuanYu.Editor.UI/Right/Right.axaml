<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.Right"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Right/TopTabStripTemplate.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- ARCH-UI-SPEC-R1-D3（W43/G01）：顶层页签单行溢出宿主模板（箭头/渐隐/滚轮/全部页签/一次性提示） -->
    <Style Selector="TabControl.sideTabs">
      <Setter Property="Template" Value="{StaticResource TopTabStripTemplate}"/>
    </Style>
    <!-- ARCH-UI-SPEC-R1-D4（W44）：调试页标签列 96；字段字号 Token 化 -->
    <Style Selector="Border.debugSeparator"><Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Margin" Value="0,2,0,6"/></Style>
    <Style Selector="TextBlock.key"><Setter Property="FontSize" Value="{StaticResource Font.Label.Size}"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Secondary}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="TextBlock.value"><Setter Property="FontSize" Value="{StaticResource Font.Body.Size}"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </UserControl.Styles>

  <TabControl x:Name="SideTabs" Classes="sideTabs">
    <TabItem Classes="sideTab" Header="检查器">
      <local:InspectorPanel/>
    </TabItem>

    <!-- MAP-A-R1-D5-A：正式地图编辑器（与检查器平级的一级模块） -->
    <TabItem Classes="sideTab" Header="地图编辑器">
      <local:MapEditorPanel/>
    </TabItem>

    <TabItem Classes="sideTab" Header="调试">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="0,6,0,0">
          <StackPanel Spacing="4"><TextBlock Text="当前上下文" Classes="section"/><Border Classes="debugSeparator"/><ListBox ItemsSource="{Binding DebugContextItems}" Background="Transparent" BorderThickness="0"/></StackPanel>
          <StackPanel Spacing="4"><TextBlock Text="当前对象" Classes="section"/><Border Classes="debugSeparator"/><ListBox ItemsSource="{Binding DebugObjectItems}" Background="Transparent" BorderThickness="0"/></StackPanel>
          <StackPanel Spacing="6"><TextBlock Text="交互事务" Classes="section"/><Border Classes="debugSeparator"/><Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4"><TextBlock Text="阶段" Classes="key"/><TextBlock Grid.Column="1" Text="{Binding InteractionPhase}" Classes="value"/><TextBlock Grid.Row="1" Text="Owner" Classes="key"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InteractionOwner}" Classes="value"/><TextBlock Grid.Row="2" Text="Preview" Classes="key"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InteractionPreview}" Classes="value"/></Grid><UniformGrid Columns="4"><Button Content="开始" Command="{Binding InteractionCommand}" CommandParameter="Begin"/><Button Content="预览" Command="{Binding InteractionCommand}" CommandParameter="Preview"/><Button Content="提交" Command="{Binding InteractionCommand}" CommandParameter="Commit"/><Button Content="取消" Command="{Binding InteractionCommand}" CommandParameter="Cancel"/></UniformGrid></StackPanel>
          <StackPanel Spacing="4"><TextBlock Text="输入状态" Classes="section"/><Border Classes="debugSeparator"/><ListBox ItemsSource="{Binding DebugInputItems}" Background="Transparent" BorderThickness="0"/></StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
