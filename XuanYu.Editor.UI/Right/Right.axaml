<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.Right"
             x:DataType="local:UiVm">
  <TabControl>
    <TabItem Header="检查器">
      <StackPanel Spacing="10" Margin="0,8,0,0">
        <TextBlock Text="当前选择" Classes="section"/>
        <TextBlock Text="{Binding SelectionTitle}" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SelectionSubtitle}" Classes="muted"/>
        <Separator/>
        <TextBlock Text="属性字段" Classes="section"/>
        <ListBox ItemsSource="{Binding InspectorFields}" Background="Transparent" BorderThickness="0"/>
      </StackPanel>
    </TabItem>
    <TabItem Header="调试">
      <StackPanel Spacing="10" Margin="0,8,0,0">
        <TextBlock Text="外壳状态" Classes="section"/>
        <ListBox ItemsSource="{Binding DebugItems}" Background="Transparent" BorderThickness="0"/>
      </StackPanel>
    </TabItem>
    <TabItem Header="偏好">
      <StackPanel Spacing="10" Margin="0,8,0,0">
        <TextBlock Text="工作区" Classes="section"/>
        <TextBlock Text="后续在这里放布局保存、主题、快捷键和编辑器偏好。" Classes="muted" TextWrapping="Wrap"/>
        <ListBox ItemsSource="{Binding PropertyItems}" Background="Transparent" BorderThickness="0"/>
      </StackPanel>
    </TabItem>
    <TabItem Header="模式">
      <StackPanel Spacing="10" Margin="0,8,0,0">
        <TextBlock Text="当前模式" Classes="section"/>
        <TextBlock Text="{Binding ActiveModeTitle}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding FooterMessage}" Classes="muted" TextWrapping="Wrap"/>
      </StackPanel>
    </TabItem>
  </TabControl>
</UserControl>
