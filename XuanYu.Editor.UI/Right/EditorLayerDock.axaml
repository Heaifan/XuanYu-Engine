<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.EditorLayerDock"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <Style Selector="Border.layerDockHeader">
      <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
      <Setter Property="Padding" Value="8,0,0,0"/>
      <Setter Property="Margin" Value="0,8,0,4"/>
    </Style>
  </UserControl.Styles>
  <Grid x:Name="Root" RowDefinitions="Auto,*" MinHeight="260">
    <Border Classes="layerDockHeader">
      <Grid ColumnDefinitions="*,Auto">
        <xy:XYSectionTitle Text="{Binding CurrentLayerEmptyTitle}" VerticalAlignment="Center"/>
        <xy:XYButton x:Name="CollapseButton" Grid.Column="1" Content="收起" Click="CollapseButton_Click" Variant="Secondary" Padding="8,2" MinHeight="0" MinWidth="0" HorizontalAlignment="Right"/>
      </Grid>
    </Border>
    <Grid x:Name="LayerContent" Grid.Row="1">
      <local:LayerPanel IsVisible="{Binding HasCurrentLayerItems}"/>
      <StackPanel IsVisible="{Binding !HasCurrentLayerItems}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240" Spacing="6">
        <xy:XYEmptyText Text="{Binding CurrentLayerEmptyTitle}"/>
        <xy:XYCaption Text="{Binding CurrentLayerEmptyMessage}" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
