<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.RegionalAuthoringPanel"
             Classes="compactEditor"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <StyleInclude Source="avares://XuanYu.Editor.UI/Right/EditorCompactStyles.axaml"/>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="6" Margin="2,8,2,0">
      <xy:XYSectionTitle Text="内容类型"/>
      <xy:XYTabBar x:Name="AuthoringTabs" SizingMode="Content" SelectionChanged="AuthoringTabs_SelectionChanged">
        <xy:XYTab Id="region" Label="区域面" IsClosable="False" ShowSelectedAccent="False"/>
        <xy:XYTab Id="road" Label="道路" IsClosable="False" ShowSelectedAccent="False"/>
        <xy:XYTab Id="marker" Label="地图标记" IsClosable="False" ShowSelectedAccent="False"/>
      </xy:XYTabBar>
    </StackPanel>
    <Grid Grid.Row="1">
      <local:RegionPanel IsVisible="{Binding IsRegionSurfaceAuthoringMode}"/>
      <local:RoadPanel IsVisible="{Binding IsRoadAuthoringMode}"/>
      <local:MarkerPanel IsVisible="{Binding IsMarkerAuthoringMode}"/>
    </Grid>
  </Grid>
</UserControl>
