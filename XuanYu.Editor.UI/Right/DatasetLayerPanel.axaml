<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI" x:Class="XuanYu.Editor.UI.DatasetLayerPanel" x:DataType="local:UiVm">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.datasetLayerRow"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="4,5"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style Selector="Border.datasetLayerSelection"><Setter Property="Background" Value="{StaticResource Color.Selection.Bg}"/><Setter Property="BorderBrush" Value="{StaticResource Color.Accent}"/><Setter Property="BorderThickness" Value="2,0,0,0"/></Style>
    <Style Selector="Button.datasetLayerAction"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="4"/></Style>
    <Style Selector="Path.datasetLayerIcon"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{StaticResource Color.Text.Secondary}"/><Setter Property="StrokeThickness" Value="{StaticResource Icon.Stroke.Width}"/><Setter Property="Fill" Value="Transparent"/></Style>
    <Style Selector="Path.dragHandleIcon"><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Fill" Value="{StaticResource Color.Text.Disabled}"/></Style>
    <Style Selector="TextBlock.datasetLayerName"><Setter Property="FontSize" Value="{StaticResource Font.Body.Size}"/><Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="MaxLines" Value="1"/></Style>
    <Style Selector="TextBlock.datasetLayerMeta"><Setter Property="FontSize" Value="{StaticResource Font.Meta.Size}"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Secondary}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="MaxLines" Value="1"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Margin="0,4,0,0" HorizontalAlignment="Stretch">
    <TextBlock Grid.Row="0" Text="{Binding DatasetLayerEmptyState}" Classes="uiMultiline" TextWrapping="Wrap" IsVisible="{Binding IsDatasetEmpty}"/>
    <ListBox Grid.Row="1" x:Name="DatasetLayerList" ItemsSource="{Binding DatasetLayerItems}" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" IsVisible="{Binding !IsDatasetEmpty}">
      <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
      <ListBox.ItemTemplate><DataTemplate><Border x:Name="DatasetLayerRow" Classes="datasetLayerRow" PointerPressed="DatasetRow_Pressed">
        <Grid ColumnDefinitions="24,28,28,*,Auto" ColumnSpacing="6" HorizontalAlignment="Stretch">
          <Border Classes="datasetLayerSelection" Grid.ColumnSpan="5" IsVisible="{Binding IsSelected}"/>
          <Border x:Name="DropLine" Height="2" Background="{StaticResource Layer.DropLine}" Grid.ColumnSpan="5" VerticalAlignment="Top" IsVisible="False" ZIndex="2"/>
          <Border Grid.Column="0" Width="24" Height="28" Background="Transparent" PointerPressed="DragHandle_PointerPressed" ZIndex="1" ToolTip.Tip="拖动调整顺序"><Path Classes="dragHandleIcon" Data="{StaticResource DragHandleIcon}"/></Border>
          <Button Grid.Column="1" Classes="datasetLayerAction" Click="Visibility_Click" PointerPressed="DatasetAction_PointerPressed" ZIndex="1" ToolTip.Tip="显示或隐藏"><StackPanel><Path Classes="datasetLayerIcon" Data="{StaticResource VisibleIcon}" IsVisible="{Binding IsVisible}"/><Path Classes="datasetLayerIcon" Data="{StaticResource HiddenIcon}" IsVisible="{Binding !IsVisible}"/></StackPanel></Button>
          <Button Grid.Column="2" Classes="datasetLayerAction" Click="Lock_Click" PointerPressed="DatasetAction_PointerPressed" ZIndex="1" ToolTip.Tip="锁定或解锁"><StackPanel><Path Classes="datasetLayerIcon" Data="{StaticResource LockedIcon}" IsVisible="{Binding IsLocked}"/><Path Classes="datasetLayerIcon" Data="{StaticResource UnlockedIcon}" IsVisible="{Binding !IsLocked}"/></StackPanel></Button>
          <StackPanel Grid.Column="3" Spacing="1" ZIndex="1"><TextBlock Text="{Binding Name}" Classes="datasetLayerName" ToolTip.Tip="{Binding Name}"/><TextBlock Text="{Binding TypeIdText}" Classes="datasetLayerMeta" ToolTip.Tip="{Binding TypeIdText}"/></StackPanel>
          <TextBlock Grid.Column="4" Text="{Binding Status}" Classes="uiValue" ZIndex="1"/>
        </Grid>
      </Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
