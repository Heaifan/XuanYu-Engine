<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI" x:Class="XuanYu.Editor.UI.DatasetLayerPanel" x:DataType="local:UiVm">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <UserControl.Styles>
    <StyleInclude Source="avares://XuanYu.Editor.UI/Right/LayerPanel.States.axaml"/>
    <Style Selector="Border.datasetLayerRow"><Setter Property="Height" Value="{StaticResource Control.Height.Emphasized}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="4,0"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style Selector="Border.datasetLayerSelection"><Setter Property="Background" Value="{StaticResource Color.Selection.Bg}"/><Setter Property="BorderBrush" Value="{StaticResource Color.Accent}"/><Setter Property="BorderThickness" Value="2,0,0,0"/></Style>
    <Style Selector="Path.layerIcon"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="StrokeThickness" Value="{StaticResource Icon.Stroke.Width}"/><Setter Property="Fill" Value="Transparent"/></Style>
    <Style Selector="Path.dragHandleIcon"><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Fill" Value="{StaticResource Color.Text.Disabled}"/></Style>
    <Style Selector="TextBlock.datasetLayerName"><Setter Property="FontSize" Value="{StaticResource Font.Body.Size}"/><Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="MaxLines" Value="1"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style>
    <Style Selector="TextBlock.datasetLayerStatus"><Setter Property="FontSize" Value="{StaticResource Font.Small.Size}"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Secondary}"/><Setter Property="MinWidth" Value="{StaticResource Size.Width.64}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Margin="0,4,0,0"><TextBlock Text="{Binding DatasetLayerEmptyState}" Classes="uiMultiline" IsVisible="{Binding IsDatasetEmpty}"/>
    <ListBox Grid.Row="1" x:Name="DatasetLayerList" Classes="layerList" ItemsSource="{Binding DatasetLayerItems}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" IsVisible="{Binding !IsDatasetEmpty}">
      <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Height" Value="{StaticResource Control.Height.Emphasized}"/><Setter Property="MinHeight" Value="{StaticResource Control.Height.Emphasized}"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
      <ListBox.ItemTemplate><DataTemplate><Border x:Name="DatasetLayerRow" Classes="datasetLayerRow" PointerPressed="DatasetRow_Pressed">
        <Grid ColumnDefinitions="24,*,Auto,26,26" ColumnSpacing="4"><Border Classes="datasetLayerSelection" Grid.ColumnSpan="5" IsVisible="{Binding IsSelected}"/>
          <Border x:Name="DropLine" Grid.ColumnSpan="5" Height="2" Background="{StaticResource Layer.DropLine}" VerticalAlignment="Top" IsVisible="False" ZIndex="2"/>
          <Border Grid.Column="0" Width="24" Height="28" Background="Transparent" PointerPressed="DragHandle_PointerPressed" ToolTip.Tip="拖动调整顺序" ZIndex="1"><Path Classes="dragHandleIcon" Data="{StaticResource DragHandleIcon}"/></Border>
          <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="datasetLayerName" ToolTip.Tip="{Binding TypeIdText}" ZIndex="1"/>
          <TextBlock Grid.Column="2" Text="{Binding Status}" Classes="datasetLayerStatus" ZIndex="1"/>
          <ToggleButton Grid.Column="3" Classes="layerSwitch" IsChecked="{Binding IsVisible, Mode=OneWay}" Click="Visibility_Click" PointerPressed="DatasetAction_PointerPressed" ToolTip.Tip="显示或隐藏" AutomationProperties.Name="显示或隐藏数据集图层" ZIndex="1"><StackPanel><Path Classes="layerIcon" Data="{StaticResource VisibleIcon}" IsVisible="{Binding IsVisible}"/><Path Classes="layerIcon" Data="{StaticResource HiddenIcon}" IsVisible="{Binding !IsVisible}"/></StackPanel></ToggleButton>
          <ToggleButton Grid.Column="4" Classes="layerLockSwitch" IsChecked="{Binding IsLocked, Mode=OneWay}" Click="Lock_Click" PointerPressed="DatasetAction_PointerPressed" ToolTip.Tip="锁定或解锁" AutomationProperties.Name="锁定或解锁数据集图层" ZIndex="1"><StackPanel><Path Classes="layerIcon" Data="{StaticResource LockedIcon}" IsVisible="{Binding IsLocked}"/><Path Classes="layerIcon" Data="{StaticResource UnlockedIcon}" IsVisible="{Binding !IsLocked}"/></StackPanel></ToggleButton>
        </Grid>
      </Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
