{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XYT T Report",
  "type": "object",
  "required": ["Schema", "Kind", "ReportId", "Timestamp", "Version", "Commit", "Branch", "TestMode", "TestSetVersion", "AffectedCapabilities", "Status", "Evidence"],
  "properties": {
    "Schema": { "const": "XYT-T-Report.v1" },
    "Kind": { "const": "Run" },
    "ReportId": { "type": "string", "minLength": 1 },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Version": { "type": "string", "minLength": 1 },
    "Commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "Branch": { "type": "string", "minLength": 1 },
    "TestMode": { "type": "string", "minLength": 1 },
    "TestSetVersion": { "type": "string", "minLength": 1 },
    "AffectedCapabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "Status": { "enum": ["PASS", "FAIL", "BLOCKED", "TIMEOUT", "FLAKY"] },
    "Evidence": { "type": "array", "items": { "type": "string" } }
  }
}
