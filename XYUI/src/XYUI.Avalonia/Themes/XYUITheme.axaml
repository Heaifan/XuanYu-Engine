<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="using:Avalonia"
        x:Class="XYUI.Avalonia.Themes.XYUITheme">
  <Styles.Resources>
    <Color x:Key="XY.Color.Surface">#F7F9FC</Color>
    <Color x:Key="XY.Color.SurfaceRaised">#FFFFFF</Color>
    <Color x:Key="XY.Color.Border">#D8E0EA</Color>
    <Color x:Key="XY.Color.TextPrimary">#17212B</Color>
    <Color x:Key="XY.Color.TextSecondary">#5B6875</Color>
    <Color x:Key="XY.Color.Accent">#2563EB</Color>
    <Color x:Key="XY.Color.Error">#C0392B</Color>
    <Color x:Key="XY.Color.Sidebar">#17212B</Color>
    <Color x:Key="XY.Color.SidebarText">#B8C7D6</Color>
    <Color x:Key="XY.Color.SidebarAccent">#73A7FF</Color>
    <x:Double x:Key="XY.Space.1">4</x:Double>
    <x:Double x:Key="XY.Space.2">8</x:Double>
    <x:Double x:Key="XY.Space.3">12</x:Double>
    <x:Double x:Key="XY.Space.4">16</x:Double>
    <av:Thickness x:Key="XY.Padding.Card">16</av:Thickness>
    <av:Thickness x:Key="XY.Padding.Control.Small">8,3</av:Thickness>
    <av:Thickness x:Key="XY.Padding.Control.Default">12,6</av:Thickness>
    <av:Thickness x:Key="XY.Padding.Control.Large">16,9</av:Thickness>
    <av:CornerRadius x:Key="XY.Radius.Small">4</av:CornerRadius>
    <av:CornerRadius x:Key="XY.Radius.Medium">8</av:CornerRadius>
    <x:Double x:Key="XY.Control.Height.Default">32</x:Double>
    <x:Double x:Key="XY.Control.Height.Small">28</x:Double>
    <x:Double x:Key="XY.Control.Height.Large">40</x:Double>
    <x:Double x:Key="XY.FontSize.Control">13</x:Double>
  </Styles.Resources>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource XY.Color.TextPrimary}" />
    <Setter Property="FontFamily" Value="Inter" />
  </Style>
  <Style Selector="Border.xy-card">
    <Setter Property="Background" Value="{DynamicResource XY.Color.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource XY.Color.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource XY.Radius.Medium}" />
    <Setter Property="Padding" Value="{DynamicResource XY.Padding.Card}" />
  </Style>
  <StyleInclude Source="avares://XYUI.Avalonia/Themes/XYUIControls.axaml" />
</Styles>
