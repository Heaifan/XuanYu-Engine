<Styles xmlns="https://github.com/avaloniaui"
        xmlns:xy="using:XYUI.Avalonia.Controls">
  <Style Selector="xy|XYButton, xy|XYIconButton">
    <Setter Property="Background" Value="{DynamicResource XY.Color.Accent}" /><Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource XY.Color.Accent}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource XY.Radius.Small}" /><Setter Property="Padding" Value="{DynamicResource XY.Padding.Control.Default}" />
    <Setter Property="MinHeight" Value="{DynamicResource XY.Control.Height.Default}" /><Setter Property="FontSize" Value="{DynamicResource XY.FontSize.Control}" />
  </Style>
  <Style Selector="xy|XYButton:pointerover, xy|XYIconButton:pointerover"><Setter Property="Opacity" Value="0.88" /></Style>
  <Style Selector="xy|XYButton:pressed, xy|XYIconButton:pressed"><Setter Property="Opacity" Value="0.72" /></Style>
  <Style Selector="xy|XYButton:focus, xy|XYIconButton:focus"><Setter Property="BorderBrush" Value="{DynamicResource XY.Color.TextPrimary}" /><Setter Property="BorderThickness" Value="2" /></Style>
  <Style Selector="xy|XYButton:disabled, xy|XYIconButton:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
  <Style Selector="xy|XYButton.size-small, xy|XYIconButton.size-small"><Setter Property="Padding" Value="{DynamicResource XY.Padding.Control.Small}" /><Setter Property="MinHeight" Value="{DynamicResource XY.Control.Height.Small}" /></Style>
  <Style Selector="xy|XYButton.size-large, xy|XYIconButton.size-large"><Setter Property="Padding" Value="{DynamicResource XY.Padding.Control.Large}" /><Setter Property="MinHeight" Value="{DynamicResource XY.Control.Height.Large}" /></Style>
  <Style Selector="xy|XYButton.variant-secondary"><Setter Property="Background" Value="{DynamicResource XY.Color.SurfaceRaised}" /><Setter Property="Foreground" Value="{DynamicResource XY.Color.TextPrimary}" /><Setter Property="BorderBrush" Value="{DynamicResource XY.Color.Border}" /></Style>
  <Style Selector="xy|XYToggleButton"><Setter Property="Background" Value="{DynamicResource XY.Color.SurfaceRaised}" /><Setter Property="Foreground" Value="{DynamicResource XY.Color.TextPrimary}" /><Setter Property="BorderBrush" Value="{DynamicResource XY.Color.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{DynamicResource XY.Radius.Small}" /><Setter Property="Padding" Value="{DynamicResource XY.Padding.Control.Default}" /></Style>
  <Style Selector="xy|XYToggleButton:checked"><Setter Property="Background" Value="{DynamicResource XY.Color.Accent}" /><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="xy|XYTextField, xy|XYNumberField"><Setter Property="Background" Value="{DynamicResource XY.Color.SurfaceRaised}" /><Setter Property="Foreground" Value="{DynamicResource XY.Color.TextPrimary}" /><Setter Property="BorderBrush" Value="{DynamicResource XY.Color.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{DynamicResource XY.Radius.Small}" /><Setter Property="Padding" Value="{DynamicResource XY.Padding.Control.Default}" /><Setter Property="MinHeight" Value="{DynamicResource XY.Control.Height.Default}" /></Style>
  <Style Selector="xy|XYTextField:focus, xy|XYNumberField:focus"><Setter Property="BorderBrush" Value="{DynamicResource XY.Color.Accent}" /><Setter Property="BorderThickness" Value="2" /></Style>
  <Style Selector="xy|XYTextField.error, xy|XYNumberField.error"><Setter Property="BorderBrush" Value="{DynamicResource XY.Color.Error}" /></Style>
  <Style Selector="xy|XYTextField.density-compact, xy|XYNumberField.density-compact"><Setter Property="Padding" Value="{DynamicResource XY.Padding.Control.Small}" /><Setter Property="MinHeight" Value="{DynamicResource XY.Control.Height.Small}" /></Style>
  <Style Selector="xy|XYTextField.density-comfortable, xy|XYNumberField.density-comfortable"><Setter Property="Padding" Value="{DynamicResource XY.Padding.Control.Large}" /><Setter Property="MinHeight" Value="{DynamicResource XY.Control.Height.Large}" /></Style>
  <Style Selector="xy|XYCheckBox, xy|XYRadioButton, xy|XYComboBox, xy|XYSlider"><Setter Property="FontSize" Value="{DynamicResource XY.FontSize.Control}" /></Style>
  <Style Selector="xy|XYToggleSwitch"><Setter Property="Background" Value="{DynamicResource XY.Color.Border}" /><Setter Property="Foreground" Value="{DynamicResource XY.Color.TextPrimary}" /><Setter Property="BorderBrush" Value="{DynamicResource XY.Color.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{DynamicResource XY.Radius.Medium}" /><Setter Property="Padding" Value="{DynamicResource XY.Padding.Control.Small}" /><Setter Property="MinWidth" Value="72" /></Style>
  <Style Selector="xy|XYToggleSwitch:checked"><Setter Property="Background" Value="{DynamicResource XY.Color.Accent}" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="{DynamicResource XY.Color.Accent}" /></Style>
  <Style Selector="xy|XYBadge"><Setter Property="Background" Value="{DynamicResource XY.Color.Accent}" /><Setter Property="Foreground" Value="White" /><Setter Property="Padding" Value="{DynamicResource XY.Padding.Control.Small}" /><Setter Property="CornerRadius" Value="{DynamicResource XY.Radius.Small}" /></Style>
  <Style Selector="xy|XYTag"><Setter Property="Background" Value="{DynamicResource XY.Color.SurfaceRaised}" /><Setter Property="Foreground" Value="{DynamicResource XY.Color.TextSecondary}" /><Setter Property="BorderBrush" Value="{DynamicResource XY.Color.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="{DynamicResource XY.Padding.Control.Small}" /><Setter Property="CornerRadius" Value="{DynamicResource XY.Radius.Small}" /></Style>
</Styles>
