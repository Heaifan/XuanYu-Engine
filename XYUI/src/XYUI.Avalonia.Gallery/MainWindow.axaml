<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XYUI.Avalonia.Gallery.MainWindow"
        Title="XYUI.Avalonia Gallery · 0.1.0-alpha"
        Width="1100" Height="720" MinWidth="560" MinHeight="420">
  <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,*">
    <Border Grid.RowSpan="2" Background="#17212B" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Text="XYUI.Avalonia" Foreground="White" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Core Pack 0.1 · R1" Foreground="#B8C7D6" />
        <TextBlock Text="Foundation" Foreground="#73A7FF" Margin="0,24,0,0" />
        <TextBlock Text="Text" Foreground="#B8C7D6" />
        <TextBlock Text="Buttons" Foreground="#B8C7D6" />
        <TextBlock Text="Inputs" Foreground="#B8C7D6" />
        <TextBlock Text="Layout" Foreground="#B8C7D6" />
        <TextBlock Text="Feedback" Foreground="#B8C7D6" />
        <TextBlock Text="Overlay" Foreground="#B8C7D6" />
      </StackPanel>
    </Border>
    <Border Grid.Column="1" Background="{DynamicResource XY.Color.Surface}" Padding="24">
      <StackPanel Spacing="4">
        <TextBlock Text="Foundation" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="颜色、文字、间距、圆角、边框、状态、Focus 与 Density" Foreground="{DynamicResource XY.Color.TextSecondary}" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Grid.Column="1" Padding="24">
      <StackPanel Spacing="16">
        <Border Classes="xy-card"><StackPanel Spacing="12">
          <TextBlock Text="Color Tokens" FontSize="18" FontWeight="Bold" />
          <WrapPanel ItemWidth="180" ItemHeight="72">
            <Border Background="{DynamicResource XY.Color.SurfaceRaised}" BorderBrush="{DynamicResource XY.Color.Border}" BorderThickness="1" Padding="8"><TextBlock Text="Surface / Raised" /></Border>
            <Border Background="{DynamicResource XY.Color.Accent}" Padding="8"><TextBlock Text="Accent" Foreground="White" /></Border>
            <Border Background="{DynamicResource XY.Color.Border}" Padding="8"><TextBlock Text="Border" /></Border>
          </WrapPanel>
        </StackPanel></Border>
        <Border Classes="xy-card"><StackPanel Spacing="8">
          <TextBlock Text="Typography &amp; Density" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="Default density · Pointer ready" />
          <TextBlock Text="Compact     Default     Comfortable" Foreground="{DynamicResource XY.Color.TextSecondary}" />
          <TextBlock Text="Focus token: Accent / 2px" Foreground="{DynamicResource XY.Color.Accent}" />
        </StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
