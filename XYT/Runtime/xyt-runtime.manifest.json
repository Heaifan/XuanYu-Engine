{
  "schema": "XYT-Runtime-Artifact-Manifest.v1",
  "root": ".xyt/runtime",
  "lifecycle": {
    "START": "write the candidate record before starting the target",
    "RUNNING": "write stdout/stderr support logs with bounded writes",
    "TERMINAL": "write an END or FAILURE record with status and reason",
    "CLEANUP": "registered runtime artifacts may be ignored individually; unknown files remain visible"
  },
  "artifacts": [
    { "pattern": "^P3-[0-9]{2}-[0-9]{17}\\.json$", "class": "EVIDENCE" },
    { "pattern": "^P3-[0-9]{2}-[0-9]{14}\\.json$", "class": "EVIDENCE" },
    { "pattern": "^P3-[0-9]{2}-[0-9]{17}\\.start\\.json$", "class": "EVIDENCE" },
    { "pattern": "^P3-[0-9]{2}-[0-9]{14}\\.start\\.json$", "class": "EVIDENCE" },
    { "pattern": "^P3-[0-9]{2}-[0-9]{17}\\.failure\\.json$", "class": "EVIDENCE" },
    { "pattern": "^P3-[0-9]{2}-[0-9]{17}\\.log$", "class": "SUPPORT_LOG" },
    { "pattern": "^P3-[0-9]{2}-[0-9]{14}\\.log$", "class": "SUPPORT_LOG" },
    { "pattern": "^P3-[0-9]{2}-[0-9]{17}\\.stderr\\.log$", "class": "SUPPORT_LOG" },
    { "pattern": "^P3-[0-9]{2}-[0-9]{17}-build\\.log$", "class": "BUILD_LOG" },
    { "pattern": "^P3-[0-9]{2}-[0-9]{14}-build\\.log$", "class": "BUILD_LOG" },
    { "pattern": "^canonical-build\\.log$", "class": "BUILD_LOG" },
    { "pattern": "^XYE-[A-Za-z0-9-]+-blocked\\.md$", "class": "BLOCKED_REPORT" },
    { "pattern": "^stage-ended\\.txt$", "class": "STAGE_MARKER" },
    { "pattern": "^\\.gitignore$", "class": "EPHEMERAL" }
  ]
}
