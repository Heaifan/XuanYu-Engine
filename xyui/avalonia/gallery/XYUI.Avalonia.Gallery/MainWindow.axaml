<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:XYUI.Avalonia.Gallery.Views"
        xmlns:g="using:XYUI.Avalonia.Gallery"
        x:Class="XYUI.Avalonia.Gallery.MainWindow"
        x:DataType="g:MainWindowModel"
        Title="XYUI.Avalonia · 组件文档 Gallery"
        Width="1120" Height="760"
        Background="{DynamicResource XY.Brush.Surface.App}">
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.Field}">
        <Button x:Name="ThemeSwitchButton" Content="切换 Dark"
                Padding="10,4" Background="{DynamicResource XY.Brush.Surface.PanelAlt}"
                Foreground="{DynamicResource XY.Brush.Text.Primary}"
                BorderBrush="{DynamicResource XY.Brush.Border.Color.Subtle}"
                BorderThickness="1" Click="OnThemeSwitchClick" />
        <Button x:Name="DensitySwitchButton" Content="Density: Compact"
                Padding="10,4" Background="{DynamicResource XY.Brush.Surface.PanelAlt}"
                Foreground="{DynamicResource XY.Brush.Text.Primary}"
                BorderBrush="{DynamicResource XY.Brush.Border.Color.Subtle}"
                BorderThickness="1" Click="OnDensitySwitchClick" />
        <Button x:Name="ZoomSwitchButton" Content="Zoom: 100%"
                Padding="10,4" Background="{DynamicResource XY.Brush.Surface.PanelAlt}"
                Foreground="{DynamicResource XY.Brush.Text.Primary}"
                BorderBrush="{DynamicResource XY.Brush.Border.Color.Subtle}"
                BorderThickness="1" />
        <Button x:Name="MetricsDebugButton" Content="Metrics Debug"
                Padding="10,4" Background="{DynamicResource XY.Brush.Surface.PanelAlt}"
                Foreground="{DynamicResource XY.Brush.Text.Primary}"
                BorderBrush="{DynamicResource XY.Brush.Border.Color.Subtle}"
                BorderThickness="1" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="XYUI 组件文档" Classes="xyui-heading-panel" />
        <TextBlock x:Name="ThemeStateText" Text="Theme：Light (Test Bar Active)" Classes="xyui-text-caption" />
      </StackPanel>
    </DockPanel>
    <views:XYUI1DocumentationView x:Name="DocumentationView" />
  </DockPanel>
</Window>
