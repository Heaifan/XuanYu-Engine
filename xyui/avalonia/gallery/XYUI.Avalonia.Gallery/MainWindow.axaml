<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:XYUI.Avalonia.Gallery.Views"
        xmlns:g="using:XYUI.Avalonia.Gallery"
        x:Class="XYUI.Avalonia.Gallery.MainWindow"
        x:DataType="g:MainWindowModel"
        Title="XYUI.Avalonia · XYUI-1 文档 Gallery"
        Width="1120" Height="760"
        Background="{DynamicResource XY.Brush.Surface.App}">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="XYUI-1 · 文本与信息组件文档" Classes="xyui-heading-panel" />
      <TextBlock Text="中文文档 / 实时预览 / 基础用法 / API / Design Token" Classes="xyui-text-caption" />
    </StackPanel>
    <views:XYUI1DocumentationView />
  </DockPanel>
</Window>
