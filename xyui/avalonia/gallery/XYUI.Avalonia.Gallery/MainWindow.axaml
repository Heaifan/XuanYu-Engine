<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:XYUI.Avalonia.Gallery.Views"
        xmlns:g="using:XYUI.Avalonia.Gallery"
        x:Class="XYUI.Avalonia.Gallery.MainWindow"
        x:DataType="g:MainWindowModel"
        Title="XYUI.Avalonia · 组件文档 Gallery"
        Width="1120" Height="760"
        Background="{DynamicResource XY.Brush.Surface.App}">
  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <!-- Toolbar: Consumes XY.Gap.ToolGroup and XY.Gap.ToolItem -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.ToolGroup}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.ToolItem}">
          <Button x:Name="ThemeSwitchButton" Content="切换 Dark"
                  Padding="10,4" Background="{DynamicResource XY.Brush.Surface.PanelAlt}"
                  Foreground="{DynamicResource XY.Brush.Text.Primary}"
                  BorderBrush="{DynamicResource XY.Brush.Border.Color.Subtle}"
                  BorderThickness="1" Click="OnThemeSwitchClick" />
          <Button x:Name="DensitySwitchButton" Content="Density: Compact"
                  Padding="10,4" Background="{DynamicResource XY.Brush.Surface.PanelAlt}"
                  Foreground="{DynamicResource XY.Brush.Text.Primary}"
                  BorderBrush="{DynamicResource XY.Brush.Border.Color.Subtle}"
                  BorderThickness="1" Click="OnDensitySwitchClick" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.ToolItem}">
          <Button x:Name="ZoomSwitchButton" Content="Zoom: 100%"
                  Padding="10,4" Background="{DynamicResource XY.Brush.Surface.PanelAlt}"
                  Foreground="{DynamicResource XY.Brush.Text.Primary}"
                  BorderBrush="{DynamicResource XY.Brush.Border.Color.Subtle}"
                  BorderThickness="1" />
          <Button x:Name="MetricsDebugButton" Content="Metrics Debug"
                  Padding="10,4" Background="{DynamicResource XY.Brush.Surface.PanelAlt}"
                  Foreground="{DynamicResource XY.Brush.Text.Primary}"
                  BorderBrush="{DynamicResource XY.Brush.Border.Color.Subtle}"
                  BorderThickness="1" Click="OnMetricsDebugClick" />
        </StackPanel>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="XYUI 组件文档" Classes="xyui-heading-panel" />
        <TextBlock x:Name="ThemeStateText" Text="Theme：Light (Test Bar Active)" Classes="xyui-text-caption" />
      </StackPanel>
    </DockPanel>

    <!-- Metrics Debug v1 Overlay Banner -->
    <Border x:Name="MetricsDebugBanner" DockPanel.Dock="Top" Background="{DynamicResource XY.Brush.Accent.Soft}"
            BorderBrush="{DynamicResource XY.Brush.Accent.Default}" BorderThickness="1" Padding="8,4" Margin="0,0,0,8" IsVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.ToolItem}">
        <TextBlock Text="📐 METRICS DEBUG v1 ON:" Classes="xyui-text-code" Foreground="{DynamicResource XY.Brush.Accent.Strong}" VerticalAlignment="Center" />
        <TextBlock Text="Control_H: 24/28/32/36 | TreeRow: 28 | Toolbar: 30 | Padding: 8 | Gap: 4 | Icon: 14/16/20 | Border: 1" Classes="xyui-text-caption" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <views:XYUI1DocumentationView x:Name="DocumentationView" />
  </DockPanel>
</Window>
