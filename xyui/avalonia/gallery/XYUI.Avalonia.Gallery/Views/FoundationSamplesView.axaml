<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XYUI.Avalonia.Gallery.Views.FoundationSamplesView">
  <StackPanel Spacing="12">
      <Border Background="{DynamicResource XY.Brush.Surface.Panel}" CornerRadius="6" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="Surface 层级（逐层抬升，不依赖阴影）" Classes="xyui-text-section" />
          <Border Background="{DynamicResource XY.Brush.Surface.App}" CornerRadius="4" Padding="10">
            <TextBlock Text="Surface.App" Foreground="{DynamicResource XY.Brush.Text.Secondary}" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.Surface.PanelAlt}" CornerRadius="4" Padding="10">
            <TextBlock Text="Surface.PanelAlt" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.Surface.Raised}" CornerRadius="4" Padding="10"
                  BorderBrush="{DynamicResource XY.Brush.Border.Color.Default}" BorderThickness="1">
            <TextBlock Text="Surface.Raised" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource XY.Brush.Surface.Panel}" CornerRadius="6" Padding="12">
        <StackPanel Spacing="4">
          <TextBlock Text="Text 信息等级" Classes="xyui-text-section" />
          <TextBlock Text="Primary — 主文本" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          <TextBlock Text="Secondary — 次级文本" Foreground="{DynamicResource XY.Brush.Text.Secondary}" />
          <TextBlock Text="Tertiary — 三级文本" Foreground="{DynamicResource XY.Brush.Text.Tertiary}" />
          <TextBlock Text="Placeholder — 占位符" Foreground="{DynamicResource XY.Brush.Text.Placeholder}" />
          <TextBlock Text="Disabled — 禁用文本" Foreground="{DynamicResource XY.Brush.Text.Disabled}" />
          <TextBlock Text="Link — 链接" Foreground="{DynamicResource XY.Brush.Text.Link}" />
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource XY.Brush.Surface.Panel}" CornerRadius="6" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Border 三档 + Focus" Classes="xyui-text-section" />
          <Border BorderBrush="{DynamicResource XY.Brush.Border.Color.Subtle}" BorderThickness="1" CornerRadius="4" Padding="10">
            <TextBlock Text="Border.Subtle" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
          <Border BorderBrush="{DynamicResource XY.Brush.Border.Color.Default}" BorderThickness="1" CornerRadius="4" Padding="10">
            <TextBlock Text="Border.Default" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
          <Border BorderBrush="{DynamicResource XY.Brush.Border.Color.Strong}" BorderThickness="1" CornerRadius="4" Padding="10">
            <TextBlock Text="Border.Strong" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
          <Border BorderBrush="{DynamicResource XY.Brush.Border.Color.Focus}" BorderThickness="1" CornerRadius="4" Padding="10">
            <TextBlock Text="Border.Focus（焦点环色）" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource XY.Brush.Surface.Panel}" CornerRadius="6" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Accent 三级（Soft/Default/Strong）" Classes="xyui-text-section" />
          <Border Background="{DynamicResource XY.Brush.Accent.Soft}" CornerRadius="4" Padding="10">
            <TextBlock Text="Accent.Soft" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.Accent.Default}" CornerRadius="4" Padding="10">
            <TextBlock Text="Accent.Default" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.Accent.Strong}" CornerRadius="4" Padding="10">
            <TextBlock Text="Accent.Strong" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
</UserControl>
