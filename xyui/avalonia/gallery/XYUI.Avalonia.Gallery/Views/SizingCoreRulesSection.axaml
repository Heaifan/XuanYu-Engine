<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XYUI.Avalonia.Gallery.Views.SizingCoreRulesSection">
  <Border Classes="xyui-surface-panel" Padding="14,10" CornerRadius="6">
    <StackPanel Spacing="6">
      <TextBlock Text="① 核心规则" Classes="xyui-text-section" FontSize="15" />
      <Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
        <!-- 1. 高度体系 -->
        <Border Grid.Column="0" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10,8" Margin="0,0,4,0" CornerRadius="4">
          <StackPanel Spacing="2">
            <TextBlock Text="高度体系" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="28 / 32 / 36 / 44 DIP" Classes="xyui-text-caption" />
          </StackPanel>
        </Border>

        <!-- 2. 宽度 -->
        <Border Grid.Column="1" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10,8" Margin="2,0,2,0" CornerRadius="4">
          <StackPanel Spacing="2">
            <TextBlock Text="宽度" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="内容驱动" Classes="xyui-text-caption" />
          </StackPanel>
        </Border>

        <!-- 3. 图标 -->
        <Border Grid.Column="2" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10,8" Margin="2,0,2,0" CornerRadius="4">
          <StackPanel Spacing="2">
            <TextBlock Text="图标" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="14 / 16 / 20 / 24" Classes="xyui-text-caption" />
          </StackPanel>
        </Border>

        <!-- 4. 命中区 -->
        <Border Grid.Column="3" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10,8" Margin="4,0,0,0" CornerRadius="4">
          <StackPanel Spacing="2">
            <TextBlock Text="命中区" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="独立语义" Classes="xyui-text-caption" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>