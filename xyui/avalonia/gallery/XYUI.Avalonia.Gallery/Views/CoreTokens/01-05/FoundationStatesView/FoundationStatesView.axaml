<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XYUI.Avalonia.Gallery.Views.FoundationStatesView">
  <StackPanel Spacing="12">
      <Border Background="{DynamicResource XY.Brush.Surface.Panel}" CornerRadius="6" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Interaction State" Classes="xyui-text-section" />
          <Border Background="{DynamicResource XY.Brush.State.Color.Hover}" CornerRadius="4" Padding="10">
            <TextBlock Text="State.Hover" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.State.Color.Selected}" CornerRadius="4" Padding="10">
            <TextBlock Text="State.Selected" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.State.Color.Active}" CornerRadius="4" Padding="10">
            <TextBlock Text="State.Active" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.State.Color.Pressed}" CornerRadius="4" Padding="10">
            <TextBlock Text="State.Pressed" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
          </Border>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource XY.Brush.Surface.Panel}" CornerRadius="6" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Feedback 语义四态（文字 + 背景 + 边框）" Classes="xyui-text-section" />
          <Border Background="{DynamicResource XY.Brush.Semantic.Success.Background}" CornerRadius="4" Padding="10"
                  BorderBrush="{DynamicResource XY.Brush.Semantic.Success.Border}" BorderThickness="1">
            <TextBlock Text="Success — 操作成功" Foreground="{DynamicResource XY.Brush.Semantic.Success.Text}" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.Semantic.Warning.Background}" CornerRadius="4" Padding="10"
                  BorderBrush="{DynamicResource XY.Brush.Semantic.Warning.Border}" BorderThickness="1">
            <TextBlock Text="Warning — 注意提醒" Foreground="{DynamicResource XY.Brush.Semantic.Warning.Text}" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.Semantic.Error.Background}" CornerRadius="4" Padding="10"
                  BorderBrush="{DynamicResource XY.Brush.Semantic.Error.Border}" BorderThickness="1">
            <TextBlock Text="Error — 错误反馈" Foreground="{DynamicResource XY.Brush.Semantic.Error.Text}" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.Semantic.Info.Background}" CornerRadius="4" Padding="10"
                  BorderBrush="{DynamicResource XY.Brush.Semantic.Info.Border}" BorderThickness="1">
            <TextBlock Text="Info — 信息提示" Foreground="{DynamicResource XY.Brush.Semantic.Info.Text}" />
          </Border>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource XY.Brush.Surface.Panel}" CornerRadius="6" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="Disabled / ReadOnly / Locked 三态" Classes="xyui-text-section" />
          <Border Background="{DynamicResource XY.Brush.State.Disabled.Background}" CornerRadius="4" Padding="10"
                  BorderBrush="{DynamicResource XY.Brush.State.Disabled.Border}" BorderThickness="1">
            <TextBlock Text="Disabled" Foreground="{DynamicResource XY.Brush.State.Disabled.Text}" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.State.ReadOnly.Background}" CornerRadius="4" Padding="10"
                  BorderBrush="{DynamicResource XY.Brush.State.ReadOnly.Border}" BorderThickness="1">
            <TextBlock Text="ReadOnly" Foreground="{DynamicResource XY.Brush.State.ReadOnly.Text}" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.State.Locked.Background}" CornerRadius="4" Padding="10"
                  BorderBrush="{DynamicResource XY.Brush.State.Locked.Border}" BorderThickness="1">
            <TextBlock Text="Locked" Foreground="{DynamicResource XY.Brush.State.Locked.Text}" />
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
</UserControl>
