<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             x:Class="XYUI.Avalonia.Gallery.Views.SpacingCoreRulesSection">
  <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}" Background="{DynamicResource XY.Brush.Surface.Panel}">
    <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
      <TextBlock Text="① 三条核心规则" Classes="xyui-text-section" />
      <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
        <!-- 1. Padding -->
        <Border Grid.Column="0" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="12,10" Margin="0,0,4,0" CornerRadius="4">
          <StackPanel Spacing="4">
            <TextBlock Text="Padding · 内边距" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="组件 / 容器内部空间 · 由组件自身拥有" Classes="xyui-text-caption" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- 2. Gap -->
        <Border Grid.Column="1" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="12,10" Margin="2,0,2,0" CornerRadius="4">
          <StackPanel Spacing="4">
            <TextBlock Text="Gap · 间隙" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="兄弟元素之间 · 由父级容器统一决定" Classes="xyui-text-caption" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- 3. Margin -->
        <Border Grid.Column="2" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="12,10" Margin="4,0,0,0" CornerRadius="4">
          <StackPanel Spacing="4">
            <TextBlock Text="Margin · 外边距" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Status.Danger}" />
            <TextBlock Text="仅特殊外部关系 · 不作为常规兄弟元素布局手段" Classes="xyui-text-caption" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>