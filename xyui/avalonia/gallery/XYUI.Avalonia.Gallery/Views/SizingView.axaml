<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             xmlns:views="using:XYUI.Avalonia.Gallery.Views"
             x:Class="XYUI.Avalonia.Gallery.Views.SizingView">
  <ScrollViewer>
    <StackPanel Margin="{DynamicResource XY.Padding.Panel}" Spacing="{DynamicResource XY.Gap.Section}">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.Field}">
          <TextBlock Text="XYUI-0.04 · 尺寸控制" Classes="xyui-heading-panel" />
          <c:XYStatusBadge Text="已锁定 · 0.04" State="Success" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="统一控件高度、图标尺寸、命中区域与内容驱动宽度。" Classes="xyui-text-caption" />
      </StackPanel>

      <views:SizingCoreRulesSection />

      <views:SizingMatrixSection />

      <views:SizingAnatomySection />

      <!-- ④ 推荐写法 · 高级用法 · 禁止写法 -->
      <views:SizingCodePatternsSection />
    </StackPanel>
  </ScrollViewer>
</UserControl>
