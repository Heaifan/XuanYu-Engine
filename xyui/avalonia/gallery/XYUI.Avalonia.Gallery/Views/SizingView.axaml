<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:XYUI.Avalonia.Gallery.Views"
             x:Class="XYUI.Avalonia.Gallery.Views.SizingView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="{DynamicResource XY.Space.3}" Margin="0,0,12,16">
      <!-- 标题 -->
      <StackPanel Spacing="3">
        <TextBlock Text="XYUI-0.04 · 尺寸控制" Classes="xyui-heading-panel" FontSize="22" />
        <TextBlock Text="用 XY.Size 统一管理控件尺寸，宽度继续由内容与布局决定" Classes="xyui-text-caption" />
      </StackPanel>

      <!-- ① 核心规则 -->
      <views:SizingCoreRulesSection />

      <!-- ② 真实组件尺寸矩阵 (HERO) -->
      <views:SizingMatrixSection />

      <!-- ③ 尺寸解剖 -->
      <views:SizingAnatomySection />

      <!-- ④ 推荐写法 · 高级用法 · 禁止写法 -->
      <views:SizingCodePatternsSection />
    </StackPanel>
  </ScrollViewer>
</UserControl>