<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XYUI.Avalonia.Gallery.Views.ShapeCompositionSection">
  <Border Classes="xyui-surface-panel xyui-border-default" CornerRadius="10" Padding="14,10">
    <StackPanel Spacing="10">
      <TextBlock Text="03 · Shape × Radius × Border × Surface" Classes="xyui-text-section" FontSize="16" FontWeight="Bold" />
      <Grid ColumnDefinitions="*,*,*,*">
        <Border Grid.Column="0" Margin="0,0,4,0" Background="{DynamicResource XY.Brush.Surface.Raised}" Classes="xyui-border-default" CornerRadius="8" Padding="10">
          <StackPanel Spacing="3">
            <TextBlock Text="Shape" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="决定几何轮廓与适用内容" Classes="xyui-text-body" FontSize="11" />
            <TextBlock Text="例：矩形、柔角矩形、胶囊、圆形" Classes="xyui-text-caption" FontSize="10" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Margin="2,0,2,0" Background="{DynamicResource XY.Brush.Surface.Raised}" Classes="xyui-border-default" CornerRadius="8" Padding="10">
          <StackPanel Spacing="3">
            <TextBlock Text="Radius" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="只负责转角柔和程度" Classes="xyui-text-body" FontSize="11" />
            <TextBlock Text="例：Small / Medium / Large / Full" Classes="xyui-text-caption" FontSize="10" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Margin="2,0,2,0" Background="{DynamicResource XY.Brush.Surface.Raised}" Classes="xyui-border-default" CornerRadius="8" Padding="10">
          <StackPanel Spacing="3">
            <TextBlock Text="Border" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="负责边界表达与状态轮廓" Classes="xyui-text-body" FontSize="11" />
            <TextBlock Text="例：Default / Subtle / Strong / Focus" Classes="xyui-text-caption" FontSize="10" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Margin="4,0,0,0" Background="{DynamicResource XY.Brush.Surface.Raised}" Classes="xyui-border-default" CornerRadius="8" Padding="10">
          <StackPanel Spacing="3">
            <TextBlock Text="Surface" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="负责背景承载、层级与表面语义" Classes="xyui-text-body" FontSize="11" />
            <TextBlock Text="例：Flat / Subtle / Raised / Inset" Classes="xyui-text-caption" FontSize="10" />
          </StackPanel>
        </Border>
      </Grid>
      <!-- 决策矩阵表 -->
      <Border Classes="xyui-border-default" Background="{DynamicResource XY.Brush.Surface.App}" CornerRadius="8" Padding="10">
        <Grid ColumnDefinitions="1.2*,1.2*,1.5*,1.5*" RowDefinitions="Auto,Auto,Auto,Auto">
          <!-- Header -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="开发目标" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="优先 Owner" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="推荐心智" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Grid.Row="0" Grid.Column="3" Text="不要误用" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <!-- Row 1 -->
          <TextBlock Grid.Row="1" Grid.Column="0" Text="让卡片更柔和" Margin="0,6,0,0" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="Radius" Margin="0,6,0,0" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="不改变基础 Shape" Margin="0,6,0,0" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Grid.Row="1" Grid.Column="3" Text="不要把 Radius 当作新 Shape 体系" Margin="0,6,0,0" Foreground="{DynamicResource XY.Brush.System.Danger}" FontSize="11" />
          <!-- Row 2 -->
          <TextBlock Grid.Row="2" Grid.Column="0" Text="做一个胶囊标签" Margin="0,6,0,0" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="Shape + Radius + Surface" Margin="0,6,0,0" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="短文本、轻语义、单行使用" Margin="0,6,0,0" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Grid.Row="2" Grid.Column="3" Text="不要把长说明做成胶囊" Margin="0,6,0,0" Foreground="{DynamicResource XY.Brush.System.Danger}" FontSize="11" />
          <!-- Row 3 -->
          <TextBlock Grid.Row="3" Grid.Column="0" Text="做一个更高层级的卡片" Margin="0,6,0,0" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="Surface" Margin="0,6,0,0" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Grid.Row="3" Grid.Column="2" Text="优先看层级，不是先改几何" Margin="0,6,0,0" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Grid.Row="3" Grid.Column="3" Text="不要把 Surface 当成 Shape 替代物" Margin="0,6,0,0" Foreground="{DynamicResource XY.Brush.System.Danger}" FontSize="11" />
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
