<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:XYUI.Avalonia.Gallery"
             x:Class="XYUI.Avalonia.Gallery.Views.XYUI1ComponentDocumentView"
             x:DataType="g:XYUI1ComponentDocument">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" Spacing="14">
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="{Binding Id}" Classes="xyui-text-code" FontWeight="Bold" />
            <TextBlock Grid.Column="2" Text="{Binding Category}" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Text.Tertiary}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding AvaloniaType}" Classes="xyui-heading-page" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding ChineseName, StringFormat='· {0}'}" Classes="xyui-heading-page" FontSize="20" Foreground="{DynamicResource XY.Brush.Text.Secondary}" />
          </StackPanel>
          <TextBlock Text="{Binding Overview}" Classes="xyui-text-body" TextWrapping="Wrap" />
          <TextBlock Text="{Binding StatusText}" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Accent.Strong}" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Text="DEVELOPER QUICK START" Classes="xyui-text-section" FontWeight="Bold" />
          <Grid ColumnDefinitions="*,16,*" MinHeight="52">
            <Border Grid.Column="0" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="12,10" CornerRadius="4">
              <TextBlock Text="{Binding QuickStartXaml}" Classes="xyui-text-code" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="12,10" CornerRadius="4">
              <ContentControl x:Name="PreviewHost" HorizontalContentAlignment="Left" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6" IsVisible="{Binding HasCoreRules}">
        <StackPanel Spacing="8">
          <TextBlock Text="01 CORE RULES" Classes="xyui-text-section" FontWeight="Bold" />
          <ItemsControl ItemsSource="{Binding CoreRules}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="g:XYUIDocRule">
              <Grid ColumnDefinitions="120,*" Margin="0,3"><TextBlock Text="{Binding Title}" Classes="xyui-text-label" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Content}" Classes="xyui-text-body" TextWrapping="Wrap" /></Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6" IsVisible="{Binding HasVariants}">
        <StackPanel Spacing="8">
          <TextBlock Text="02 VARIANTS / ANATOMY" Classes="xyui-text-section" FontWeight="Bold" />
          <ItemsControl ItemsSource="{Binding Variants}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="g:XYUIDocVariant">
              <Grid ColumnDefinitions="120,*,*" Margin="0,3"><TextBlock Text="{Binding Name}" Classes="xyui-text-code" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Description}" Classes="xyui-text-body" /><TextBlock Grid.Column="2" Text="{Binding Usage}" Classes="xyui-text-caption" /></Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Text="03 FOUNDATION &amp; STATES" Classes="xyui-text-section" FontWeight="Bold" />
          <ItemsControl ItemsSource="{Binding FoundationMappings}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="g:XYUIDocFoundationItem">
              <Grid ColumnDefinitions="120,200,*" Margin="0,2"><TextBlock Text="{Binding Concept}" Classes="xyui-text-label" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding FoundationToken}" Classes="xyui-text-code" Foreground="{DynamicResource XY.Brush.Accent.Strong}" /><TextBlock Grid.Column="2" Text="{Binding Description}" Classes="xyui-text-caption" TextWrapping="Wrap" /></Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding States}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="g:XYUIDocState">
              <Grid ColumnDefinitions="120,*" Margin="0,2"><TextBlock Text="{Binding Name}" Classes="xyui-text-code" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Description}" Classes="xyui-text-body" /></Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6" IsVisible="{Binding HasHowToUse}">
        <StackPanel Spacing="8">
          <TextBlock Text="04 HOW TO USE" Classes="xyui-text-section" FontWeight="Bold" />
          <ItemsControl ItemsSource="{Binding HowToUse}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="g:XYUIDocGuideItem">
              <Grid ColumnDefinitions="120,*" Margin="0,3"><TextBlock Text="{Binding Category}" Classes="xyui-text-label" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Description}" Classes="xyui-text-body" TextWrapping="Wrap" /></Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6" IsVisible="{Binding HasLiveExamples}">
        <StackPanel Spacing="8">
          <TextBlock Text="LIVE EXAMPLES · 业务场景实装" Classes="xyui-text-section" FontWeight="Bold" />
          <ContentControl x:Name="LiveExamplesHost" HorizontalContentAlignment="Left" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
