<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             xmlns:d="using:XYUI.Avalonia.Density"
             xmlns:l="using:XYUI.Avalonia.Layout"
             x:Class="XYUI.Avalonia.Gallery.Views.SpacingDensityCompareSection">
  <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}">
    <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
      <TextBlock Text="③ 同一布局 · Density 自动改变空间" Classes="xyui-text-section" />
      <TextBlock Text="XAML 结构不变，只切 Density；Spacing/Padding 自动映射。Touch 仅批准空间，不代表 Sizing 已批准。" Classes="xyui-text-caption" />

      <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
        <!-- 1. Compact Column -->
        <Border Grid.Column="0" d:XyuiDensityScope.Mode="Compact" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="8" Margin="0,0,4,0" CornerRadius="4">
          <l:XYSectionGroup>
            <TextBlock Text="Compact · 2 / 6 / 12" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <l:XYToolbar>
              <l:XYToolGroup>
                <c:XYButton Content="A1" Variant="Primary" />
                <c:XYButton Content="A2" Variant="Secondary" />
              </l:XYToolGroup>
              <c:XYButton Content="B1" Variant="Secondary" />
            </l:XYToolbar>
            <l:XYPanel Background="{DynamicResource XY.Brush.Surface.Panel}" CornerRadius="3">
              <TextBlock Text="Compact Panel" Classes="xyui-text-caption" />
            </l:XYPanel>
          </l:XYSectionGroup>
        </Border>

        <!-- 2. Comfortable Column -->
        <Border Grid.Column="1" d:XyuiDensityScope.Mode="Comfortable" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="8" Margin="2,0,2,0" CornerRadius="4">
          <l:XYSectionGroup>
            <TextBlock Text="Comfortable · 4 / 8 / 16" Classes="xyui-text-caption" FontWeight="Bold" />
            <l:XYToolbar>
              <l:XYToolGroup>
                <c:XYButton Content="A1" Variant="Primary" />
                <c:XYButton Content="A2" Variant="Secondary" />
              </l:XYToolGroup>
              <c:XYButton Content="B1" Variant="Secondary" />
            </l:XYToolbar>
            <l:XYPanel Background="{DynamicResource XY.Brush.Surface.Panel}" CornerRadius="3">
              <TextBlock Text="Comfortable Panel" Classes="xyui-text-caption" />
            </l:XYPanel>
          </l:XYSectionGroup>
        </Border>

        <!-- 3. Touch Column -->
        <Border Grid.Column="2" d:XyuiDensityScope.Mode="Touch" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="8" Margin="4,0,0,0" CornerRadius="4">
          <l:XYSectionGroup>
            <TextBlock Text="Touch · 6 / 12 / 20 · Spacing only" Classes="xyui-text-caption" FontWeight="Bold" />
            <l:XYToolbar>
              <l:XYToolGroup>
                <c:XYButton Content="A1" Variant="Primary" />
                <c:XYButton Content="A2" Variant="Secondary" />
              </l:XYToolGroup>
              <c:XYButton Content="B1" Variant="Secondary" />
            </l:XYToolbar>
            <l:XYPanel Background="{DynamicResource XY.Brush.Surface.Panel}" CornerRadius="3">
              <TextBlock Text="Touch Panel" Classes="xyui-text-caption" />
            </l:XYPanel>
          </l:XYSectionGroup>
        </Border>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
