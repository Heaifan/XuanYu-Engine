<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             xmlns:xy="using:XYUI.Avalonia"
             x:Class="XYUI.Avalonia.Gallery.Views.SpacingDensityCompareSection">
  <Border Classes="xyui-surface-panel" Padding="14,10" CornerRadius="6">
    <StackPanel Spacing="8">
      <TextBlock Text="③ 同一布局 · 三种空间密度" Classes="xyui-text-section" FontSize="15" />
      <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
        <!-- 1. Compact Column -->
        <Border Grid.Column="0" xy:XY.Density="Compact" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10,8" Margin="0,0,6,0" CornerRadius="4">
          <StackPanel Spacing="6">
            <TextBlock Text="紧凑 · 2 / 6 / 12" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <c:XYButton Content="A1" Variant="Secondary" />
              <c:XYButton Content="A2" Variant="Secondary" />
              <c:XYButton Content="A3" Variant="Secondary" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 2. Default Column -->
        <Border Grid.Column="1" xy:XY.Density="Default" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10,8" Margin="3,0,3,0" CornerRadius="4">
          <StackPanel Spacing="6">
            <TextBlock Text="默认 · 4 / 8 / 16" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:XYButton Content="A1" Variant="Secondary" />
              <c:XYButton Content="A2" Variant="Secondary" />
              <c:XYButton Content="A3" Variant="Secondary" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 3. Comfortable Column -->
        <Border Grid.Column="2" xy:XY.Density="Comfortable" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10,8" Margin="6,0,0,0" CornerRadius="4">
          <StackPanel Spacing="6">
            <TextBlock Text="舒适 · 6 / 12 / 20" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:XYButton Content="A1" Variant="Secondary" />
              <c:XYButton Content="A2" Variant="Secondary" />
              <c:XYButton Content="A3" Variant="Secondary" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>