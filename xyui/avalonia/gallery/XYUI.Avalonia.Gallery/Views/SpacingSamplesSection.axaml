<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             x:Class="XYUI.Avalonia.Gallery.Views.SpacingSamplesSection">
  <StackPanel Spacing="{DynamicResource XY.Gap.Section}">
    <!-- ③ Toolbar 真实视觉样例 -->
    <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}">
      <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
        <TextBlock Text="③ Toolbar 示例 (ToolItem: 按钮间距 / ToolGroup: 功能分组间距)" Classes="xyui-text-section" />
        <Border Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Height="{DynamicResource XY.Size.Toolbar}" Padding="4,2">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.ToolGroup}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.ToolItem}">
              <c:XYIconButton Content="＋" AutomationProperties.Name="新建" />
              <c:XYIconButton Content="💾" AutomationProperties.Name="保存" />
            </StackPanel>
            <c:XYSeparator Width="8" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.ToolItem}">
              <c:XYButton Content="撤销" Variant="Secondary" />
              <c:XYButton Content="重做" Variant="Secondary" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- ④ Form 真实视觉样例 -->
    <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}">
      <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
        <TextBlock Text="④ Form 示例 (Field Gap: 字段垂直间距 / IconText: 图文对齐)" Classes="xyui-text-section" />
        <Border Background="{DynamicResource XY.Brush.Surface.Panel}" Padding="{DynamicResource XY.Padding.Panel}">
          <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
            <Grid ColumnDefinitions="90,*" Margin="0,2">
              <c:XYLabel Text="实体标识" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="Player_Spawn_01" Height="28" />
            </Grid>
            <Grid ColumnDefinitions="90,*" Margin="0,2">
              <c:XYLabel Text="坐标位置" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.Field}">
                <TextBox Text="1024.0" Width="80" Height="28" />
                <TextBox Text="2048.0" Width="80" Height="28" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- ⑤ Panel / Section 真实视觉样例 -->
    <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}">
      <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
        <TextBlock Text="⑤ Panel / Section 示例 (Padding.Panel: 容器内边距 / Section Gap: 区块间距)" Classes="xyui-text-section" />
        <Border Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="{DynamicResource XY.Padding.Panel}">
          <StackPanel Spacing="{DynamicResource XY.Gap.Section}">
            <Border Background="{DynamicResource XY.Brush.Surface.Raised}" Padding="{DynamicResource XY.Padding.Panel}">
              <TextBlock Text="Section A (上方独立区块)" Classes="xyui-text-caption" />
            </Border>
            <Border Background="{DynamicResource XY.Brush.Surface.Raised}" Padding="{DynamicResource XY.Padding.Panel}">
              <TextBlock Text="Section B (下方独立区块，由 XY.Gap.Section 隔开)" Classes="xyui-text-caption" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
