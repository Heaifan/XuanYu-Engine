<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XYUI.Avalonia.Gallery.Views.ShapeCoreRulesSection">
  <StackPanel Spacing="8">
    <TextBlock Text="01 · 核心规则 (Core Rules)" Classes="xyui-text-section" FontSize="16" FontWeight="Bold" />
    <Grid ColumnDefinitions="*,*,*,*">
      <Border Grid.Column="0" Margin="0,0,6,0" Classes="xyui-surface-subtle xyui-border-default" CornerRadius="8" Padding="14,10">
        <StackPanel Spacing="4">
          <TextBlock Text="A · Shape ≠ Radius" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="Shape 决定轮廓语义；Radius 只决定转角的柔和程度，不能互相替代。" Classes="xyui-text-body" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Margin="3,0,3,0" Classes="xyui-surface-subtle xyui-border-default" CornerRadius="8" Padding="14,10">
        <StackPanel Spacing="4">
          <TextBlock Text="B · Shape ≠ Surface" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="Surface 负责表面层级与背景承载，Shape 负责几何外形与适用场景。" Classes="xyui-text-body" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Margin="3,0,3,0" Classes="xyui-surface-subtle xyui-border-default" CornerRadius="8" Padding="14,10">
        <StackPanel Spacing="4">
          <TextBlock Text="C · 同内容，不同形态" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="同样的内容放进矩形、胶囊、圆形时，语义和可用性会发生变化。" Classes="xyui-text-body" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Margin="6,0,0,0" Classes="xyui-surface-subtle xyui-border-default" CornerRadius="8" Padding="14,10">
        <StackPanel Spacing="4">
          <TextBlock Text="D · 不制造第二真值" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="没有 Canonical Shape API 前，不要自行发明全局写法或统一 Geometry。" Classes="xyui-text-body" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
