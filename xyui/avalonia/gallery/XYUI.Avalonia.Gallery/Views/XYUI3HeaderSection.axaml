<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:XYUI.Avalonia.Gallery"
             x:Class="XYUI.Avalonia.Gallery.Views.XYUI3HeaderSection"
             x:DataType="g:XYUI1ComponentDocument">
  <Border Classes="xyui-surface-panel" Padding="16,14" CornerRadius="6">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="{Binding DisplayId}" Classes="xyui-text-code" FontWeight="Bold" />
        <TextBlock Grid.Column="2" Text="{Binding Category}" Classes="xyui-text-caption" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding AvaloniaType}" Classes="xyui-heading-page" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="{Binding ChineseName, StringFormat='· {0}'}" Classes="xyui-heading-page" FontSize="20" Foreground="{DynamicResource XY.Brush.Text.Secondary}" />
      </StackPanel>
      <TextBlock Text="{Binding Overview}" Classes="xyui-text-body" TextWrapping="Wrap" />
      <Border Classes="xyui-surface-panel" Padding="10,6" CornerRadius="4">
        <TextBlock Text="{Binding WhenToUse, StringFormat='适用场景：{0}'}" Classes="xyui-text-caption" TextWrapping="Wrap" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
        <TextBlock Text="{Binding StatusText}" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Accent.Strong}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding KnownGap, StringFormat='({0})'}" IsVisible="{Binding HasKnownGap}" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Semantic.Danger.Text}" FontWeight="Bold" />
        <TextBlock Text="{Binding VisualStatus, StringFormat='· {0}'}" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Semantic.Success.Text}" FontWeight="Bold" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
