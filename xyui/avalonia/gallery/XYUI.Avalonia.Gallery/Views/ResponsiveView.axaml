<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:XYUI.Avalonia.Gallery.Views"
             x:Class="XYUI.Avalonia.Gallery.Views.ResponsiveView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="{DynamicResource XY.Space.3}" Margin="0,0,12,16">
      <!-- 头部：标题与 Badge -->
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="响应式 / Responsive" Classes="xyui-heading-page" FontSize="22" FontWeight="Bold" />
          <Border Background="#F6F1E7" BorderBrush="#E6D8BA" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
            <TextBlock Text="已锁定 · 0.11" FontWeight="Bold" FontSize="11" Foreground="#806A3A" />
          </Border>
        </StackPanel>
        <TextBlock Text="响应式根据可用容器空间重排信息；优先改变布局，不随意缩小内容本身。"
                   Classes="xyui-text-caption" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Developer Quick Start 三列横幅 -->
      <Border Background="#F8FAFB" BorderBrush="#E0E8EC" BorderThickness="1" CornerRadius="8" Padding="14,10">
        <Grid ColumnDefinitions="*,Auto,*,Auto,*">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="先看可用宽度" FontWeight="Bold" FontSize="12" Foreground="#355364" />
            <TextBlock Text="Container Width → Reflow，不先判断“设备类型”" Classes="xyui-text-caption" FontSize="11" />
          </StackPanel>
          <Rectangle Grid.Column="1" Width="1" Fill="#E2E9EC" Margin="10,0" />
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Text="Responsive ≠ Size / Density" FontWeight="Bold" FontSize="12" Foreground="#355364" />
            <TextBlock Text="响应式改变布局关系；Size / Density 仍保持各自独立语义" Classes="xyui-text-caption" FontSize="11" />
          </StackPanel>
          <Rectangle Grid.Column="3" Width="1" Fill="#E2E9EC" Margin="10,0" />
          <StackPanel Grid.Column="4" Spacing="2">
            <TextBlock Text="AdaptiveLayout" FontWeight="Bold" FontSize="12" Foreground="#355364" />
            <TextBlock Text="MinItemWidth + MaxColumns 自动 Reflow" Classes="xyui-text-caption" FontSize="11" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 01 · 核心规则 -->
      <views:ResponsiveCoreRulesSection />

      <!-- 02 · Reflow Lab / 真实 AdaptiveLayout 容器驱动 -->
      <views:ResponsiveLiveLabSection />

      <!-- 03 · 决策矩阵 -->
      <views:ResponsiveDecisionMatrixSection />

      <!-- 04 · 怎么使用 / 高级 / 禁止 -->
      <views:ResponsiveCodePatternsSection />
    </StackPanel>
  </ScrollViewer>
</UserControl>