<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:XYUI.Avalonia.Gallery"
             x:Class="XYUI.Avalonia.Gallery.Views.XYUI3LiveExamplesSection"
             x:DataType="g:XYUI1ComponentDocument">
  <Border Classes="xyui-surface-panel" Padding="16,14" CornerRadius="6" IsVisible="{Binding HasLiveExamples}">
    <StackPanel Spacing="10">
      <StackPanel Spacing="2">
        <TextBlock Text="03 · LIVE EXAMPLES" Classes="xyui-text-section" FontWeight="{DynamicResource XY.FontWeight.Bold}" />
        <TextBlock Text="业务场景实装 · 真实绑定 Codex Runtime 交互" Classes="xyui-text-caption" />
      </StackPanel>
      <ContentControl x:Name="LiveHost" HorizontalContentAlignment="Left" />
    </StackPanel>
  </Border>
</UserControl>
