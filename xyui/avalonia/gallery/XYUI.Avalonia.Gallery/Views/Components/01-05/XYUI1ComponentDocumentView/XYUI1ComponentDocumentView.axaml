<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:XYUI.Avalonia.Gallery.Views"
             xmlns:g="using:XYUI.Avalonia.Gallery"
             x:Class="XYUI.Avalonia.Gallery.Views.XYUI1ComponentDocumentView"
             x:DataType="g:XYUI1ComponentDocument">
  <views:GalleryDocumentShell x:Name="DocScrollViewer">
    <StackPanel Margin="24" Spacing="14">
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="{Binding Id}" Classes="xyui-text-code" />
            <TextBlock Grid.Column="2" Text="{Binding Category}" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Text.Tertiary}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding AvaloniaType}" Classes="xyui-heading-page" />
            <TextBlock Text="{Binding ChineseName, StringFormat='· {0}'}" Classes="xyui-heading-page" Foreground="{DynamicResource XY.Brush.Text.Secondary}" />
          </StackPanel>
          <TextBlock Text="{Binding Overview}" Classes="xyui-text-body" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
            <TextBlock Text="{Binding StatusText}" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="{Binding KnownGap, StringFormat='({0})'}" IsVisible="{Binding HasKnownGap}" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="{Binding VisualStatus, StringFormat='· {0}'}" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Semantic.Success.Text}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Text="DEVELOPER QUICK START" Classes="xyui-text-section" />
          <Grid ColumnDefinitions="48*,16,52*" MinHeight="52">
            <Border Grid.Column="0" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="12,10" CornerRadius="4">
              <TextBlock Text="{Binding QuickStartXaml}" Classes="xyui-text-code" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="12,10" CornerRadius="4">
              <ContentControl x:Name="PreviewHost" HorizontalContentAlignment="Left" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6" IsVisible="{Binding HasCoreRules}">
        <StackPanel Spacing="8">
          <TextBlock Text="01 CORE RULES" Classes="xyui-text-section" />
          <ItemsControl ItemsSource="{Binding CoreRules}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="g:XYUIDocRule">
              <views:GalleryRuleRow Margin="0,3"><TextBlock Text="{Binding Title}" Classes="xyui-text-label" TextWrapping="Wrap" VerticalAlignment="Top" /><TextBlock Text="{Binding Content}" Classes="xyui-text-body" TextWrapping="Wrap" VerticalAlignment="Top" /></views:GalleryRuleRow>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6" IsVisible="{Binding HasVariants}">
        <StackPanel Spacing="8">
          <TextBlock Text="02 VARIANTS / ANATOMY" Classes="xyui-text-section" />
          <ItemsControl ItemsSource="{Binding Variants}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="g:XYUIDocVariant">
              <views:GalleryVariantRow Margin="0,3"><TextBlock Text="{Binding Name}" Classes="xyui-text-code" TextWrapping="Wrap" VerticalAlignment="Center" /><TextBlock Text="{Binding Description}" Classes="xyui-text-body" TextWrapping="Wrap" VerticalAlignment="Center" /><TextBlock Text="{Binding Usage}" Classes="xyui-text-caption" TextWrapping="Wrap" VerticalAlignment="Center" /></views:GalleryVariantRow>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Text="03 FOUNDATION &amp; STATES" Classes="xyui-text-section" />
          <ItemsControl ItemsSource="{Binding FoundationMappings}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="g:XYUIDocFoundationItem">
              <views:GalleryTokenRow Margin="0,2"><TextBlock Text="{Binding Concept}" Classes="xyui-text-label" VerticalAlignment="Center" /><TextBlock Text="{Binding FoundationToken}" Classes="xyui-text-code" Foreground="{DynamicResource XY.Brush.Accent.Strong}" VerticalAlignment="Center" /><TextBlock Text="{Binding Description}" Classes="xyui-text-caption" TextWrapping="Wrap" VerticalAlignment="Center" /></views:GalleryTokenRow>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding States}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="g:XYUIDocState">
              <views:GalleryStateRow Margin="0,2"><TextBlock Text="{Binding Name}" Classes="xyui-text-code" VerticalAlignment="Center" /><TextBlock Text="{Binding Description}" Classes="xyui-text-body" TextWrapping="Wrap" VerticalAlignment="Center" /></views:GalleryStateRow>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6" IsVisible="{Binding HasHowToUse}">
        <StackPanel Spacing="8">
          <TextBlock Text="04 HOW TO USE" Classes="xyui-text-section" />
          <ItemsControl ItemsSource="{Binding HowToUse}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="g:XYUIDocGuideItem">
              <views:GalleryRuleRow Margin="0,3"><TextBlock Text="{Binding Category}" Classes="xyui-text-label" TextWrapping="Wrap" VerticalAlignment="Top" /><TextBlock Text="{Binding Description}" Classes="xyui-text-body" TextWrapping="Wrap" VerticalAlignment="Top" /></views:GalleryRuleRow>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="xyui-surface-panel" Padding="16,12" CornerRadius="6" IsVisible="{Binding HasLiveExamples}">
        <StackPanel Spacing="8">
          <TextBlock Text="LIVE EXAMPLES · 业务场景实装" Classes="xyui-text-section" />
          <ContentControl x:Name="LiveExamplesHost" HorizontalContentAlignment="Left" />
        </StackPanel>
      </Border>
    </StackPanel>
  </views:GalleryDocumentShell>
</UserControl>
