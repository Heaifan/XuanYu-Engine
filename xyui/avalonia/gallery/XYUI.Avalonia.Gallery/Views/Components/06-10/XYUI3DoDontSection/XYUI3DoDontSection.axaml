<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:XYUI.Avalonia.Gallery.Views"
             xmlns:g="using:XYUI.Avalonia.Gallery"
             x:Class="XYUI.Avalonia.Gallery.Views.XYUI3DoDontSection"
             x:DataType="g:XYUI1ComponentDocument">
  <Border Classes="xyui-surface-panel" Padding="16,14" CornerRadius="6" IsVisible="{Binding HasDoDonts}">
    <StackPanel Spacing="10">
      <StackPanel Spacing="2">
        <TextBlock Text="05 · DO / DON'T" Classes="xyui-text-section" FontWeight="{DynamicResource XY.FontWeight.Bold}" />
        <TextBlock Text="工程实践指引 · 最佳实践与反模式" Classes="xyui-text-caption" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding DoDonts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="g:XYUIDocDoDont">
            <Border Classes="xyui-surface-panel" Padding="12,10" Margin="0,3" CornerRadius="4">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Category, StringFormat='维度 · {0}'}" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Accent.Strong}" FontWeight="{DynamicResource XY.FontWeight.Semibold}" />
                <views:GalleryDoDontRow>
                  <Border Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10,8" CornerRadius="4">
                    <TextBlock Text="{Binding DoText}" Classes="xyui-text-body" Foreground="{DynamicResource XY.Brush.Semantic.Success.Text}" TextWrapping="Wrap" />
                  </Border>
                  <Border Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10,8" CornerRadius="4">
                    <TextBlock Text="{Binding DontText}" Classes="xyui-text-body" Foreground="{DynamicResource XY.Brush.Semantic.Error.Text}" TextWrapping="Wrap" />
                  </Border>
                </views:GalleryDoDontRow>
                <TextBlock Text="{Binding Rationale, StringFormat='依据与代价：{0}'}" Classes="xyui-text-caption" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
