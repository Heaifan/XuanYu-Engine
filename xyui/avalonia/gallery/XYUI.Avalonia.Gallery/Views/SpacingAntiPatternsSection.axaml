<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             x:Class="XYUI.Avalonia.Gallery.Views.SpacingAntiPatternsSection">
  <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}">
    <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
      <TextBlock Text="⑧ 禁止写法与排版原则 (Anti-patterns &amp; Rules)" Classes="xyui-text-section" />
      <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
        <Border Grid.Column="0" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="8" Margin="0,0,4,0" CornerRadius="4">
          <StackPanel Spacing="4">
            <TextBlock Text="❌ 严禁写法 (硬编码 Margin / 魔法数字)" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Status.Danger}" />
            <TextBlock Text="&lt;!-- ❌ 禁止在控件上手写魔法 Margin --&gt;&#x0a;&lt;XYButton Margin=&quot;0,0,7,0&quot; /&gt;&#x0a;&lt;XYButton Margin=&quot;4,2,6,8&quot; /&gt;" Classes="xyui-text-code" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="8" Margin="4,0,0,0" CornerRadius="4">
          <StackPanel Spacing="4">
            <TextBlock Text="✅ 规范推荐写法 (容器 Spacing 决定间距)" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Status.Success}" />
            <TextBlock Text="&lt;!-- ✅ 由父容器 Spacing 统一度量 --&gt;&#x0a;&lt;StackPanel Orientation=&quot;Horizontal&quot;&#x0a;  Spacing=&quot;{DynamicResource XY.Gap.ToolItem}&quot;&gt;&#x0a;  &lt;XYButton /&gt;&#x0a;&lt;/StackPanel&gt;" Classes="xyui-text-code" FontSize="11" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10,6" CornerRadius="4" Margin="0,4,0,0">
        <StackPanel Spacing="2">
          <TextBlock Text="三大排版原则：" Classes="xyui-text-label" />
          <TextBlock Text="• Padding → 组件/容器内部内边距 (XY.Padding.Panel)" Classes="xyui-text-caption" />
          <TextBlock Text="• Gap     → 兄弟元素之间排列间距 (XY.Gap.ToolItem / ToolGroup / Field / Section)" Classes="xyui-text-caption" />
          <TextBlock Text="• Margin  → 特殊外部关系微调，不得作为常规组件间距手段" Classes="xyui-text-caption" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
