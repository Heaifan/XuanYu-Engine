<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             x:Class="XYUI.Avalonia.Gallery.Views.SpacingIntroSection">
  <StackPanel Spacing="{DynamicResource XY.Gap.Section}">
    <!-- ① 这是什么 / 解决什么问题 -->
    <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}" Background="{DynamicResource XY.Brush.Surface.Panel}">
      <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
        <TextBlock Text="① 这是什么：语义间距与布局原则" Classes="xyui-text-section" />
        <TextBlock Text="不再手写 4/6/8 DIP 等魔法数字。开发者只描述“控件之间是什么关系”，XYUI 根据 Semantic Token 与当前 Density 档位自动决定精确距离。"
                   Classes="xyui-text-body" TextWrapping="Wrap" />
        <Border Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10,6" CornerRadius="4">
          <Grid ColumnDefinitions="140,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="同组工具项" Classes="xyui-text-caption" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text=" → " Classes="xyui-text-caption" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="XY.Gap.ToolItem (2/4/6 DIP)" Classes="xyui-text-code" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="工具组之间" Classes="xyui-text-caption" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text=" → " Classes="xyui-text-caption" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="XY.Gap.ToolGroup (6/8/12 DIP)" Classes="xyui-text-code" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Icon 与文字" Classes="xyui-text-caption" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text=" → " Classes="xyui-text-caption" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="XY.Gap.IconText (4/4/6 DIP)" Classes="xyui-text-code" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="表单字段之间" Classes="xyui-text-caption" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text=" → " Classes="xyui-text-caption" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="XY.Gap.Field (6/8/12 DIP)" Classes="xyui-text-code" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="区块之间" Classes="xyui-text-caption" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text=" → " Classes="xyui-text-caption" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="XY.Gap.Section (12/16/20 DIP)" Classes="xyui-text-code" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Panel 内边距" Classes="xyui-text-caption" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text=" → " Classes="xyui-text-caption" />
            <TextBlock Grid.Row="5" Grid.Column="2" Text="XY.Padding.Panel (12/16/20 DIP)" Classes="xyui-text-code" />
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <!-- ② 基本用法 XAML 代码 -->
    <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}">
      <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
        <TextBlock Text="② 基本用法：XAML 推荐写法" Classes="xyui-text-section" />
        <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
          <Border Grid.Column="0" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="8" Margin="0,0,4,0" CornerRadius="4">
            <StackPanel Spacing="4">
              <TextBlock Text="Toolbar 间距" Classes="xyui-text-label" />
              <TextBlock Text="&lt;StackPanel&#x0a;  Orientation=&quot;Horizontal&quot;&#x0a;  Spacing=&quot;{DynamicResource&#x0a;    XY.Gap.ToolItem}&quot;&gt;" Classes="xyui-text-code" FontSize="11" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="8" Margin="2,0,2,0" CornerRadius="4">
            <StackPanel Spacing="4">
              <TextBlock Text="Form 字段间距" Classes="xyui-text-label" />
              <TextBlock Text="&lt;StackPanel&#x0a;  Orientation=&quot;Vertical&quot;&#x0a;  Spacing=&quot;{DynamicResource&#x0a;    XY.Gap.Field}&quot;&gt;" Classes="xyui-text-code" FontSize="11" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="8" Margin="4,0,0,0" CornerRadius="4">
            <StackPanel Spacing="4">
              <TextBlock Text="Panel 内边距" Classes="xyui-text-label" />
              <TextBlock Text="&lt;Border&#x0a;  Padding=&quot;{DynamicResource&#x0a;    XY.Padding.Panel}&quot;&gt;" Classes="xyui-text-code" FontSize="11" />
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
