<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             x:Class="XYUI.Avalonia.Gallery.Views.SpacingUsageGuideSection">
  <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}">
    <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
      <TextBlock Text="④ 推荐基本用法 vs ⑤ 高级 Token 用法" Classes="xyui-text-section" />
      <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
        <!-- Recommended / Default Semantic Container Concept -->
        <Border Grid.Column="0" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10" Margin="0,0,4,0" CornerRadius="4">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="④ 推荐首选：语义容器" Classes="xyui-text-label" />
              <Border Background="{DynamicResource XY.Brush.Accent.Soft}" Padding="4,1" CornerRadius="2">
                <TextBlock Text="Recommended" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Accent.Strong}" FontSize="10" />
              </Border>
            </StackPanel>
            <TextBlock Text="业务层优先使用语义容器，免去手工绑定 Token：" Classes="xyui-text-caption" />
            <Border Background="{DynamicResource XY.Brush.Surface.Panel}" Padding="6" CornerRadius="3">
              <TextBlock Text="&lt;xy:XYToolGroup&gt;&#x0a;  &lt;xy:XYIconButton /&gt;&#x0a;  &lt;xy:XYIconButton /&gt;&#x0a;&lt;/xy:XYToolGroup&gt;&#x0a;&#x0a;&lt;xy:XYFieldGroup&gt; ... &lt;/xy:XYFieldGroup&gt;&#x0a;&lt;xy:XYPanel&gt; ... &lt;/xy:XYPanel&gt;"
                         Classes="xyui-text-code" FontSize="11" />
            </Border>
          </StackPanel>
        </Border>

        <!-- Advanced / Custom Semantic Token Concept -->
        <Border Grid.Column="1" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10" Margin="4,0,0,0" CornerRadius="4">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="⑤ 高级用法：Semantic Token" Classes="xyui-text-label" />
              <Border Background="{DynamicResource XY.Brush.Surface.Raised}" Padding="4,1" CornerRadius="2">
                <TextBlock Text="Advanced Layout" Classes="xyui-text-caption" FontSize="10" />
              </Border>
            </StackPanel>
            <TextBlock Text="自定义灵活排版时直接消费底层语义 Token：" Classes="xyui-text-caption" />
            <Border Background="{DynamicResource XY.Brush.Surface.Panel}" Padding="6" CornerRadius="3">
              <TextBlock Text="&lt;StackPanel&#x0a;  Orientation=&quot;Horizontal&quot;&#x0a;  Spacing=&quot;{DynamicResource&#x0a;    XY.Gap.ToolItem}&quot;&gt;&#x0a;  &lt;xy:XYButton ... /&gt;&#x0a;&lt;/StackPanel&gt;"
                         Classes="xyui-text-code" FontSize="11" />
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
