<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XYUI.Avalonia.Gallery.Views.IconographyCoreRulesSection">
  <Border Classes="xyui-surface-panel" Padding="14,12" CornerRadius="6">
    <StackPanel Spacing="10">
      <TextBlock Text="① 核心规则" Classes="xyui-text-section" FontSize="16" FontWeight="Bold" />
      <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
        <!-- 1. 图标尺寸 -->
        <Border Grid.Column="0" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="12,10" Margin="0,0,6,0" CornerRadius="4">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="图标尺寸" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="14 / 16 / 20 / 24 DIP" Classes="xyui-text-caption" />
          </StackPanel>
        </Border>

        <!-- 2. 单一真值 -->
        <Border Grid.Column="1" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="12,10" Margin="3,0,3,0" CornerRadius="4">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="单一真值" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="XYIcon + Canonical Icon Registry" Classes="xyui-text-caption" />
          </StackPanel>
        </Border>

        <!-- 3. 复用原则 -->
        <Border Grid.Column="2" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="12,10" Margin="6,0,0,0" CornerRadius="4">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="复用原则" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="组件消费 Registry，不自行重画" Classes="xyui-text-caption" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>