<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             x:Class="XYUI.Avalonia.Gallery.Views.IconographyCoreRulesSection">
  <Border Classes="xyui-surface-panel" Padding="14,10" CornerRadius="6">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="① 核心规则" Classes="xyui-text-section" FontSize="15" />
        <Border Grid.Column="1" Background="{DynamicResource XY.Brush.Accent.Soft}" BorderBrush="{DynamicResource XY.Brush.Accent.Default}" BorderThickness="1" CornerRadius="4" Padding="8,2">
          <TextBlock Text="统一尺寸、视觉重量、Viewport 与光学居中" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
        </Border>
      </Grid>
      <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
          <TextBlock Text="图标尺寸" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="14 / 16 / 20 / 24 DIP" Classes="xyui-text-caption" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBlock Text="图标真值" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="XYIcon + Vector Icon Registry" Classes="xyui-text-caption" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <TextBlock Text="复用原则" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="组件消费，不自行重画" Classes="xyui-text-caption" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>