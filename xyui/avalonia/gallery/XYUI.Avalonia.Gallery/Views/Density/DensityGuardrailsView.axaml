<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XYUI.Avalonia.Gallery.Views.Density.DensityGuardrailsView">
  <Border Classes="xyui-surface-panel" Padding="14,10" CornerRadius="6">
    <StackPanel Spacing="8">
      <TextBlock Text="④ 推荐原则与禁止护栏" Classes="xyui-text-section" FontSize="15" />
      <Grid ColumnDefinitions="360,*">
        <!-- 推荐 -->
        <Border Grid.Column="0" Background="{DynamicResource XY.Brush.Accent.Soft}" BorderBrush="{DynamicResource XY.Brush.Accent.Default}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,12,0">
          <StackPanel Spacing="2">
            <TextBlock Text="推荐" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="提高有效信息量，不是单纯压缩像素。" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          </StackPanel>
        </Border>

        <!-- 6 个禁止 -->
        <Grid Grid.Column="1" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="4" VerticalAlignment="Center">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="× 不缩小字号" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.State.Danger.Text}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="× 不缩小命中区" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.State.Danger.Text}" />

          <TextBlock Grid.Row="0" Grid.Column="1" Text="× 不写 Height 魔法数字" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.State.Danger.Text}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="× 不隐藏关键状态" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.State.Danger.Text}" />

          <TextBlock Grid.Row="0" Grid.Column="2" Text="× 不强压全部单行" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.State.Danger.Text}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="× 不制造巨量滚动" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.State.Danger.Text}" />
        </Grid>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>