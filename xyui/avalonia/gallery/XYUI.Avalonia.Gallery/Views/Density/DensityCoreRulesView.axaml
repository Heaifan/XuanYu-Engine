<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             x:Class="XYUI.Avalonia.Gallery.Views.Density.DensityCoreRulesView">
  <Border Classes="xyui-surface-panel" Padding="14,10" CornerRadius="6">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="① 核心规则" Classes="xyui-text-section" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Border Background="{DynamicResource XY.Brush.Surface.Raised}" BorderBrush="{DynamicResource XY.Brush.Border.Color.Default}" BorderThickness="1" CornerRadius="4" Padding="8,3">
            <TextBlock Text="示例: xy:XY.Size=&quot;Default&quot;" Classes="xyui-text-code" Foreground="{DynamicResource XY.Brush.Text.Primary}" FontSize="11" />
          </Border>
          <Border Background="{DynamicResource XY.Brush.Accent.Soft}" BorderBrush="{DynamicResource XY.Brush.Accent.Default}" BorderThickness="1" CornerRadius="4" Padding="8,3">
            <TextBlock Text="示例: xy:XY.Density=&quot;Compact&quot;" Classes="xyui-text-code" Foreground="{DynamicResource XY.Brush.Accent.Strong}" FontSize="11" />
          </Border>
        </StackPanel>
      </Grid>
      <TextBlock Text="固定控件尺寸，只改变信息组织密度。" Classes="xyui-heading-panel" Foreground="{DynamicResource XY.Brush.Text.Primary}" FontSize="16" />
      <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
          <TextBlock Text="信息密度" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="决定同屏信息怎么组织" Classes="xyui-text-caption" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBlock Text="空间关系" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="决定元素之间隔多远" Classes="xyui-text-caption" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <TextBlock Text="控件尺寸" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="决定控件自己多大" Classes="xyui-text-caption" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>