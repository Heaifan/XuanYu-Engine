<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XYUI.Avalonia.Gallery.Views.StatesCoreRulesSection">
  <StackPanel Spacing="8">
    <TextBlock Text="01 · 核心规则 (Core Rules)" Classes="xyui-text-section" FontSize="16" FontWeight="Bold" />
    <Grid ColumnDefinitions="*,*,*,*">
      <Border Grid.Column="0" Margin="0,0,6,0" Classes="xyui-surface-subtle xyui-border-default" CornerRadius="8" Padding="14,10">
        <StackPanel Spacing="4">
          <TextBlock Text="A · 语义可共存" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="Selected + Hover + Focus 可以同时成立，不需要业务手工合成视觉。" Classes="xyui-text-body" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Margin="3,0,3,0" Classes="xyui-surface-subtle xyui-border-default" CornerRadius="8" Padding="14,10">
        <StackPanel Spacing="4">
          <TextBlock Text="B · 视觉单解析" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="Background / Border / Foreground 各自只输出一个最终结果。" Classes="xyui-text-body" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Margin="3,0,3,0" Classes="xyui-surface-subtle xyui-border-default" CornerRadius="8" Padding="14,10">
        <StackPanel Spacing="4">
          <TextBlock Text="C · Focus 独立" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="Focus 通过独立 Outline 通道表达，不覆盖 Selection，不推动布局。" Classes="xyui-text-body" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Margin="6,0,0,0" Classes="xyui-surface-subtle xyui-border-default" CornerRadius="8" Padding="14,10">
        <StackPanel Spacing="4">
          <TextBlock Text="D · 状态不改尺寸" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="Hover / Pressed / Focus / Disabled 不得通过 Height / Padding 制造效果。" Classes="xyui-text-body" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
