<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:XYUI.Avalonia.Gallery.Views"
             x:Class="XYUI.Avalonia.Gallery.Views.IconographyView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="{DynamicResource XY.Space.3}" Margin="0,0,12,16">
      <!-- 标题 -->
      <StackPanel Spacing="3">
        <TextBlock Text="XYUI-0.06 · 图标体系" Classes="xyui-heading-panel" FontSize="22" />
        <TextBlock Text="统一尺寸、视觉重量、Viewport 与光学居中" Classes="xyui-text-caption" />
      </StackPanel>

      <!-- ① 核心规则 -->
      <views:IconographyCoreRulesSection />

      <!-- ② 图标规格阶梯 (Codex Section) -->
      <views:IconographySpecSection />

      <!-- ③ 真实消费 + 光学对齐 (左: Usage, 右: Optical) -->
      <Grid ColumnDefinitions="1.6*,*">
        <views:IconographyUsageSection Grid.Column="0" Margin="0,0,8,0" />
        <views:IconographyOpticalSection Grid.Column="1" />
      </Grid>

      <!-- ④ 推荐写法 + 禁止护栏 -->
      <views:IconographyGuardrailsSection />
    </StackPanel>
  </ScrollViewer>
</UserControl>