<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             x:Class="XYUI.Avalonia.Gallery.Views.SizingCodePatternsSection">
  <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}">
    <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
      <TextBlock Text="④ 推荐写法 · 高级用法 · 禁止写法" Classes="xyui-text-section" />
      <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
        <!-- 1. Recommended -->
        <Border Grid.Column="0" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10" Margin="0,0,4,0" CornerRadius="4">
          <StackPanel Spacing="4">
            <TextBlock Text="推荐首选 (Recommended)" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="&lt;Panel xy:XY.Size=&quot;Default&quot;&gt;&#x0a;  &lt;xy:XYButton Content=&quot;保存&quot; /&gt;&#x0a;&lt;/Panel&gt;" Classes="xyui-text-code" FontSize="11" />
            <TextBlock Text="由 XY.Size 附加属性继承统一管理容器内控件尺寸。" Classes="xyui-text-caption" />
          </StackPanel>
        </Border>

        <!-- 2. Advanced -->
        <Border Grid.Column="1" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10" Margin="2,0,2,0" CornerRadius="4">
          <StackPanel Spacing="4">
            <TextBlock Text="特定覆盖 (Advanced)" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="&lt;xy:XYButton&#x0a;  xy:XY.Size=&quot;Compact&quot;&#x0a;  Content=&quot;辅助&quot; /&gt;" Classes="xyui-text-code" FontSize="11" />
            <TextBlock Text="单体控件可按需直接声明 XY.Size 局部覆盖继承。" Classes="xyui-text-caption" />
          </StackPanel>
        </Border>

        <!-- 3. Forbidden -->
        <Border Grid.Column="2" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10" Margin="4,0,0,0" CornerRadius="4">
          <StackPanel Spacing="4">
            <TextBlock Text="严禁写法 (Forbidden)" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Status.Danger}" />
            <TextBlock Text="&lt;xy:XYButton&#x0a;  Height=&quot;31&quot;&#x0a;  Width=&quot;87&quot; /&gt;" Classes="xyui-text-code" FontSize="11" />
            <TextBlock Text="严禁手写魔法尺寸与写死宽度破坏系统阶梯。" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Text.Tertiary}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>