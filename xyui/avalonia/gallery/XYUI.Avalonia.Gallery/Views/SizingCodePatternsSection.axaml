<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             x:Class="XYUI.Avalonia.Gallery.Views.SizingCodePatternsSection">
  <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}">
    <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
      <TextBlock Text="④ 推荐写法 · 高级用法 · 禁止写法" Classes="xyui-text-section" />
      <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
        <!-- 1. Recommended -->
        <Border Grid.Column="0" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10" Margin="0,0,4,0" CornerRadius="4">
          <StackPanel Spacing="4">
            <TextBlock Text="Recommended (首选)" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="&lt;xy:XYButton&#x0a;  SizeRole=&quot;Default&quot;&#x0a;  Content=&quot;保存工程&quot; /&gt;" Classes="xyui-text-code" FontSize="11" />
            <TextBlock Text="由 SizeRole 统一控制控件高度与命中区域。" Classes="xyui-text-caption" />
          </StackPanel>
        </Border>

        <!-- 2. Advanced -->
        <Border Grid.Column="1" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10" Margin="2,0,2,0" CornerRadius="4">
          <StackPanel Spacing="4">
            <TextBlock Text="Advanced (高级)" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
            <TextBlock Text="&lt;xy:XYButton&#x0a;  Height=&quot;{DynamicResource&#x0a;    XY.Size.Control.M}&quot; /&gt;" Classes="xyui-text-code" FontSize="11" />
            <TextBlock Text="特殊独立布局按需消费底层尺寸 Token。" Classes="xyui-text-caption" />
          </StackPanel>
        </Border>

        <!-- 3. Forbidden -->
        <Border Grid.Column="2" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="10" Margin="4,0,0,0" CornerRadius="4">
          <StackPanel Spacing="4">
            <TextBlock Text="Forbidden (严禁)" Classes="xyui-text-label" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Status.Danger}" />
            <TextBlock Text="&lt;xy:XYButton&#x0a;  Height=&quot;31&quot;&#x0a;  Width=&quot;87&quot; /&gt;" Classes="xyui-text-code" FontSize="11" />
            <TextBlock Text="严禁手写魔法尺寸数字与写死宽度。" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Text.Tertiary}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
