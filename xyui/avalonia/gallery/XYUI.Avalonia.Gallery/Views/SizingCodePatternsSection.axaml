<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XYUI.Avalonia.Gallery.Views.SizingCodePatternsSection">
  <Border Classes="xyui-surface-panel" Padding="14,10" CornerRadius="6">
    <StackPanel Spacing="6">
      <TextBlock Text="④ 推荐写法 · 高级用法 · 禁止写法" Classes="xyui-text-section" FontSize="15" />
      <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
        <TextBlock Grid.Column="0" Text="✓ xy:XY.Size=&quot;Default&quot;" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
        <TextBlock Grid.Column="1" Text="高级：局部 Size Override" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.Text.Secondary}" />
        <TextBlock Grid.Column="2" Text="× Height=&quot;31&quot; · × Width=&quot;87&quot;" Classes="xyui-text-caption" Foreground="{DynamicResource XY.Brush.State.Danger.Text}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>