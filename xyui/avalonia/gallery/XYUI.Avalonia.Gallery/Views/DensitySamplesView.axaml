<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:density="using:XYUI.Avalonia.Gallery.Views.Density"
             x:Class="XYUI.Avalonia.Gallery.Views.DensitySamplesView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="{DynamicResource XY.Space.3}" Margin="0,0,12,16">
      <density:DensityCoreRulesView />
      <density:DensityLabView />
      <density:DensityMatrixView />
      <density:DensityGuardrailsView />
    </StackPanel>
  </ScrollViewer>
</UserControl>
