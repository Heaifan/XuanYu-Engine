<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XYUI.Avalonia.Gallery.Views.ShapeScenariosSection">
  <StackPanel Spacing="4">
    <TextBlock Text="场景判断" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
    <Grid ColumnDefinitions="*,*,*">
      <Border Grid.Column="0" Margin="0,0,4,0" Background="{DynamicResource XY.Brush.Surface.App}" Classes="xyui-border-default" CornerRadius="6" Padding="10,6">
        <StackPanel Spacing="2">
          <TextBlock Text="大内容承载" FontWeight="Bold" FontSize="12" />
          <TextBlock Text="优先：矩形 / 柔角矩形" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Text="原因：更稳定，适合标题 + 说明 + 操作组合" Classes="xyui-text-caption" FontSize="10" />
          <TextBlock Text="避免：强行把长文本塞进圆形或极短胶囊" Classes="xyui-text-caption" FontSize="10" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Margin="2,0,2,0" Background="{DynamicResource XY.Brush.Surface.App}" Classes="xyui-border-default" CornerRadius="6" Padding="10,6">
        <StackPanel Spacing="2">
          <TextBlock Text="短标签 / 过滤条件" FontWeight="Bold" FontSize="12" />
          <TextBlock Text="优先：胶囊 / 柔角矩形" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Text="原因：轻量、可扫读，适合单行短文案" Classes="xyui-text-caption" FontSize="10" />
          <TextBlock Text="避免：用巨大的 Radius 把所有东西都做成胶囊" Classes="xyui-text-caption" FontSize="10" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Margin="4,0,0,0" Background="{DynamicResource XY.Brush.Surface.App}" Classes="xyui-border-default" CornerRadius="6" Padding="10,6">
        <StackPanel Spacing="2">
          <TextBlock Text="图标 / 计数 / 点状语义" FontWeight="Bold" FontSize="12" />
          <TextBlock Text="优先：圆形 / 方形 / 小胶囊" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Text="原因：语义集中，空间紧凑" Classes="xyui-text-caption" FontSize="10" />
          <TextBlock Text="避免：把复杂信息塞进极小几何容器" Classes="xyui-text-caption" FontSize="10" />
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
