<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XYUI.Avalonia.Gallery.Views.SurfaceCoreRulesSection">
  <StackPanel Spacing="8">
    <TextBlock Text="01 · 核心规则" Classes="xyui-text-section" FontSize="16" FontWeight="Bold" />
    <Grid ColumnDefinitions="*,*,*,*">
      <Border Grid.Column="0" Margin="0,0,6,0" Classes="xyui-surface-subtle xyui-border-default" CornerRadius="8" Padding="14,10">
        <StackPanel Spacing="4">
          <TextBlock Text="A · 层级优先" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="先根据内容关系选择 Surface，不是先挑“看起来喜欢的背景色”。" Classes="xyui-text-body" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Margin="3,0,3,0" Classes="xyui-surface-subtle xyui-border-default" CornerRadius="8" Padding="14,10">
        <StackPanel Spacing="4">
          <TextBlock Text="B · Surface ≠ Elevation 数值" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="XYUI 用语义层级表达承载关系，开发者不直接管理任意 z / 阴影数值。" Classes="xyui-text-body" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Margin="3,0,3,0" Classes="xyui-surface-subtle xyui-border-default" CornerRadius="8" Padding="14,10">
        <StackPanel Spacing="4">
          <TextBlock Text="C · Popup 是浮层语义" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="Popup / Tooltip 脱离普通面板流，不能用 Raised 卡片随意替代。" Classes="xyui-text-body" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Margin="6,0,0,0" Classes="xyui-surface-subtle xyui-border-default" CornerRadius="8" Padding="14,10">
        <StackPanel Spacing="4">
          <TextBlock Text="D · 不制造第二真值" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
          <TextBlock Text="背景色、边框、阴影都从 Canonical Surface 语义派生，不在业务页复制。" Classes="xyui-text-body" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
