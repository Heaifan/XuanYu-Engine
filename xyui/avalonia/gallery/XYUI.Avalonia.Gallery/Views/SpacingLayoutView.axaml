<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             xmlns:views="using:XYUI.Avalonia.Gallery.Views"
             x:Class="XYUI.Avalonia.Gallery.Views.SpacingLayoutView"
             x:DataType="views:SpacingMetricsViewModel">
  <ScrollViewer>
    <StackPanel Margin="{DynamicResource XY.Padding.Panel}" Spacing="{DynamicResource XY.Gap.Section}">
      <!-- 页面顶部标头 -->
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.Field}">
        <TextBlock Text="间距与排版视觉规范 (Spacing &amp; Layout Visual Spec)" Classes="xyui-heading-panel" />
        <c:XYStatusBadge Text="LOCKED" State="Success" VerticalAlignment="Center" />
      </StackPanel>

      <!-- ① 三条核心规则 -->
      <views:SpacingCoreRulesSection />

      <!-- ② 大型视觉间距示意 (测量线 / 箭头 / DIP 标尺) -->
      <views:SpacingMeasurementVisualSection />

      <!-- ③ Compact / Comfortable / Touch 真实对比 -->
      <views:SpacingDensityComparisonSection />

      <!-- ④ 推荐基本用法 & ⑤ 高级 Token 用法 -->
      <views:SpacingUsageGuideSection />

      <!-- ⑥ Toolbar / ⑦ Form / ⑧ Panel 真实组件示例 -->
      <views:SpacingRealSamplesSection />

      <!-- ⑨ Semantic Token 完整参考表 -->
      <views:SpacingTokenReferenceSection />

      <!-- ⑩ Anti-pattern 禁止写法与排版阶梯 -->
      <views:SpacingAntiPatternSection />
    </StackPanel>
  </ScrollViewer>
</UserControl>