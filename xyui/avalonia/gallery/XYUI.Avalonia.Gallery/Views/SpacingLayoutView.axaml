<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             xmlns:views="using:XYUI.Avalonia.Gallery.Views"
             x:Class="XYUI.Avalonia.Gallery.Views.SpacingLayoutView"
             x:DataType="views:SpacingMetricsViewModel">
  <ScrollViewer>
    <StackPanel Margin="{DynamicResource XY.Padding.Panel}" Spacing="{DynamicResource XY.Gap.Section}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.Field}">
        <TextBlock Text="间距与排版体系 (Spacing &amp; Layout · 0.03 Locked)" Classes="xyui-heading-panel" />
        <c:XYStatusBadge Text="LOCKED" State="Success" VerticalAlignment="Center" />
      </StackPanel>

      <!-- ① 这是什么 / 解决什么问题 & ② 基本用法 XAML 代码 -->
      <views:SpacingIntroSection />

      <!-- ③ Toolbar 示例 / ④ Form 示例 / ⑤ Panel 示例 (真实控件) -->
      <views:SpacingSamplesSection />

      <!-- ⑥ Density 对比 / ⑦ Semantic Token 完整映射表 -->
      <views:SpacingDensityTableSection />

      <!-- ⑧ 禁止写法与排版原则 -->
      <views:SpacingAntiPatternsSection />
    </StackPanel>
  </ScrollViewer>
</UserControl>