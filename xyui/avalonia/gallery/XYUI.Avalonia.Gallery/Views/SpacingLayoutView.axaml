<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             xmlns:views="using:XYUI.Avalonia.Gallery.Views"
             x:Class="XYUI.Avalonia.Gallery.Views.SpacingLayoutView"
             x:DataType="views:SpacingMetricsViewModel">
  <ScrollViewer>
    <StackPanel Margin="{DynamicResource XY.Padding.Panel}" Spacing="{DynamicResource XY.Gap.Section}">
      <!-- Title & Subtitle according to SVG spec -->
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.Field}">
          <TextBlock Text="间距与排版 / Spacing &amp; Layout" Classes="xyui-heading-panel" />
          <c:XYStatusBadge Text="LOCKED · 0.03" State="Success" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="业务层优先写“语义容器”，而不是自己决定 Margin / Padding / Spacing 数值。" Classes="xyui-text-caption" />
      </StackPanel>

      <!-- ① 三条核心规则 -->
      <views:SpacingCoreRulesSection />

      <!-- ② Live Spacing Lab (真实测量线与空隙度量) -->
      <views:SpacingLiveLabSection />

      <!-- ③ 同一布局 · Density 自动改变空间 -->
      <views:SpacingDensityCompareSection />

      <!-- ④ 推荐写法 · 高级用法 · 禁止写法 -->
      <views:SpacingCodePatternsSection />
    </StackPanel>
  </ScrollViewer>
</UserControl>
