<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             xmlns:xy="using:XYUI.Avalonia"
             x:Class="XYUI.Avalonia.Gallery.Views.SizingMatrixSection">
  <Border Classes="xyui-surface-panel" Padding="14" BorderBrush="{DynamicResource XY.Brush.Accent.Default}" BorderThickness="1.5" CornerRadius="8">
    <StackPanel Spacing="10">
      <StackPanel Spacing="2">
        <TextBlock Text="② 真实组件尺寸矩阵" Classes="xyui-text-section" FontSize="17" />
        <TextBlock Text="同一组件 · 四档 XY.Size · Default 为推荐基线" Classes="xyui-text-caption" />
      </StackPanel>

      <Grid ColumnDefinitions="110,*,1.1*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,2,0,0">
        <!-- Headers -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="组件" Classes="xyui-text-caption" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="紧凑 · 28" Classes="xyui-text-caption" FontWeight="Bold" HorizontalAlignment="Center" />
        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource XY.Brush.Accent.Soft}" Padding="6,2" CornerRadius="3" HorizontalAlignment="Center">
          <TextBlock Text="默认 · 32 (推荐)" Classes="xyui-text-caption" FontWeight="Bold" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
        </Border>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="舒适 · 36" Classes="xyui-text-caption" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Grid.Row="0" Grid.Column="4" Text="触控 · 44" Classes="xyui-text-caption" FontWeight="Bold" HorizontalAlignment="Center" />

        <!-- Row 1: XYButton -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="XYButton" Classes="xyui-text-caption" FontWeight="Bold" VerticalAlignment="Center" Margin="0,6" />
        <Panel Grid.Row="1" Grid.Column="1" xy:XY.Size="Compact" HorizontalAlignment="Center" VerticalAlignment="Center">
          <c:XYButton Content="应用" Variant="Secondary" />
        </Panel>
        <Border Grid.Row="1" Grid.Column="2" xy:XY.Size="Default" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="4" CornerRadius="3" HorizontalAlignment="Center">
          <c:XYButton Content="保存工程" Variant="Primary" />
        </Border>
        <Panel Grid.Row="1" Grid.Column="3" xy:XY.Size="Comfortable" HorizontalAlignment="Center" VerticalAlignment="Center">
          <c:XYButton Content="导出资源" Variant="Secondary" />
        </Panel>
        <Panel Grid.Row="1" Grid.Column="4" xy:XY.Size="Touch" HorizontalAlignment="Center" VerticalAlignment="Center">
          <c:XYButton Content="立即提交" Variant="Secondary" />
        </Panel>

        <!-- Row 2: XYTextField -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="XYTextField" Classes="xyui-text-caption" FontWeight="Bold" VerticalAlignment="Center" Margin="0,6" />
        <Panel Grid.Row="2" Grid.Column="1" xy:XY.Size="Compact" Margin="4,0" VerticalAlignment="Center">
          <c:XYTextField Text="搜索图层…" />
        </Panel>
        <Border Grid.Row="2" Grid.Column="2" xy:XY.Size="Default" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="4" CornerRadius="3" VerticalAlignment="Center">
          <c:XYTextField Text="Main_Camera" />
        </Border>
        <Panel Grid.Row="2" Grid.Column="3" xy:XY.Size="Comfortable" Margin="4,0" VerticalAlignment="Center">
          <c:XYTextField Text="Material_01" />
        </Panel>
        <Panel Grid.Row="2" Grid.Column="4" xy:XY.Size="Touch" Margin="4,0" VerticalAlignment="Center">
          <c:XYTextField Text="100 %" />
        </Panel>

        <!-- Row 3: XYIconButton -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="XYIconButton" Classes="xyui-text-caption" FontWeight="Bold" VerticalAlignment="Center" Margin="0,6" />
        <Panel Grid.Row="3" Grid.Column="1" xy:XY.Size="Compact" HorizontalAlignment="Center" VerticalAlignment="Center">
          <c:XYIconButton><c:XYIcon Icon="Code" /></c:XYIconButton>
        </Panel>
        <Border Grid.Row="3" Grid.Column="2" xy:XY.Size="Default" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="4" CornerRadius="3" HorizontalAlignment="Center">
          <c:XYIconButton><c:XYIcon Icon="Check" /></c:XYIconButton>
        </Border>
        <Panel Grid.Row="3" Grid.Column="3" xy:XY.Size="Comfortable" HorizontalAlignment="Center" VerticalAlignment="Center">
          <c:XYIconButton><c:XYIcon Icon="Info" /></c:XYIconButton>
        </Panel>
        <Panel Grid.Row="3" Grid.Column="4" xy:XY.Size="Touch" HorizontalAlignment="Center" VerticalAlignment="Center">
          <c:XYIconButton><c:XYIcon Icon="Code" /></c:XYIconButton>
        </Panel>

        <!-- Row 4: XYToolbar -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="XYToolbar" Classes="xyui-text-caption" FontWeight="Bold" VerticalAlignment="Center" Margin="0,6" />
        <Panel Grid.Row="4" Grid.Column="1" x:Name="ToolbarCompactHost" xy:XY.Size="Compact" Margin="2,0" VerticalAlignment="Center" />
        <Border Grid.Row="4" Grid.Column="2" x:Name="ToolbarDefaultHost" xy:XY.Size="Default" Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Padding="2" Margin="2,0" VerticalAlignment="Center" />
        <Panel Grid.Row="4" Grid.Column="3" x:Name="ToolbarComfortableHost" xy:XY.Size="Comfortable" Margin="2,0" VerticalAlignment="Center" />
        <Panel Grid.Row="4" Grid.Column="4" x:Name="ToolbarTouchHost" xy:XY.Size="Touch" Margin="2,0" VerticalAlignment="Center" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>