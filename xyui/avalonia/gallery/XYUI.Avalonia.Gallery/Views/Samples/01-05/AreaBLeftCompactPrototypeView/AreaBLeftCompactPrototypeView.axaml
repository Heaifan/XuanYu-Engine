<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             x:Class="XYUI.Avalonia.Gallery.Views.AreaBLeftCompactPrototypeView">
  <UserControl.Styles>
    <Style Selector="Border.prototype-card">
      <Setter Property="Height" Value="520" />
      <Setter Property="Background" Value="{DynamicResource XY.Brush.Surface.Raised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource XY.Brush.Border.Color.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="7" />
    </Style>
    <Style Selector="Border.prototype-row">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.prototype-row.prototype-hover">
      <Setter Property="Background" Value="{DynamicResource XY.Brush.State.Color.Hover}" />
    </Style>
    <Style Selector="Border.prototype-row.prototype-selected">
      <Setter Property="Background" Value="{DynamicResource XY.Brush.State.Color.Active}" />
    </Style>
    <Style Selector="c|XYToggleButton.prototype-toggle">
      <Setter Property="Width" Value="99" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="c|XYIconButton.prototype-action">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.prototype-tree">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.prototype-tree &gt; ListBoxItem">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel Width="1220" Margin="28" Spacing="18">
      <StackPanel Spacing="4">
        <TextBlock Text="Area B · Left Compact Project / File Panel" Classes="xyui-heading-page" Foreground="{DynamicResource XY.Brush.Text.Primary}" />
        <TextBlock Text="仅使用现有 XYUI 组件 · 216 DIP · 项目 / 文件 · 不承担工作区切换" Classes="xyui-text-caption" />
      </StackPanel>
      <Grid ColumnDefinitions="216,216,216,216,216" ColumnSpacing="24">
        <TextBlock Grid.Column="0" Text="01 · 默认" Classes="xyui-text-label" />
        <TextBlock Grid.Column="1" Text="02 · Hover" Classes="xyui-text-label" />
        <TextBlock Grid.Column="2" Text="03 · Selected" Classes="xyui-text-label" />
        <TextBlock Grid.Column="3" Text="04 · Rename" Classes="xyui-text-label" />
        <TextBlock Grid.Column="4" Text="05 · ContextMenu" Classes="xyui-text-label" />
      </Grid>
      <Grid x:Name="StateBoard" ColumnDefinitions="216,216,216,216,216" ColumnSpacing="24" />
      <Border Height="1" Background="{DynamicResource XY.Brush.Border.Color.Subtle}" />
      <Grid ColumnDefinitions="220,360,*" ColumnSpacing="54">
        <StackPanel Spacing="10">
          <TextBlock Text="尺寸" Classes="xyui-text-label" />
          <TextBlock Text="Left Width                 216 DIP" Classes="xyui-text-caption" />
          <TextBlock Text="Header                         28 DIP" Classes="xyui-text-caption" />
          <TextBlock Text="Local Switch                28 DIP" Classes="xyui-text-caption" />
          <TextBlock Text="Tree Row                      28 DIP" Classes="xyui-text-caption" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="10">
          <TextBlock Text="Existing XYUI" Classes="xyui-text-label" />
          <TextBlock Text="XYHeading · XYIconButton · XYToggleButton" Classes="xyui-text-caption" />
          <TextBlock Text="XYIcon · XYTruncatedText · XYTextField" Classes="xyui-text-caption" />
          <TextBlock Text="XYContextMenu · XYMenuItem · XYSeparator" Classes="xyui-text-caption" />
          <TextBlock Text="ListBox · WAIVER-B-001" Classes="xyui-text-caption" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="10">
          <TextBlock Text="冻结规则" Classes="xyui-text-label" />
          <TextBlock Text="① Left 不承担 Workspace 切换" Classes="xyui-text-caption" />
          <TextBlock Text="② 项目 / 文件 = 本地内容二选一" Classes="xyui-text-caption" />
          <TextBlock Text="③ Hover / Selected / Rename 仅在真实交互中出现" Classes="xyui-text-caption" />
          <TextBlock Text="④ 无数据就留空，不显示 Prototype 说明文字" Classes="xyui-text-caption" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
