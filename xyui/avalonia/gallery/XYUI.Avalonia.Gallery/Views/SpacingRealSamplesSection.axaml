<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             xmlns:l="using:XYUI.Avalonia.Layout"
             x:Class="XYUI.Avalonia.Gallery.Views.SpacingRealSamplesSection">
  <StackPanel Spacing="{DynamicResource XY.Gap.Section}">
    <!-- 1. Toolbar 真实实例 (XYToolbar + XYToolGroup) -->
    <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}">
      <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
        <TextBlock Text="⑥ 真实 XYToolbar &amp; XYToolGroup 示例" Classes="xyui-text-section" />
        <Border Background="{DynamicResource XY.Brush.Surface.PanelAlt}" Height="{DynamicResource XY.Size.Toolbar}" Padding="4,2">
          <l:XYToolbar>
            <!-- ToolGroup A: New / Save (Real XYIconButton + XYIcon) -->
            <l:XYToolGroup>
              <c:XYIconButton AutomationProperties.Name="新建">
                <c:XYIcon Icon="Code" Size="Medium" />
              </c:XYIconButton>
              <c:XYIconButton AutomationProperties.Name="保存">
                <c:XYIcon Icon="Check" Size="Medium" />
              </c:XYIconButton>
            </l:XYToolGroup>

            <c:XYSeparator />

            <!-- ToolGroup B: Undo / Redo -->
            <l:XYToolGroup>
              <c:XYButton Content="撤销" Variant="Secondary" />
              <c:XYButton Content="重做" Variant="Secondary" />
            </l:XYToolGroup>
          </l:XYToolbar>
        </Border>
      </StackPanel>
    </Border>

    <!-- 2. Form 真实实例 (XYFieldGroup) -->
    <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}">
      <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
        <TextBlock Text="⑦ 真实 XYFieldGroup 示例 (三行字段垂直排列)" Classes="xyui-text-section" />
        <Border Background="{DynamicResource XY.Brush.Surface.Panel}" Padding="{DynamicResource XY.Padding.Panel}">
          <l:XYFieldGroup>
            <!-- Row 1 -->
            <Grid ColumnDefinitions="100,*">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.IconText}" VerticalAlignment="Center">
                <c:XYIcon Icon="Info" Size="Small" />
                <c:XYLabel Text="实体名称" />
              </StackPanel>
              <TextBox Grid.Column="1" Text="Player_Main_Actor" />
            </Grid>
            <!-- Row 2: 坐标字段由 Field 间距语义承担，不滥用 XYToolGroup -->
            <Grid ColumnDefinitions="100,*">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.IconText}" VerticalAlignment="Center">
                <c:XYIcon Icon="Code" Size="Small" />
                <c:XYLabel Text="世界坐标" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.Field}">
                <TextBox Text="1024.0" />
                <TextBox Text="2048.0" />
              </StackPanel>
            </Grid>
            <!-- Row 3 -->
            <Grid ColumnDefinitions="100,*">
              <c:XYLabel Text="生命周期" VerticalAlignment="Center" />
              <c:XYStatusBadge Grid.Column="1" Text="Active / Ready" State="Success" HorizontalAlignment="Left" />
            </Grid>
          </l:XYFieldGroup>
        </Border>
      </StackPanel>
    </Border>

    <!-- 3. Panel 真实实例 (XYPanel + XYSectionGroup) -->
    <Border Classes="xyui-border-subtle" Padding="{DynamicResource XY.Padding.Panel}">
      <StackPanel Spacing="{DynamicResource XY.Gap.Field}">
        <TextBlock Text="⑧ 真实 XYPanel &amp; XYSectionGroup 示例" Classes="xyui-text-section" />
        <l:XYPanel Background="{DynamicResource XY.Brush.Surface.PanelAlt}" BorderBrush="{DynamicResource XY.Brush.Border.Color.Default}" BorderThickness="{DynamicResource XY.Border.Width.Default}">
          <l:XYSectionGroup>
            <Border Background="{DynamicResource XY.Brush.Surface.Raised}" Padding="{DynamicResource XY.Padding.Panel}">
              <TextBlock Text="Section 1 (主渲染参数区)" Classes="xyui-text-caption" />
            </Border>
            <Border Background="{DynamicResource XY.Brush.Surface.Raised}" Padding="{DynamicResource XY.Padding.Panel}">
              <TextBlock Text="Section 2 (扩展材质参数区，由 XYSectionGroup 自动分隔)" Classes="xyui-text-caption" />
            </Border>
          </l:XYSectionGroup>
        </l:XYPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
