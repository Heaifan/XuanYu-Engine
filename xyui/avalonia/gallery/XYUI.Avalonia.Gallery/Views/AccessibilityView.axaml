<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XYUI.Avalonia.Controls"
             x:Class="XYUI.Avalonia.Gallery.Views.AccessibilityView">
  <StackPanel Margin="{DynamicResource XY.Padding.Panel}" Spacing="{DynamicResource XY.Gap.Section}">
    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource XY.Gap.Field}">
      <TextBlock Text="无障碍体系 (Accessibility Foundation)" Classes="xyui-heading-panel" />
      <c:XYStatusBadge Text="草稿 / 预览" State="Warning" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Text="无障碍焦点环 (Focus Ring) 与读屏标签映射处于规范定义阶段。" Classes="xyui-text-body" />
  </StackPanel>
</UserControl>