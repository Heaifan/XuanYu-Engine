<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XYUI.Avalonia.Gallery.Views.SurfaceScenariosSection">
  <StackPanel Spacing="6">
    <TextBlock Text="场景判断" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource XY.Brush.Accent.Strong}" />
    <Grid ColumnDefinitions="*,*,*,*">
      <Border Grid.Column="0" Margin="0,0,4,0" Background="{DynamicResource XY.Brush.Surface.App}" Classes="xyui-border-default" CornerRadius="8" Padding="12,8">
        <StackPanel Spacing="3">
          <TextBlock Text="整个页面的底" FontWeight="Bold" FontSize="12" />
          <TextBlock Text="优先：App" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Text="承载应用或主窗口的最低背景。" Classes="xyui-text-caption" FontSize="10" TextWrapping="Wrap" />
          <TextBlock Text="不要：拿 Raised 填满整个页面。" Foreground="{DynamicResource XY.Brush.System.Danger}" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Margin="2,0,2,0" Background="{DynamicResource XY.Brush.Surface.App}" Classes="xyui-border-default" CornerRadius="8" Padding="12,8">
        <StackPanel Spacing="3">
          <TextBlock Text="工作区 / 侧栏" FontWeight="Bold" FontSize="12" />
          <TextBlock Text="优先：Panel / PanelAlt" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Text="用来建立并列或次级区域对比。" Classes="xyui-text-caption" FontSize="10" TextWrapping="Wrap" />
          <TextBlock Text="不要：只靠随机灰度区分区域。" Foreground="{DynamicResource XY.Brush.System.Danger}" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Margin="2,0,2,0" Background="{DynamicResource XY.Brush.Surface.App}" Classes="xyui-border-default" CornerRadius="8" Padding="12,8">
        <StackPanel Spacing="3">
          <TextBlock Text="局部卡片" FontWeight="Bold" FontSize="12" />
          <TextBlock Text="优先：Raised" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Text="用于局部强调，不代表浮层生命周期。" Classes="xyui-text-caption" FontSize="10" TextWrapping="Wrap" />
          <TextBlock Text="不要：把所有 Panel 都升成卡片。" Foreground="{DynamicResource XY.Brush.System.Danger}" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Margin="4,0,0,0" Background="{DynamicResource XY.Brush.Surface.App}" Classes="xyui-border-default" CornerRadius="8" Padding="12,8">
        <StackPanel Spacing="3">
          <TextBlock Text="菜单 / 提示浮层" FontWeight="Bold" FontSize="12" />
          <TextBlock Text="优先：Popup / Tooltip" Classes="xyui-text-body" FontSize="11" />
          <TextBlock Text="脱离普通布局层级的瞬时内容。" Classes="xyui-text-caption" FontSize="10" TextWrapping="Wrap" />
          <TextBlock Text="不要：用 Raised 假装 Popup。" Foreground="{DynamicResource XY.Brush.System.Danger}" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
