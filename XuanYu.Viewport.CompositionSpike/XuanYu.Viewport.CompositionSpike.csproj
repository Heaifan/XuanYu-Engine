<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>XuanYu.Viewport.CompositionSpike</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.22.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\App.axaml.cs" Link="App.axaml.cs" />
    <Compile Include="..\MainWindow.axaml.cs" Link="MainWindow.axaml.cs" />
    <Compile Include="..\CompositionSpikeControl.axaml.cs" Link="CompositionSpikeControl.axaml.cs" />
    <Compile Include="..\CompositionSurfaceHost.cs" Link="CompositionSurfaceHost.cs" />
    <Compile Include="..\VulkanResultExtensions.cs" Link="VulkanResultExtensions.cs" />
    <Compile Include="..\VulkanCompositionResources.cs" Link="VulkanCompositionResources.cs" />
    <AvaloniaResource Include="..\App.axaml" Link="App.axaml" />
    <AvaloniaResource Include="..\MainWindow.axaml" Link="MainWindow.axaml" />
    <AvaloniaResource Include="..\CompositionSpikeControl.axaml" Link="CompositionSpikeControl.axaml" />
  </ItemGroup>
</Project>
